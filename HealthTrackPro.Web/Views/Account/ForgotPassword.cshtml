@model HealthTrackPro.Web.Models.ForgotPasswordViewModel

@{
    ViewBag.Title = "Forgot Password";
}

<div class="ht-auth-grid">

    <section class="ht-auth-intro">

        <div class="ht-auth-eyebrow">
            HealthTrack Pro Security
        </div>

        <h1>
            Recover your
            <span>account.</span>
        </h1>

        <p>
            Submit your account email and an Administrator
            will review the password reset request.
        </p>

        <ul class="ht-auth-feature-list">
            <li>Your existing password is never revealed</li>
            <li>Reset requests are recorded for security auditing</li>
            <li>Administrator issues a temporary password</li>
            <li>You change the temporary password after signing in</li>
        </ul>

    </section>


    <section class="ht-auth-card">

        <h2>Request password reset</h2>

        <div class="ht-auth-subtitle">
            Enter the email address used for your HealthTrack account.
        </div>

        @using (Html.BeginForm(
            "ForgotPassword",
            "Account",
            FormMethod.Post,
            new { role = "form" }))
        {
            @Html.AntiForgeryToken()

            @Html.ValidationSummary(
                true,
                "",
                new { @class = "text-danger" })

            <div class="form-group">

                @Html.LabelFor(
                    m => m.Email,
                    new { @class = "control-label" })

                @Html.TextBoxFor(
                    m => m.Email,
                    new
                    {
                        @class = "form-control",
                        type = "email",
                        placeholder = "name@example.com",
                        autocomplete = "email"
                    })

                @Html.ValidationMessageFor(
                    m => m.Email,
                    "",
                    new { @class = "text-danger" })

            </div>

            <button
                type="submit"
                class="btn btn-primary">
                Submit Reset Request
            </button>
        }

        <div class="ht-auth-meta">
            Remembered your password?
            @Html.ActionLink(
                "Return to sign in",
                "Login",
                "Account")
        </div>

    </section>

</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}