@{
    ViewBag.Title = "Password Reset Requested";
}

<div class="ht-auth-grid">

    <section class="ht-auth-intro">

        <div class="ht-auth-eyebrow">
            HealthTrack Pro Security
        </div>

        <h1>
            Request
            <span>submitted.</span>
        </h1>

        <p>
            If the email belongs to a HealthTrack account,
            the Administrator has been notified of the request.
        </p>

    </section>


    <section class="ht-auth-card">

        <h2>Check with your Administrator</h2>

        <div class="ht-auth-subtitle">
            For security, we do not confirm whether an email
            address exists in the system.
        </div>

        <p style="
            color:#94A3B8;
            line-height:1.7;
            margin:24px 0;">

            When the request is approved, the Administrator
            can issue a temporary password. Use that temporary
            password to sign in, then change it immediately.

        </p>

        @Html.ActionLink(
            "Return to Sign In",
            "Login",
            "Account",
            null,
            new { @class = "btn btn-primary" })

    </section>

</div>