@model HealthTrackPro.Web.Models.LoginViewModel

@{
    ViewBag.Title = "Sign In";
}


<style>
    /* PASSWORD-EYE-V1 */

    .ht-password-field {
        position: relative;
    }

    .ht-password-field .form-control {
        padding-right: 52px;
    }

    .ht-password-toggle {
        position: absolute;
        top: 50%;
        right: 8px;
        width: 40px;
        height: 40px;
        padding: 0;
        border: 0;
        border-radius: 8px;
        background: transparent;
        color: #64748B;
        font-size: 18px;
        line-height: 1;
        transform: translateY(-50%);
        cursor: pointer;
    }

    .ht-password-toggle:hover,
    .ht-password-toggle:focus {
        background: rgba(34,197,94,.10);
        color: #22C55E;
        outline: none;
    }
</style>
<div class="ht-auth-grid">

    <section class="ht-auth-intro">

        <div class="ht-auth-eyebrow">
            HealthTrack Pro
        </div>

        <h1>
            Build a healthier
            <span>you.</span>
        </h1>

        <p>
            Track your fitness journey, follow personalised
            workout and diet plans, monitor progress and stay
            connected with your trainer.
        </p>

        <ul class="ht-auth-feature-list">
            <li>Personalised workout and nutrition plans</li>
            <li>Weight, BMI and health progress tracking</li>
            <li>Trainer appointments and professional feedback</li>
            <li>Goals, reminders and activity history</li>
        </ul>

    </section>

    <section class="ht-auth-card">

        <h2>Welcome back</h2>

        <div class="ht-auth-subtitle">
            Sign in to continue to your HealthTrack account.
        </div>

        @using (Html.BeginForm(
            "Login",
            "Account",
            new { ReturnUrl = ViewBag.ReturnUrl },
            FormMethod.Post,
            new { role = "form" }))
        {
            @Html.AntiForgeryToken()

            @Html.ValidationSummary(
                true,
                "",
                new { @class = "text-danger" }
            )

            <div class="form-group">

                @Html.LabelFor(
                    m => m.Email,
                    new { @class = "control-label" }
                )

                @Html.TextBoxFor(
                    m => m.Email,
                    new
                    {
                        @class = "form-control",
                        placeholder = "name@example.com",
                        autocomplete = "email"
                    }
                )

                @Html.ValidationMessageFor(
                    m => m.Email,
                    "",
                    new { @class = "text-danger" }
                )

            </div>

            <div class="form-group">

                @Html.LabelFor(
                    m => m.Password,
                    new { @class = "control-label" }
                )

                @Html.PasswordFor(
                    m => m.Password,
                    new
                    {
                        @class = "form-control",
                        placeholder = "Enter your password",
                        autocomplete = "current-password",
                        id = "htLoginPassword"
                    }
                )

                @Html.ValidationMessageFor(
                    m => m.Password,
                    "",
                    new { @class = "text-danger" }
                )

            </div>

            <div class="form-group">

                <label class="ht-checkbox">

                    @Html.CheckBoxFor(
                        m => m.RememberMe
                    )

                    Remember me

                </label>

                <div>
                    @Html.ActionLink(
                        "Forgot your password?",
                        "ForgotPassword",
                        "Account",
                        null,
                        new { @class = "ht-auth-small-link" }
                    )
                </div>

            </div>

            <button
                type="submit"
                class="btn btn-primary">
                Sign In
            </button>
        }

        <div class="ht-auth-meta">
            New to HealthTrack?
            @Html.ActionLink(
                "Create a client account",
                "Register",
                "Account"
            )
        </div>

    </section>

</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        (function () {
            "use strict";

            var input =
                document.getElementById(
                    "htLoginPassword");

            if (!input ||
                document.getElementById(
                    "htTogglePassword")) {
                return;
            }

            var wrapper =
                document.createElement("div");

            wrapper.className =
                "ht-password-field";

            input.parentNode.insertBefore(
                wrapper,
                input);

            wrapper.appendChild(input);

            var button =
                document.createElement("button");

            button.id =
                "htTogglePassword";

            button.className =
                "ht-password-toggle";

            button.type =
                "button";

            button.title =
                "Show password";

            button.setAttribute(
                "aria-label",
                "Show password");

            button.innerHTML =
                "&#128065;";

            wrapper.appendChild(button);

            button.addEventListener(
                "click",
                function () {

                    var visible =
                        input.type === "text";

                    input.type =
                        visible
                            ? "password"
                            : "text";

                    button.title =
                        visible
                            ? "Show password"
                            : "Hide password";

                    button.setAttribute(
                        "aria-label",
                        button.title);
                });
        })();
    </script>
}
