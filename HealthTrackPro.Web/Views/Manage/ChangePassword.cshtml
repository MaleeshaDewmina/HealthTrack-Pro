@model HealthTrackPro.Web.Models.ChangePasswordViewModel
@{
    ViewBag.Title = "Change Password";
}

<main aria-labelledby="title">
    <h2 id="title">@ViewBag.Title.</h2>

    @using (Html.BeginForm("ChangePassword", "Manage", FormMethod.Post, new { role = "form" }))
    {
        @Html.AntiForgeryToken()
        <h4>Change Password Form</h4>
        <hr />
        @Html.ValidationSummary("", new { @class = "text-danger" })
        <div class="row">
            @Html.LabelFor(m => m.OldPassword, new { @class = "col-md-2 col-form-label" })
            <div class="col-md-10">
                @Html.PasswordFor(m => m.OldPassword, new { @class = "form-control" })
            </div>
        </div>
        <div class="row">
            @Html.LabelFor(m => m.NewPassword, new { @class = "col-md-2 col-form-label" })
            <div class="col-md-10">
                @Html.PasswordFor(m => m.NewPassword, new { @class = "form-control" })
            </div>
        </div>
        <div class="row">
            @Html.LabelFor(m => m.ConfirmPassword, new { @class = "col-md-2 col-form-label" })
            <div class="col-md-10">
                @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control" })
            </div>
        </div>
        <div class="row">
            <div class="offset-md-2 col-md-10">
                <input type="submit" value="Change password" class="btn btn-outline-dark" />
            </div>
        </div>
    }
</main>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
<style>
    /* CHANGE-PASSWORD-BUTTON-FIX */

    form input[type="submit"],
    form button[type="submit"] {
        min-height: 46px !important;
        padding: 0 22px !important;
        border: 1px solid #22C55E !important;
        border-radius: 9px !important;
        background: #22C55E !important;
        color: #061009 !important;
        font-weight: 900 !important;
        opacity: 1 !important;
        box-shadow: none !important;
        cursor: pointer !important;
    }

    form input[type="submit"]:hover,
    form button[type="submit"]:hover {
        background: #16A34A !important;
        border-color: #16A34A !important;
        color: #FFFFFF !important;
    }

    form input[type="submit"]:focus,
    form button[type="submit"]:focus {
        outline: none !important;
        box-shadow: 0 0 0 3px rgba(34,197,94,.18) !important;
    }

    form input[type="submit"]:disabled,
    form button[type="submit"]:disabled {
        opacity: .55 !important;
        cursor: not-allowed !important;
    }
</style>
<style>
    /* CHANGE-PASSWORD-EYES-V1 */

    .ht-change-password-wrap {
        position: relative;
        width: 100%;
    }

    .ht-change-password-wrap .form-control {
        padding-right: 52px !important;
    }

    .ht-change-password-eye {
        position: absolute;
        top: 50%;
        right: 7px;
        width: 40px;
        height: 40px;
        border: 0;
        border-radius: 8px;
        background: transparent;
        color: #94A3B8;
        font-size: 18px;
        line-height: 1;
        transform: translateY(-50%);
        cursor: pointer;
    }

    .ht-change-password-eye:hover,
    .ht-change-password-eye:focus {
        background: rgba(34,197,94,.10);
        color: #22C55E;
        outline: none;
    }
</style>

<script>
    /* CHANGE-PASSWORD-EYES-V1 */

    (function () {
        "use strict";

        function initialisePasswordEyes() {

            var inputs =
                document.querySelectorAll(
                    'input[type="password"]');

            for (
                var i = 0;
                i < inputs.length;
                i++)
            {
                var input = inputs[i];

                if (
                    input.getAttribute(
                        "data-eye-ready") === "true")
                {
                    continue;
                }

                input.setAttribute(
                    "data-eye-ready",
                    "true");

                var wrapper =
                    document.createElement("div");

                wrapper.className =
                    "ht-change-password-wrap";

                input.parentNode.insertBefore(
                    wrapper,
                    input);

                wrapper.appendChild(input);

                var button =
                    document.createElement("button");

                button.type =
                    "button";

                button.className =
                    "ht-change-password-eye";

                button.innerHTML =
                    "&#128065;";

                button.title =
                    "Show password";

                button.setAttribute(
                    "aria-label",
                    "Show password");

                wrapper.appendChild(button);

                (function (
                    passwordInput,
                    toggleButton)
                {
                    toggleButton.addEventListener(
                        "click",
                        function () {

                            var visible =
                                passwordInput.type ===
                                    "text";

                            passwordInput.type =
                                visible
                                    ? "password"
                                    : "text";

                            toggleButton.title =
                                visible
                                    ? "Show password"
                                    : "Hide password";

                            toggleButton.setAttribute(
                                "aria-label",
                                toggleButton.title);
                        });
                })(input, button);
            }
        }

        if (
            document.readyState ===
                "loading")
        {
            document.addEventListener(
                "DOMContentLoaded",
                initialisePasswordEyes);
        }
        else
        {
            initialisePasswordEyes();
        }
    })();
</script>