@{
    var pageTitle =
        string.IsNullOrWhiteSpace(ViewBag.Title as string)
        ? "HealthTrack Pro"
        : ViewBag.Title as string;

    var controller =
        Convert.ToString(
            ViewContext.RouteData.Values["controller"]
        );

    var isAuthenticated =
        Request.IsAuthenticated;

    var isClient =
        isAuthenticated &&
        User.IsInRole("Client");

    var isTrainer =
        isAuthenticated &&
        User.IsInRole("Trainer");

    var isAdministrator =
        isAuthenticated &&
        User.IsInRole("Administrator");

    var roleName =
        isAdministrator ? "ADMINISTRATOR" :
        isTrainer ? "TRAINER" :
        isClient ? "CLIENT" :
        "USER";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0" />

    <title>
        @pageTitle - HealthTrack Pro
    </title>

    @Styles.Render("~/Content/css")

    <link
        href="@Url.Content("~/Content/healthtrack-theme.css")"
        rel="stylesheet"
        type="text/css" />

    @Scripts.Render("~/bundles/modernizr")

    <!-- HT-THEME-BOOTSTRAP -->
    <script>
        (function () {
            try {
                var savedTheme =
                    localStorage.getItem("healthtrack-theme");

                var theme =
                    savedTheme === "light"
                        ? "light"
                        : "dark";

                document.documentElement.setAttribute(
                    "data-theme",
                    theme
                );
            }
            catch (e) {
                document.documentElement.setAttribute(
                    "data-theme",
                    "dark"
                );
            }
        })();
    </script>
</head>

<body>

@if (isAuthenticated)
{
    <div class="ht-app-shell">

        <aside class="ht-sidebar">

            <a
                href="@Url.Action(
                    "Index",
                    "Home",
                    new { area = "" })"
                class="ht-brand">

                <span class="ht-brand-main">
                    HEALTH<span class="ht-brand-accent">TRACK</span>
                </span>

            </a>

            <span class="ht-role-badge">
                @roleName
            </span>

            <div class="ht-nav-title">
                NAVIGATION
            </div>

            <ul class="ht-nav">

                @if (isClient)
                {
                    <li class="ht-nav-item">
                        <a
                            href="@Url.Action(
                                "Index",
                                "Dashboard",
                                new { area = "Client" })"
                            class="ht-nav-link @(controller == "Dashboard" ? "active" : "")">
                            Dashboard
                        </a>
                    </li>

                    <li class="ht-nav-item">
                        <a href="@Url.Action("Index", "Profile", new { area = "Client" })"
   class="ht-nav-link @(controller == "Profile" ? "active" : "")">
    Profile
</a>
                    </li>

                    <li class="ht-nav-item">
                        <a href="@Url.Action("Index", "Goals", new { area = "Client" })"
   class="ht-nav-link @(controller == "Goals" ? "active" : "")">
    Goals
</a>
                    </li>

                    <li class="ht-nav-item">
                        <a href="@Url.Action("Index", "Workout", new { area = "Client" })"
   class="ht-nav-link @(controller == "Workout" ? "active" : "")">
    Workout
</a>
                    </li>

                    <li class="ht-nav-item">
                        <a href="@Url.Action("Index", "Diet", new { area = "Client" })" class="ht-nav-link @((controller == "Diet" || controller == "MealLog") ? "active" : "")">
                            Diet
                        </a>
                    </li>

                    <li class="ht-nav-item">
                        <a href="@Url.Action("Index", "Progress", new { area = "Client" })" class="ht-nav-link @(controller == "Progress" ? "active" : "")">
                            Progress
                        </a>
                    </li>

                                        <li class="ht-nav-item">
                        <a href="@Url.Action("Index", "AiChat", new { area = "Client" })"
                           class="ht-nav-link @(controller == "AiChat" ? "active" : "")">
                            AI Coach
                        </a>
                    </li>
<li class="ht-nav-item">
                        <a href="@Url.Action("Index", "Appointments", new { area = "Client" })"
                           class="ht-nav-link @(controller == "Appointments" ? "active" : "")">
                            Appointments
                        </a>
                    </li>

                    <li class="ht-nav-item">
                        <a href="@Url.Action("Index", "Notifications", new { area = "Client" })"
                           class="ht-nav-link @(controller == "Notifications" ? "active" : "")">
                            Notifications
                        </a>
                    </li>
                }

                @if (isTrainer)
                {
                    <li class="ht-nav-item">
                        <a
                            href="@Url.Action(
                                "Index",
                                "Dashboard",
                                new { area = "Trainer" })"
                            class="ht-nav-link @(controller == "Dashboard" ? "active" : "")">
                            Dashboard
                        </a>
                    </li>

                    <li class="ht-nav-item">
                        <a
                            href="@Url.Action(
                                "Index",
                                "Clients",
                                new { area = "Trainer" })"
                            class="ht-nav-link @(controller == "Clients" ? "active" : "")">
                            Assigned Clients
                        </a>
                    </li>

                    <li class="ht-nav-item">
                        <a href="@Url.Action("Index", "WorkoutPlans", new { area = "Trainer" })" class="ht-nav-link @(controller == "WorkoutPlans" ? "active" : "")">
                            Workout Plans
                        </a>
                    </li>

                    <li class="ht-nav-item">
                        <a href="@Url.Action("Index", "DietPlans", new { area = "Trainer" })" class="ht-nav-link @(controller == "DietPlans" ? "active" : "")">
                            Diet Plans
                        </a>
                    </li>

                    <li class="ht-nav-item">
                        <a href="@Url.Action("Index", "Appointments", new { area = "Trainer" })" class="ht-nav-link @(controller == "Appointments" ? "active" : "")">
                            Appointments
                        </a>
                    </li>

                    <li class="ht-nav-item">
                        <a href="@Url.Action("Index", "Availability", new { area = "Trainer" })" class="ht-nav-link @(controller == "Availability" ? "active" : "")">
                            Availability
                        </a>
                    </li>

                    <li class="ht-nav-item">
                        <a href="@Url.Action("Index", "Feedback", new { area = "Trainer" })" class="ht-nav-link @(controller == "Feedback" ? "active" : "")">
                            Feedback
                        </a>
                    </li>

                    <li class="ht-nav-item">
                        <a href="@Url.Action("Index", "Notifications", new { area = "Trainer" })" class="ht-nav-link @(controller == "Notifications" ? "active" : "")">
                            Notifications
                        </a>
                    </li>
                    <li class="ht-nav-item">
                        <a href="@Url.Action("Index", "Progress", new { area = "Trainer" })" class="ht-nav-link @(controller == "Progress" ? "active" : "")">
                            Progress Report
                        </a>
                    </li>
                }

                @if (isAdministrator)
                {
                    <li class="ht-nav-item">
                        <a
                            href="@Url.Action(
                                "Index",
                                "Dashboard",
                                new { area = "Admin" })"
                            class="ht-nav-link @(controller == "Dashboard" ? "active" : "")">
                            Dashboard
                        </a>
                    </li>

                    <li class="ht-nav-item">
    <a
        href="@Url.Action(
            "Index",
            "Users",
            new { area = "Admin" })"
        class="ht-nav-link @(controller == "Users" ? "active" : "")">
        Users
    </a>
</li>

                    <li class="ht-nav-item">
    <a
        href="@Url.Action(
            "Index",
            "Trainers",
            new { area = "Admin" })"
        class="ht-nav-link @(controller == "Trainers" ? "active" : "")">
        Trainers
    </a>
</li>

                    <li class="ht-nav-item">
    <a
        href="@Url.Action(
            "Index",
            "Assignments",
            new { area = "Admin" })"
        class="ht-nav-link @(controller == "Assignments" ? "active" : "")">
        Assignments
    </a>
</li>

                    <li class="ht-nav-item">
    <a
        href="@Url.Action(
            "Index",
            "Appointments",
            new { area = "Admin" })"
        class="ht-nav-link @(controller == "Appointments" ? "active" : "")">
        Appointments
    </a>
</li>

                    <li class="ht-nav-item">
    <a
        href="@Url.Action(
            "Index",
            "Reports",
            new { area = "Admin" })"
        class="ht-nav-link @(controller == "Reports" ? "active" : "")">
        Reports
    </a>
</li>

                    <li class="ht-nav-item">
    <a
        href="@Url.Action(
            "Index",
            "AuditLogs",
            new { area = "Admin" })"
        class="ht-nav-link @(controller == "AuditLogs" ? "active" : "")">
        Audit Logs
    </a>
</li>

                    <li class="ht-nav-item">
                        <a
                            href="@Url.Action(
                                "Index",
                                "Settings",
                                new { area = "Admin" })"
                            class="ht-nav-link @(controller == "Settings" ? "active" : "")">
                            Settings
                        </a>
                    </li>
                }

            </ul>

        </aside>

        <main class="ht-main">

            <header class="ht-topbar">

                <h1 class="ht-page-title">
                    @pageTitle
                </h1>

                <div class="ht-topbar-right">
                    <!-- HT-THEME-TOGGLE -->
                    <button
                        type="button"
                        id="htThemeToggle"
                        class="ht-theme-toggle"
                        aria-label="Switch colour theme"
                        title="Switch colour theme">
                        <span
                            id="htThemeIcon"
                            class="ht-theme-icon"
                            aria-hidden="true">&#9788;</span>
                        <span id="htThemeText">Light</span>
                    </button>


                    @if (User.IsInRole("Trainer"))
                    {
                        <a
                            href="@Url.Action("Index", "Notifications", new { area = "Trainer" })"
                            class="ht-notification-button"
                            title="Notifications"
                            aria-label="Open notifications"
                            style="text-decoration:none;">
                            &#128276;
                        </a>
                    }
                    else if (User.IsInRole("Client"))
                    {
                        <a
                            href="@Url.Action("Index", "Notifications", new { area = "Client" })"
                            class="ht-notification-button"
                            title="Notifications"
                            aria-label="Open notifications"
                            style="text-decoration:none;">
                            &#128276;
                        </a>
                    }
                    else if (User.IsInRole("Administrator"))
                    {
                        <a
                            href="@Url.Action(
                                "Index",
                                "AuditLogs",
                                new { area = "Admin" })"
                            class="ht-notification-button"
                            title="Administrative activity"
                            aria-label="Open administrative activity"
                            style="text-decoration:none;">
                            &#128276;
                        </a>
                    }
                    else
                    {
                        <span
                            class="ht-notification-button"
                            title="Notifications">
                            &#128276;
                        </span>
                    }

                    @Html.Partial("_LoginPartial")

                </div>

            </header>

            <section class="ht-page-content">

                @RenderBody()

            </section>

        </main>

    </div>
}
else
{
    <div class="ht-public-shell">

        <header class="ht-public-header">

            <a
                href="@Url.Action(
                    "Index",
                    "Home",
                    new { area = "" })"
                class="ht-brand">

                <span class="ht-brand-main">
                    HEALTH<span class="ht-brand-accent">TRACK</span>
                </span>

            </a>

            @Html.Partial("_LoginPartial")

        </header>

        <main class="ht-public-content">

            @RenderBody()

        </main>

    </div>
}

@Scripts.Render("~/bundles/jquery")
@Scripts.Render("~/bundles/bootstrap")

@RenderSection(
    "scripts",
    required: false
)


    <!-- HT-THEME-SCRIPT -->
    <script>
        (function () {

            var button =
                document.getElementById("htThemeToggle");

            var icon =
                document.getElementById("htThemeIcon");

            var text =
                document.getElementById("htThemeText");

            if (!button) {
                return;
            }

            function getTheme() {
                return document.documentElement
                    .getAttribute("data-theme") === "light"
                    ? "light"
                    : "dark";
            }

            function updateButton() {

                var theme = getTheme();

                if (theme === "light") {
                    icon.innerHTML = "&#9790;";
                    text.textContent = "Dark";
                    button.title = "Switch to dark mode";
                }
                else {
                    icon.innerHTML = "&#9788;";
                    text.textContent = "Light";
                    button.title = "Switch to light mode";
                }
            }

            button.addEventListener(
                "click",
                function () {

                    var nextTheme =
                        getTheme() === "dark"
                            ? "light"
                            : "dark";

                    document.documentElement.setAttribute(
                        "data-theme",
                        nextTheme
                    );

                    try {
                        localStorage.setItem(
                            "healthtrack-theme",
                            nextTheme
                        );
                    }
                    catch (e) {
                    }

                    updateButton();
                }
            );

            updateButton();

        })();
    </script>
</body>
</html>






