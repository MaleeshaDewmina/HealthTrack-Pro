@using Microsoft.AspNet.Identity

@if (Request.IsAuthenticated)
{
    using (Html.BeginForm(
        "LogOff",
        "Account",
        FormMethod.Post,
        new
        {
            id = "logoutForm",
            style = "margin:0;"
        }))
    {
        @Html.AntiForgeryToken()

        <div class="ht-account-menu">

            <span class="ht-account-email">
                @User.Identity.GetUserName()
            </span>

            <a
                href="javascript:document.getElementById('logoutForm').submit()"
                class="ht-account-link">
                Log out
            </a>

        </div>
    }
}
else
{
    <div class="ht-public-actions">

        @Html.ActionLink(
            "Sign In",
            "Login",
            "Account",
            null,
            null
        )

        @Html.ActionLink(
            "Create Account",
            "Register",
            "Account",
            null,
            new { @class = "ht-register-link" }
        )

    </div>
}
