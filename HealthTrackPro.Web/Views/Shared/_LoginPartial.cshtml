@using Microsoft.AspNet.Identity
@using System.Linq
@using HealthTrackPro.Web.Models

@{
    var displayName = "";

    if (Request.IsAuthenticated)
    {
        if (User.IsInRole("Administrator"))
        {
            displayName = "Administrator";
        }
        else
        {
            var userId = User.Identity.GetUserId();

            using (var db = new ApplicationDbContext())
            {
                if (User.IsInRole("Client"))
                {
                    displayName = db.ClientProfiles
                        .Where(c => c.UserId == userId)
                        .Select(c => c.FullName)
                        .FirstOrDefault();
                }
                else if (User.IsInRole("Trainer"))
                {
                    displayName = db.TrainerProfiles
                        .Where(t => t.UserId == userId)
                        .Select(t => t.FullName)
                        .FirstOrDefault();
                }
            }

            if (string.IsNullOrWhiteSpace(displayName))
            {
                displayName = User.Identity.GetUserName();
            }
        }
    }
}

@if (Request.IsAuthenticated)
{
    using (Html.BeginForm(
        "LogOff",
        "Account",
        new { area = "" },
        FormMethod.Post,
        new
        {
            id = "logoutForm",
            style = "margin:0;"
        }))
    {
        @Html.AntiForgeryToken()

        <div class="ht-account-menu">

            <span class="ht-account-email">
                @displayName
            </span>

            <a
                href="javascript:document.getElementById('logoutForm').submit()"
                class="ht-account-link">
                Log out
            </a>

        </div>
    }
}
else
{
    <div class="ht-public-actions">

        @Html.ActionLink(
            "Sign In",
            "Login",
            "Account",
            new { area = "" },
            null
        )

        @Html.ActionLink(
            "Create Account",
            "Register",
            "Account",
            new { area = "" },
            new { @class = "ht-register-link" }
        )

    </div>
}
