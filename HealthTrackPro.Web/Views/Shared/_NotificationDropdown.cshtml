@{
    var notificationPageUrl = User.IsInRole("Trainer")
        ? Url.Action("Index", "Notifications", new { area = "Trainer" })
        : Url.Action("Index", "Notifications", new { area = "Client" });
}

<div id="htNotificationDropdown"
     class="htnf-root"
     data-recent-url="@Url.Action("Recent", "NotificationDropdown", new { area = "" })"
     data-read-url="@Url.Action("MarkRead", "NotificationDropdown", new { area = "" })"
     data-readall-url="@Url.Action("MarkAllRead", "NotificationDropdown", new { area = "" })">

    <button type="button" class="htnf-bell" id="htnfBell"
            aria-label="Open notifications" aria-controls="htnfPanel"
            aria-expanded="false" title="Notifications">
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9" />
            <path d="M10 21h4" />
        </svg>
        <span class="htnf-badge" id="htnfBadge" hidden>0</span>
    </button>

    <section class="htnf-panel" id="htnfPanel" aria-label="Notifications" hidden>
        <div class="htnf-heading">
            <div>
                <h2>Notifications</h2>
                <p id="htnfCount" aria-live="polite">Checking notifications...</p>
            </div>
            <button class="htnf-close" type="button" id="htnfClose"
                    aria-label="Close notifications">&times;</button>
        </div>

        <div class="htnf-toolbar">
            <span>RECENT ACTIVITY</span>
            <button class="htnf-mark-all" type="button" id="htnfMarkAll">
                <span aria-hidden="true">&#10003;&#10003;</span> Mark All Read
            </button>
        </div>

        <div class="htnf-list" id="htnfList" aria-live="polite">
            <p class="htnf-placeholder">Loading notifications...</p>
        </div>

        <a class="htnf-viewall" href="@notificationPageUrl">View all notifications &rarr;</a>
        <div class="htnf-token" hidden>@Html.AntiForgeryToken()</div>
    </section>
    <noscript><a href="@notificationPageUrl">Notifications</a></noscript>
</div>
