                            pointBorderWidth: 2,

                            pointRadius: 5,

                            pointHoverRadius: 7,

                            borderWidth: 3,

                            tension: 0.3,

                            fill: true,

                            spanGaps: false

                        }

                    ]
                },

                options: {

                    responsive: true,

                    maintainAspectRatio: false,

                    interaction: {

                        mode: "nearest",

                        intersect: false

                    },

                    plugins: {

                        legend: {

                            display: false

                        },

                        tooltip: {

