                                "#111713",

                            titleColor:
                                "#F3F4F6",

                            bodyColor:
                                "#4ADE80",

                            borderColor:
                                "#35533D",

                            borderWidth: 1,

                            padding: 12,

                            displayColors: false

                        }

                    },

                    scales: {

                        x: {

                            ticks: {

                                color: "#9CA3AF",

                                maxRotation: 35,

                                autoSkip: true,

