                            },

                            grid: {

                                color: "#26342A"

                            },

                            border: {

                                color: "#344638"

                            }

                        }

                    }

                }

            });

        }


        // =====================================
        // WEIGHT TAB
        // =====================================

        weightTab.addEventListener(
            "click",
            function () {

                showChart("weight");

            }
        );


        // =====================================
        // BMI TAB
        // =====================================

        bmiTab.addEventListener(
            "click",
            function () {

                showChart("bmi");

            }
        );


        // =====================================
