
@model HealthTrackPro.Web.Areas.Client.Models.ClientProfileViewModel

@{
    ViewBag.Title = "My Profile";
}

<div class="container-fluid">

    <h2>My Profile</h2>
    <p>Manage your personal information and fitness details.</p>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    <div class="ht-card">

        @using (Html.BeginForm(
            "Index",
            "Profile",
            new { area = "Client" },
            FormMethod.Post,
            new { @class = "ht-profile-form" }))
        {
            @Html.AntiForgeryToken()

            @Html.ValidationSummary(
                true, "",
                new { @class = "text-danger" })

            <h3 class="ht-card-title">Personal Information</h3>

            <div class="row">

                <div class="col-md-6">
                    <div class="form-group">
                        @Html.LabelFor(m => m.FullName)

                        @Html.TextBoxFor(m => m.FullName,
                            new
                                 {
                                @class = "form-control",
                                placeholder = "Enter your full name"
                            })

                        @Html.ValidationMessageFor(
                            m => m.FullName, "",
                            new { @class = "text-danger" })
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        @Html.LabelFor(m => m.DateOfBirth)

                        @Html.TextBoxFor(
                            m => m.DateOfBirth,
                            "{0:yyyy-MM-dd}",
                            new
                                 {
                                @class = "form-control",
                                type = "date",
                                max = DateTime.Today.ToString("yyyy-MM-dd")
                            })

                        @Html.ValidationMessageFor(
                            m => m.DateOfBirth, "",
                            new { @class = "text-danger" })
                    </div>
                </div>

            </div>

            <h3 class="ht-card-title">Health Information</h3>

            <div class="row">

                <div class="col-md-6">
                    <div class="form-group">
                        @Html.LabelFor(m => m.HeightCm)

                        @Html.TextBoxFor(m => m.HeightCm,
                            new
                                 {
                                @class = "form-control",
                                type = "number",
                                step = "0.1",
                                min = "50",
                                max = "250",
                                placeholder = "Enter height in cm"
                            })

                        @Html.ValidationMessageFor(
                            m => m.HeightCm, "",
                            new { @class = "text-danger" })
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        @Html.LabelFor(m => m.CurrentWeightKg)

                        @Html.TextBoxFor(
                            m => m.CurrentWeightKg,
                            new
                                 {
                                @class = "form-control",
                                type = "number",
                                step = "0.1",
                                min = "20",
                                max = "500",
                                placeholder = "Enter weight in kg"
                            })

                        @Html.ValidationMessageFor(
                            m => m.CurrentWeightKg, "",
                            new { @class = "text-danger" })
                    </div>
                </div>

            </div>

            <h3 class="ht-card-title">Fitness Preferences</h3>

            <div class="row">

                <div class="col-md-6">
                    <div class="form-group">
                        @Html.LabelFor(m => m.ActivityLevel)

                        @Html.EnumDropDownListFor(
                            m => m.ActivityLevel,
                            "Select activity level",
                            new { @class = "form-control" })

                        @Html.ValidationMessageFor(
                            m => m.ActivityLevel, "",
                            new { @class = "text-danger" })
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        @Html.LabelFor(m => m.PrimaryGoal)

                        @Html.EnumDropDownListFor(
                            m => m.PrimaryGoal,
                            "Select fitness goal",
                            new { @class = "form-control" })

                        @Html.ValidationMessageFor(
                            m => m.PrimaryGoal, "",
                            new { @class = "text-danger" })
                    </div>
                </div>

            </div>

            <hr />

            <div class="form-group">

                <button type="submit" class="btn btn-primary">
                    Save Changes
                </button>

                <a href="@Url.Action("Index", "Dashboard", new { area = "Client" })"
                   class="btn btn-default">
                    Back to Dashboard
                </a>

            </div>
        }

    </div>

</div>
