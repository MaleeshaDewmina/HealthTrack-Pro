
@model HealthTrackPro.Web.Areas.Client.Models.ClientProfileViewModel
@using System
@using System.Globalization

@{
    ViewBag.Title = "My Profile";

    var dashboardUrl = Url.Action(
        "Index", "Dashboard", new { area = "Client" });

    var goalsUrl = Url.Action(
        "Index", "Goals", new { area = "Client" });

    var profileName = string.IsNullOrWhiteSpace(Model.FullName)
        ? "Your Profile"
        : Model.FullName.Trim();

    // Generate profile initials
    var nameParts = profileName.Split(
        new[] { ' ' },
        StringSplitOptions.RemoveEmptyEntries);

    var initials = "C";

    if (nameParts.Length > 0)
    {
        initials = nameParts[0]
            .Substring(0, 1)
            .ToUpperInvariant();
    }

    if (nameParts.Length > 1)
    {
        initials += nameParts[nameParts.Length - 1]
            .Substring(0, 1)
            .ToUpperInvariant();
    }

    // Calculate age
    int? age = null;

    if (Model.DateOfBirth.HasValue &&
        Model.DateOfBirth.Value.Date <= DateTime.Today)
    {
        var dob = Model.DateOfBirth.Value.Date;
        int years = DateTime.Today.Year - dob.Year;

        if (dob > DateTime.Today.AddYears(-years))
        {
            years--;
        }

        if (years >= 0)
        {
            age = years;
        }
    }

    // Calculate BMI
    decimal? bmi = null;

    if (Model.HeightCm.HasValue &&
        Model.CurrentWeightKg.HasValue &&
        Model.HeightCm.Value > 0)
    {
        decimal heightMeters =
            Model.HeightCm.Value / 100m;

        bmi = Model.CurrentWeightKg.Value /
              (heightMeters * heightMeters);
    }

    var heightText = Model.HeightCm.HasValue
        ? Model.HeightCm.Value.ToString(
            "0.#", CultureInfo.CurrentCulture)
        : "—";

    var weightText = Model.CurrentWeightKg.HasValue
        ? Model.CurrentWeightKg.Value.ToString(
            "0.#", CultureInfo.CurrentCulture)
        : "—";

    var bmiText = bmi.HasValue
        ? bmi.Value.ToString(
            "0.0", CultureInfo.CurrentCulture)
        : "—";

    var activityText = Model.ActivityLevel.HasValue
        ? Model.ActivityLevel.Value.ToString()
        : "Not set";

    var goalText = Model.PrimaryGoal.HasValue
        ? Model.PrimaryGoal.Value.ToString()
        : "Not set";

    bool hasProfilePhoto =
        ViewBag.HasProfilePhoto != null &&
        ViewBag.HasProfilePhoto == true;

    var photoUrl = Url.Action(
        "Photo", "Profile", new { area = "Client" });
}

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" />

<style>
    /* PAGE AND LAYOUT */

    .cp2,
    .cp2 * {
        box-sizing: border-box;
    }

    .cp2 {
        max-width: 1380px;
        margin: 0 auto;
        padding: 20px 0 48px;
        color: #F3F4F6;
    }

        .cp2 h1,
        .cp2 h2,
        .cp2 h3,
        .cp2 p {
            margin-top: 0;
        }

    .cp2-kicker {
        color: #4ADE80;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 1.7px;
        text-transform: uppercase;
    }

    .cp2-title {
        margin: 9px 0;
        font-size: 36px;
        font-weight: 800;
        color: #F8FAFC;
    }

    .cp2-muted {
        color: #9CA3AF;
        font-size: 13px;
        line-height: 1.7;
    }

    .cp2-layout {
        display: grid;
        grid-template-columns: minmax(0, 1.7fr) minmax(270px, .8fr);
        gap: 20px;
        margin-top: 25px;
        align-items: start;
    }

    .cp2-main,
    .cp2-side {
        display: flex;
        flex-direction: column;
        gap: 20px;
        min-width: 0;
    }

    .cp2-card {
        padding: 25px;
        border: 1px solid #26352A;
        border-radius: 19px;
        background: var(--ht-tone-111713);
    }

    /* PROFILE HEADER */

    .cp2-hero {
        display: flex;
        align-items: center;
        gap: 24px;
        padding: 30px;
        background: radial-gradient( circle at top right, rgba(34,197,94,.13), transparent 45% ), var(--ht-tone-111713);
    }

    .cp2-avatar {
        display: flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 100px;
        width: 100px;
        height: 100px;
        border: 3px solid #2F9E52;
        border-radius: 50%;
        background: linear-gradient( 145deg, #183A25, #0B1D12 );
        color: #B5F5CA;
        font-size: 32px;
        font-weight: 800;
        box-shadow: 0 0 0 7px rgba(34,197,94,.08);
        overflow: hidden;
    }

        .cp2-avatar img {
            display: block;
            width: 100%;
            height: 100%;
            border-radius: 50%;
            object-fit: cover;
        }

    .cp2-hero-content {
        min-width: 0;
        flex: 1;
    }

    .cp2-name {
        font-size: 28px;
        font-weight: 800;
        color: #F8FAFC;
        margin-bottom: 6px;
        overflow-wrap: anywhere;
    }

    .cp2-age {
        margin-bottom: 12px;
        color: #AAB6AD;
        font-size: 13px;
    }

    .cp2-badge {
        display: inline-flex;
        align-items: center;
        padding: 6px 12px;
        border-radius: 999px;
        border: 1px solid #2D6B41;
        background: rgba(34,197,94,.1);
        color: #7BEAA0;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 1px;
        text-transform: uppercase;
    }

    /* PHOTO UPLOAD */

    .cp2-photo-form,
    .cp2-remove-form {
        margin: 0;
    }

    .cp2-photo-controls {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        align-items: center;
        margin-top: 15px;
    }

    .cp2-photo-input {
        position: absolute;
        width: 1px;
        height: 1px;
        opacity: 0;
        overflow: hidden;
    }

    .cp2-photo-hint {
        color: #9CA3AF;
        margin: 8px 0 0;
        font-size: 11px;
    }

    .cp2-photo-preview {
        display: none;
        margin-top: 12px;
        width: 96px;
        height: 96px;
        border-radius: 50%;
        object-fit: cover;
        border: 2px solid #22C55E;
    }

    .cp2-photo-save {
        display: none;
        margin-top: 12px;
    }

    /* SECTION HEADINGS */

    .cp2-section-heading {
        display: flex;
        align-items: center;
        gap: 13px;
        margin-bottom: 22px;
    }

    .cp2-section-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 42px;
        height: 42px;
        flex: 0 0 42px;
        border: 1px solid #2B5939;
        border-radius: 12px;
        background: var(--ht-tone-14291b);
        color: #4ADE80;
    }

        .cp2-section-icon svg {
            width: 21px;
            height: 21px;
            fill: none;
            stroke: currentColor;
            stroke-width: 1.8px;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

    .cp2-section-heading h2 {
        margin: 0 0 4px;
        font-size: 19px;
        font-weight: 750;
    }

    .cp2-section-heading p {
        margin: 0;
        color: #93A299;
        font-size: 12px;
    }

    /* HEALTH STATISTICS */

    .cp2-stats {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 12px;
    }

    .cp2-stat {
        padding: 17px 14px;
        border: 1px solid #263B2C;
        border-radius: 13px;
        background: var(--ht-tone-0a100c);
        min-width: 0;
    }

    .cp2-stat-label {
        display: block;
        margin-bottom: 11px;
        color: #99A89C;
        font-size: 12px;
    }

    .cp2-stat-value {
        color: #F3F4F6;
        font-size: 27px;
        font-weight: 800;
    }

    .cp2-stat-unit {
        color: #9CA3AF;
        font-size: 12px;
    }

    /* FITNESS PREFERENCES */

    .cp2-pref-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        padding: 16px 0;
        border-bottom: 1px solid #253329;
    }

        .cp2-pref-row:last-child {
            border-bottom: none;
        }

    .cp2-pref-label {
        color: #A4B0A7;
        font-size: 12px;
    }

    .cp2-pref-value {
        color: #E5F7E9;
        font-size: 12px;
        font-weight: 700;
        text-align: right;
        overflow-wrap: anywhere;
    }

    /* BUTTONS */

    .cp2-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 43px;
        padding: 10px 17px;
        border: 1px solid #34543D;
        border-radius: 11px;
        background: var(--ht-tone-17241a);
        color: #E5F7E9;
        font-size: 12px;
        font-weight: 750;
        text-decoration: none;
        cursor: pointer;
    }

        .cp2-btn:hover,
        .cp2-btn:focus {
            background: var(--ht-tone-203827);
            color: #FFFFFF;
            text-decoration: none;
        }

    .cp2-btn-primary {
        background: #22C55E;
        color: #06120A;
        border-color: #22C55E;
    }

        .cp2-btn-primary:hover,
        .cp2-btn-primary:focus {
            background: #4ADE80;
            color: #06120A;
        }

    .cp2-btn-full {
        width: 100%;
    }

    .cp2-small-btn {
        min-height: 36px;
        padding: 8px 12px;
    }

    /* EDIT FORM */

    .cp2-edit {
        scroll-margin-top: 20px;
    }

    .cp2-form-heading {
        margin: 23px 0 17px;
        padding-top: 20px;
        border-top: 1px solid #27362B;
        color: #C7F5D3;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 1px;
        text-transform: uppercase;
    }

    .cp2-first-heading {
        padding-top: 0;
        margin-top: 0;
        border-top: 0;
    }

    .cp2-form-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 19px;
    }

    .cp2-field {
        min-width: 0;
    }

        .cp2-field label {
            display: block;
            margin-bottom: 9px;
            color: #D9E4DC;
            font-size: 12px;
            font-weight: 700;
        }

    .cp2 .cp2-input,
    .cp2 .cp2-select {
        display: block;
        width: 100%;
        max-width: none !important;
        height: 47px;
        padding: 0 13px;
        border: 1px solid #304537;
        border-radius: 10px;
        background: var(--ht-tone-090f0b);
        color: #F3F4F6;
        font-size: 13px;
        outline: none;
        box-shadow: none;
    }

        .cp2 .cp2-input:focus,
        .cp2 .cp2-select:focus {
            border-color: #22C55E;
            box-shadow: 0 0 0 3px rgba(34,197,94,.13);
        }

        .cp2 .cp2-input::placeholder {
            color: #718077;
        }

    .cp2-help {
        display: block;
        margin-top: 8px;
        color: #809084;
        font-size: 11px;
    }

    .cp2-actions {
        display: flex;
        justify-content: flex-end;
        flex-wrap: wrap;
        gap: 11px;
        margin-top: 25px;
    }

    /* MESSAGES AND VALIDATION */

    .cp2-alert {
        padding: 13px 16px;
        margin: 14px 0;
        border-radius: 11px;
        font-size: 13px;
        line-height: 1.7;
    }

    .cp2-success {
        background: var(--ht-tone-12371f);
        border: 1px solid #2B7440;
        color: #BDF7CD;
    }

    .cp2-warning {
        background: var(--ht-tone-342b12);
        border: 1px solid #76622C;
        color: #F8DF9B;
    }

    .cp2-error {
        background: var(--ht-tone-381a1d);
        border: 1px solid #7C3039;
        color: #FECACA;
    }

    .cp2 .field-validation-error,
    .cp2 .validation-summary-errors,
    .cp2 .text-danger {
        display: block;
        margin-top: 7px;
        color: #FDA4AF !important;
        font-size: 12px;
    }

    .cp2 .input-validation-error {
        border-color: #EF4444 !important;
    }

    /* DATE PICKER */

    .flatpickr-calendar {
        background: var(--ht-tone-0d1710) !important;
        border: 1px solid #2C5338 !important;
        box-shadow: 0 15px 35px rgba(0,0,0,.5) !important;
    }

    .flatpickr-months .flatpickr-month,
    .flatpickr-current-month,
    .flatpickr-weekdays,
    .flatpickr-weekday,
    .flatpickr-day {
        color: #F3F4F6 !important;
    }

        .flatpickr-current-month
        .flatpickr-monthDropdown-months,
        .flatpickr-current-month input.cur-year {
            color: #F3F4F6 !important;
            background: transparent !important;
        }

        .flatpickr-day.selected {
            background: #22C55E !important;
            border-color: #22C55E !important;
            color: #07140B !important;
        }

        .flatpickr-day.today {
            border-color: #22C55E !important;
        }

    .flatpickr-prev-month svg,
    .flatpickr-next-month svg {
        fill: #4ADE80 !important;
    }

    /* RESPONSIVE */

    @@media (max-width: 1050px) {
        .cp2-layout {
            grid-template-columns: 1fr;
        }

        .cp2-side {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 660px) {
        .cp2-card {
            padding: 18px;
        }

        .cp2-hero {
            gap: 17px;
            align-items: flex-start;
        }

        .cp2-avatar {
            width: 70px;
            height: 70px;
            flex-basis: 70px;
            font-size: 23px;
        }

        .cp2-name {
            font-size: 22px;
        }

        .cp2-stats {
            grid-template-columns: 1fr;
        }

        .cp2-form-grid,
        .cp2-side {
            grid-template-columns: 1fr;
        }

        .cp2-actions .cp2-btn {
            flex: 1;
        }
    }
</style>

<div class="cp2">

    <!-- PAGE HEADER -->

    <header>
        <span class="cp2-kicker">
            HealthTrack Pro / Client Account
        </span>

        <h1 class="cp2-title">
            My Profile
        </h1>

        <p class="cp2-muted">
            Your health information, fitness preferences
            and personal details in one place.
        </p>
    </header>

    <!-- SUCCESS AND ERROR MESSAGES -->

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="cp2-alert cp2-success" role="status">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["WarningMessage"] != null)
    {
        <div class="cp2-alert cp2-warning" role="status">
            @TempData["WarningMessage"]
        </div>
    }

    @if (TempData["PhotoSuccess"] != null)
    {
        <div class="cp2-alert cp2-success" role="status">
            @TempData["PhotoSuccess"]
        </div>
    }

    @if (TempData["PhotoError"] != null)
    {
        <div class="cp2-alert cp2-error" role="alert">
            @TempData["PhotoError"]
        </div>
    }

    <div class="cp2-layout">

        <div class="cp2-main">

            <!-- PROFILE HEADER AND PHOTO -->

            <section class="cp2-card cp2-hero">

                <div class="cp2-avatar"
                     aria-label="Your profile picture">

                    @if (hasProfilePhoto)
                    {
                        <img src="@photoUrl"
                             alt="Your profile picture" />
                    }
                    else
                    {
                        @initials
                    }

                </div>

                <div class="cp2-hero-content">

                    <h2 class="cp2-name">
                        @profileName
                    </h2>

                    <p class="cp2-age">
                        @if (age.HasValue)
                        {
                            <span>
                                @age.Value years old
                            </span>
                        }
                        else
                        {
                            <span>
                                Add your date of birth
                                to display your age
                            </span>
                        }
                    </p>

                    <span class="cp2-badge">
                        Client Member
                    </span>

                    <!-- PHOTO UPLOAD FORM -->

                    @using (Html.BeginForm(
                        "UploadPhoto",
                        "Profile",
                        new { area = "Client" },
                        FormMethod.Post,
                        new
                        {
                            enctype = "multipart/form-data",
                            id = "cp2-upload-form",
                            @class = "cp2-photo-form"
                        }))
                    {
                        @Html.AntiForgeryToken()

                        <div class="cp2-photo-controls">

                            <label for="cp2-photo-file"
                                   class="cp2-btn cp2-small-btn">

                                @(hasProfilePhoto
                                    ? "Change Photo"
                                    : "Upload Photo")

                            </label>

                            <input id="cp2-photo-file"
                                   name="photo"
                                   type="file"
                                   class="cp2-photo-input"
                                   accept="image/jpeg,image/png,image/webp"
                                   aria-label="Choose a profile photo" />

                        </div>

                        <p class="cp2-photo-hint">
                            JPG, PNG or WebP. Maximum 2 MB.
                        </p>

                        <!-- SELECTED PHOTO PREVIEW -->

                        <img id="cp2-preview"
                             class="cp2-photo-preview"
                             alt="Selected profile photo preview" />

                        <button id="cp2-save-photo"
                                type="submit"
                                class="cp2-btn cp2-btn-primary cp2-photo-save">

                            Save Photo

                        </button>
                    }

                    <!-- REMOVE PHOTO FORM -->

                    @if (hasProfilePhoto)
                    {
                        using (Html.BeginForm(
                            "RemovePhoto",
                            "Profile",
                            new { area = "Client" },
                            FormMethod.Post,
                            new { @class = "cp2-remove-form" }))
                        {
                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="cp2-btn cp2-small-btn"
                                    style="margin-top:10px">

                                Remove Photo

                            </button>
                        }
                    }

                </div>

            </section>

            <!-- HEALTH OVERVIEW -->

            <section class="cp2-card">

                <div class="cp2-section-heading">

                    <span class="cp2-section-icon"
                          aria-hidden="true">

                        <svg viewBox="0 0 24 24">
                            <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8z" />
                        </svg>

                    </span>

                    <div>
                        <h2>Health Overview</h2>
                        <p>Measurements from your saved profile</p>
                    </div>

                </div>

                <div class="cp2-stats">

                    <div class="cp2-stat">
                        <span class="cp2-stat-label">
                            Height
                        </span>

                        <span class="cp2-stat-value">
                            @heightText
                        </span>

                        <span class="cp2-stat-unit">
                            cm
                        </span>
                    </div>

                    <div class="cp2-stat">
                        <span class="cp2-stat-label">
                            Weight
                        </span>

                        <span class="cp2-stat-value">
                            @weightText
                        </span>

                        <span class="cp2-stat-unit">
                            kg
                        </span>
                    </div>

                    <div class="cp2-stat">
                        <span class="cp2-stat-label">
                            BMI
                        </span>

                        <span class="cp2-stat-value">
                            @bmiText
                        </span>
                    </div>

                </div>

                <p class="cp2-muted" style="margin:15px 0 0">
                    BMI is an estimate based on height
                    and weight, not a complete
                    assessment of health.
                </p>

            </section>

            <!-- EDIT PROFILE -->

            <section class="cp2-card cp2-edit"
                     id="edit-profile">

                <div class="cp2-section-heading">

                    <span class="cp2-section-icon"
                          aria-hidden="true">

                        <svg viewBox="0 0 24 24">
                            <path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L9 17l-4 1 1-4z" />
                        </svg>

                    </span>

                    <div>
                        <h2>Edit Profile</h2>
                        <p>Update your details and save changes</p>
                    </div>

                </div>

                @using (Html.BeginForm(
                    "Index",
                    "Profile",
                    new { area = "Client" },
                    FormMethod.Post,
                    new { @class = "cp2-profile-form" }))
                {
                    @Html.AntiForgeryToken()

                    if (!ViewData.ModelState.IsValid)
                    {
                        <div class="cp2-alert cp2-error"
                             role="alert">

                            @Html.ValidationSummary(
                                false,
                                "Please correct the highlighted fields:")

                        </div>
                    }

                    <div class="cp2-form-heading cp2-first-heading">
                        Personal Information
                    </div>

                    <div class="cp2-form-grid">

                        <div class="cp2-field">

                            @Html.LabelFor(m => m.FullName)

                            @Html.TextBoxFor(
                                m => m.FullName,
                                new
                                {
                                    @class = "cp2-input",
                                    placeholder = "Your full name",
                                    autocomplete = "name"
                                })

                            @Html.ValidationMessageFor(
                                m => m.FullName,
                                "",
                                new { @class = "text-danger" })

                        </div>

                        <div class="cp2-field">

                            @Html.LabelFor(m => m.DateOfBirth)

                            @Html.TextBoxFor(
                                m => m.DateOfBirth,
                                "{0:yyyy-MM-dd}",
                                new
                                {
                                    @class = "cp2-input js-profile-date",
                                    placeholder = "Select date of birth",
                                    autocomplete = "bday"
                                })

                            @Html.ValidationMessageFor(
                                m => m.DateOfBirth,
                                "",
                                new { @class = "text-danger" })

                        </div>

                    </div>

                    <div class="cp2-form-heading">
                        Body Measurements
                    </div>

                    <div class="cp2-form-grid">

                        <div class="cp2-field">

                            @Html.LabelFor(m => m.HeightCm)

                            @Html.TextBoxFor(
                                m => m.HeightCm,
                                new
                                {
                                    @class = "cp2-input",
                                    type = "number",
                                    step = "0.1",
                                    min = "50",
                                    max = "250",
                                    placeholder = "Height in cm"
                                })

                            @Html.ValidationMessageFor(
                                m => m.HeightCm,
                                "",
                                new { @class = "text-danger" })

                            <span class="cp2-help">
                                Allowed range: 50–250 cm
                            </span>

                        </div>

                        <div class="cp2-field">

                            @Html.LabelFor(m => m.CurrentWeightKg)

                            @Html.TextBoxFor(
                                m => m.CurrentWeightKg,
                                new
                                {
                                    @class = "cp2-input",
                                    type = "number",
                                    step = "0.1",
                                    min = "20",
                                    max = "500",
                                    placeholder = "Weight in kg"
                                })

                            @Html.ValidationMessageFor(
                                m => m.CurrentWeightKg,
                                "",
                                new { @class = "text-danger" })

                            <span class="cp2-help">
                                Allowed range: 20–500 kg
                            </span>

                        </div>

                    </div>

                    <div class="cp2-form-heading">
                        Fitness Preferences
                    </div>

                    <div class="cp2-form-grid">

                        <div class="cp2-field">

                            @Html.LabelFor(m => m.ActivityLevel)

                            @Html.EnumDropDownListFor(
                                m => m.ActivityLevel,
                                "Select activity level",
                                new { @class = "cp2-select" })

                            @Html.ValidationMessageFor(
                                m => m.ActivityLevel,
                                "",
                                new { @class = "text-danger" })

                        </div>

                        <div class="cp2-field">

                            @Html.LabelFor(m => m.PrimaryGoal)

                            @Html.EnumDropDownListFor(
                                m => m.PrimaryGoal,
                                "Select primary goal",
                                new { @class = "cp2-select" })

                            @Html.ValidationMessageFor(
                                m => m.PrimaryGoal,
                                "",
                                new { @class = "text-danger" })

                        </div>

                    </div>

                    <div class="cp2-actions">

                        <a href="@dashboardUrl"
                           class="cp2-btn">
                            Dashboard
                        </a>

                        <button type="submit"
                                class="cp2-btn cp2-btn-primary">
                            Save Changes
                        </button>

                    </div>
                }

            </section>

        </div>

        <!-- SIDEBAR -->

        <aside class="cp2-side">

            <section class="cp2-card">

                <div class="cp2-section-heading">

                    <span class="cp2-section-icon"
                          aria-hidden="true">

                        <svg viewBox="0 0 24 24">
                            <circle cx="12" cy="12" r="9" />
                            <circle cx="12" cy="12" r="5" />
                            <circle cx="12" cy="12" r="1" />
                        </svg>

                    </span>

                    <div>
                        <h2>Fitness Preferences</h2>
                        <p>Your current settings</p>
                    </div>

                </div>

                <div class="cp2-pref-row">

                    <span class="cp2-pref-label">
                        Activity Level
                    </span>

                    <span class="cp2-pref-value">
                        @activityText
                    </span>

                </div>

                <div class="cp2-pref-row">

                    <span class="cp2-pref-label">
                        Primary Goal
                    </span>

                    <span class="cp2-pref-value">
                        @goalText
                    </span>

                </div>

                <a href="#edit-profile"
                   class="cp2-btn cp2-btn-primary cp2-btn-full"
                   style="margin-top:22px">

                    Edit My Profile

                </a>

            </section>

            <section class="cp2-card">

                <div class="cp2-section-heading">

                    <span class="cp2-section-icon"
                          aria-hidden="true">

                        <svg viewBox="0 0 24 24">
                            <circle cx="12" cy="12" r="9" />
                            <path d="M8 12l3 3 5-6" />
                        </svg>

                    </span>

                    <div>
                        <h2>Keep Progressing</h2>
                        <p>Your fitness journey</p>
                    </div>

                </div>

                <p class="cp2-muted">
                    Keep your health information
                    up to date and track your goals
                    as you progress.
                </p>

                <a href="@goalsUrl"
                   class="cp2-btn cp2-btn-full">

                    View Fitness Goals

                </a>

            </section>

        </aside>

    </div>

</div>

<!-- FLATPICKR DATE PICKER -->

<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        // PROFILE PICTURE PREVIEW
        var photoInput =
            document.getElementById("cp2-photo-file");

        var preview =
            document.getElementById("cp2-preview");

        var saveButton =
            document.getElementById("cp2-save-photo");

        if (photoInput && preview && saveButton) {

            photoInput.addEventListener("change", function () {

                if (!photoInput.files ||
                    photoInput.files.length === 0) {
                    return;
                }

                var file = photoInput.files[0];

                var allowedTypes = [
                    "image/jpeg",
                    "image/png",
                    "image/webp"
                ];

                if (file.size > 2 * 1024 * 1024 ||
                    allowedTypes.indexOf(file.type) === -1) {

                    alert(
                        "Please select a JPG, PNG or WebP image " +
                        "that is 2 MB or smaller."
                    );

                    photoInput.value = "";
                    preview.style.display = "none";
                    saveButton.style.display = "none";

                    return;
                }

                var reader = new FileReader();

                reader.onload = function (event) {

                    preview.src = event.target.result;
                    preview.style.display = "block";
                    saveButton.style.display = "inline-flex";

                };

                reader.readAsDataURL(file);

            });

        }

        // DATE OF BIRTH PICKER
        if (typeof flatpickr !== "undefined") {

            var dateInputs =
                document.querySelectorAll(".js-profile-date");

            for (var i = 0; i < dateInputs.length; i++) {

                flatpickr(dateInputs[i], {
                    dateFormat: "Y-m-d",
                    altInput: true,
                    altFormat: "F j, Y",
                    maxDate: "today",
                    disableMobile: true
                });

            }
        }

    });
</script>
