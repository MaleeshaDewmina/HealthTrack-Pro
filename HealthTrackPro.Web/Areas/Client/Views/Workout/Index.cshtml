
@model HealthTrackPro.Web.Areas.Client.Models.ClientWorkoutViewModel
@using System
@using System.Linq
@using System.Collections.Generic
@using HealthTrackPro.Web.Models.Workouts

@{
    ViewBag.Title = "My Workout Plan";

    // Real assigned workout plans
    var plans = Model != null && Model.Plans != null
        ? Model.Plans
        : new List<WorkoutPlan>();

    // Active plan retrieved from WorkoutService
    var activePlan = Model != null
        ? Model.ActivePlan
        : null;

    var totalPlans = plans.Count;

    var activePlans = plans.Count(p => p.IsActive);

    var totalExercises = plans.Sum(p =>
        p.WorkoutExercises != null
            ? p.WorkoutExercises.Count
            : 0);

    var dashboardUrl = Url.Action(
        "Index",
        "Dashboard",
        new { area = "Client" });
}

<style>
    /* =======================================
       HEALTHTRACK PRO - CLIENT WORKOUT
       ======================================= */

    .cw-page {
        max-width: 1450px;
        margin: 0 auto;
        padding: 15px 0 45px;
        color: #F3F4F6;
    }

        .cw-page,
        .cw-page * {
            box-sizing: border-box;
        }

    /* HEADER */

    .cw-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        flex-wrap: wrap;
        gap: 20px;
        margin-bottom: 27px;
    }

    .cw-eyebrow {
        display: block;
        margin-bottom: 10px;
        color: #4ADE80;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1.3px;
    }

    .cw-title {
        margin: 0 0 10px;
        font-size: 32px;
        font-weight: 800;
        color: #F3F4F6;
    }

    .cw-subtitle {
        margin: 0;
        color: #9CA3AF;
        font-size: 13px;
        line-height: 1.8;
    }

    .cw-back-link {
        display: inline-flex;
        align-items: center;
        padding: 11px 16px;
        background: #121C16;
        border: 1px solid #2B4233;
        border-radius: 9px;
        color: #D1D5DB;
        text-decoration: none;
        font-size: 12px;
        font-weight: 700;
    }

        .cw-back-link:hover {
            color: #4ADE80;
            border-color: #22C55E;
            text-decoration: none;
        }

    /* STATS */

    .cw-stats {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 16px;
        margin-bottom: 24px;
    }

    .cw-stat {
        padding: 22px;
        background: #111713;
        border: 1px solid #1F2A22;
        border-radius: 13px;
    }

    .cw-stat-label {
        display: block;
        margin-bottom: 15px;
        color: #9CA3AF;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.6px;
    }

    .cw-stat-value {
        color: #F3F4F6;
        font-size: 29px;
        font-weight: 800;
    }

    .cw-stat-note {
        margin: 10px 0 0;
        color: #899A8E;
        font-size: 11px;
    }

    /* SHARED PANELS */

    .cw-panel {
        margin-bottom: 22px;
        padding: 25px;
        background: #111713;
        border: 1px solid #1F2A22;
        border-radius: 14px;
    }

    .cw-section-heading {
        margin: 0 0 18px;
        color: #F3F4F6;
        font-size: 19px;
        font-weight: 700;
    }

    .cw-section-description {
        margin: -8px 0 20px;
        color: #9CA3AF;
        font-size: 12px;
        line-height: 1.8;
    }

    /* ACTIVE PLAN OVERVIEW */

    .cw-active-card {
        position: relative;
        padding: 26px;
        background: linear-gradient(135deg, #193623 0%, #101A13 65%);
        border: 1px solid #2D6740;
        border-radius: 13px;
    }

    .cw-active-label {
        display: inline-block;
        margin-bottom: 15px;
        color: #4ADE80;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1px;
    }

    .cw-active-name {
        margin: 0 0 10px;
        color: #F3F4F6;
        font-size: 24px;
        font-weight: 800;
    }

    .cw-active-description {
        margin: 0;
        max-width: 720px;
        color: #B6C5BA;
        font-size: 13px;
        line-height: 1.8;
    }

    /* PLAN CARDS */

    .cw-plan-card {
        margin-bottom: 19px;
        padding: 25px;
        background: #111713;
        border: 1px solid #263B2D;
        border-radius: 14px;
    }

    .cw-plan-heading {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 15px;
        margin-bottom: 20px;
    }

    .cw-plan-name {
        margin: 0 0 8px;
        color: #F3F4F6;
        font-size: 20px;
        font-weight: 700;
    }

    .cw-plan-desc {
        margin: 0 0 20px;
        color: #A6B2AA;
        font-size: 13px;
        line-height: 1.8;
        overflow-wrap: anywhere;
    }

    .cw-badge {
        display: inline-flex;
        align-items: center;
        padding: 7px 12px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
    }

    .cw-badge-active {
        background: #1D452A;
        border: 1px solid #327C47;
        color: #86EFAC;
    }

    .cw-badge-inactive {
        background: #242B26;
        border: 1px solid #3A473E;
        color: #9CA3AF;
    }

    /* PLAN DETAILS */

    .cw-details {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 12px;
        margin-bottom: 23px;
    }

    .cw-detail {
        min-width: 0;
        padding: 15px;
        background: #0B120D;
        border: 1px solid #28392D;
        border-radius: 10px;
    }

    .cw-detail-label {
        display: block;
        margin-bottom: 9px;
        color: #899A8E;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.5px;
    }

    .cw-detail-value {
        display: block;
        color: #F3F4F6;
        font-size: 14px;
        font-weight: 700;
    }

    /* EXERCISE LIST */

    .cw-exercises-heading {
        margin: 0 0 15px;
        padding-top: 20px;
        border-top: 1px solid #29382D;
        color: #F3F4F6;
        font-size: 15px;
        font-weight: 700;
    }

    .cw-exercise {
        margin-bottom: 12px;
        padding: 19px;
        background: #0B120D;
        border: 1px solid #263A2D;
        border-radius: 11px;
    }

    .cw-exercise-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 13px;
    }

    .cw-exercise-name {
        margin: 0 0 7px;
        color: #F3F4F6;
        font-size: 16px;
        font-weight: 700;
    }

    .cw-exercise-muscle {
        color: #4ADE80;
        font-size: 11px;
        font-weight: 600;
    }

    .cw-exercise-difficulty {
        color: #9CA3AF;
        font-size: 11px;
    }

    .cw-exercise-stats {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin: 13px 0;
    }

    .cw-exercise-stat {
        display: inline-flex;
        align-items: center;
        padding: 8px 12px;
        color: #C7DED0;
        background: #18261C;
        border: 1px solid #2D4934;
        border-radius: 8px;
        font-size: 11px;
        font-weight: 600;
    }

    .cw-exercise-description {
        margin: 12px 0 0;
        color: #A6B2AA;
        font-size: 12px;
        line-height: 1.8;
        white-space: pre-line;
        overflow-wrap: anywhere;
    }

    .cw-note {
        margin-top: 14px;
        padding: 13px 15px;
        color: #B7DDC1;
        background: #152B1C;
        border-left: 3px solid #22C55E;
        border-radius: 7px;
        font-size: 12px;
        line-height: 1.8;
        overflow-wrap: anywhere;
    }

    /* EMPTY STATES */

    .cw-empty {
        padding: 45px 20px;
        background: #111713;
        border: 1px dashed #355540;
        border-radius: 13px;
        text-align: center;
    }

    .cw-empty-title {
        margin: 0 0 12px;
        color: #F3F4F6;
        font-size: 18px;
        font-weight: 700;
    }

    .cw-empty-description {
        max-width: 450px;
        margin: 0 auto;
        color: #9CA3AF;
        font-size: 13px;
        line-height: 1.8;
    }

    .cw-empty-small {
        padding: 18px;
        background: #0B120D;
        border: 1px dashed #355540;
        border-radius: 10px;
        color: #9CA3AF;
        font-size: 12px;
        text-align: center;
    }

    /* RESPONSIVE */

    @@media (max-width: 900px) {
        .cw-stats {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .cw-details {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 600px) {
        .cw-title {
            font-size: 25px;
        }

        .cw-stats {
            gap: 10px;
        }

        .cw-stat {
            padding: 16px;
        }

        .cw-stat-value {
            font-size: 25px;
        }

        .cw-panel,
        .cw-plan-card {
            padding: 18px;
        }

        .cw-active-card {
            padding: 20px;
        }

        .cw-details {
            gap: 9px;
        }

        .cw-detail {
            padding: 12px;
        }
    }
</style>


<div class="cw-page">

    <!-- PAGE HEADER -->

    <header class="cw-header">

        <div>

            <span class="cw-eyebrow">
                HEALTHTRACK PRO / CLIENT
            </span>

            <h1 class="cw-title">
                My Workout Plan
            </h1>

            <p class="cw-subtitle">
                Explore your trainer-assigned workout plans,
                review exercises, and prepare for your sessions.
            </p>

        </div>

        <a href="@dashboardUrl"
           class="cw-back-link">
            Back to Dashboard
        </a>

    </header>


    <!-- SUMMARY CARDS -->

    <section class="cw-stats"
             aria-label="Workout statistics">

        <div class="cw-stat">
            <span class="cw-stat-label">TOTAL PLANS</span>
            <strong class="cw-stat-value">@totalPlans</strong>
            <p class="cw-stat-note">Plans assigned to you</p>
        </div>

        <div class="cw-stat">
            <span class="cw-stat-label">ACTIVE PLANS</span>
            <strong class="cw-stat-value">@activePlans</strong>
            <p class="cw-stat-note">Currently active plans</p>
        </div>

        <div class="cw-stat">
            <span class="cw-stat-label">ASSIGNED EXERCISES</span>
            <strong class="cw-stat-value">@totalExercises</strong>
            <p class="cw-stat-note">
                Exercise entries across all plans
            </p>
        </div>

    </section>


    <!-- ACTIVE WORKOUT OVERVIEW -->

    <section class="cw-panel">

        <h2 class="cw-section-heading">
            Active Workout Plan
        </h2>

        @if (activePlan != null)
        {
            <div class="cw-active-card">

                <span class="cw-active-label">
                    CURRENTLY ACTIVE
                </span>

                <h3 class="cw-active-name">
                    @activePlan.Name
                </h3>

                @if (!string.IsNullOrWhiteSpace(activePlan.Description))
                {
                    <p class="cw-active-description">
                        @activePlan.Description
                    </p>
                }

            </div>
        }
        else
        {
            <div class="cw-empty-small">
                You don't have an active workout plan yet.
                An active plan will appear here when
                your trainer assigns and activates one.
            </div>
        }

    </section>


    <!-- ALL ASSIGNED WORKOUT PLANS -->

    <section aria-labelledby="cwPlansHeading">

        <h2 id="cwPlansHeading"
            class="cw-section-heading">
            Assigned Workout Plans
        </h2>

        <p class="cw-section-description">
            View the exercises and instructions
            included in your workout plans.
        </p>


        @if (totalPlans == 0)
        {
            <div class="cw-empty">

                <h3 class="cw-empty-title">
                    No Workout Plans Assigned
                </h3>

                <p class="cw-empty-description">
                    Your trainer has not assigned a workout
                    plan to your account yet. Once a plan
                    is assigned, its exercises and training
                    details will appear here.
                </p>

            </div>
        }
        else
        {
            foreach (var plan in plans
                .OrderByDescending(p => p.IsActive)
                .ThenByDescending(p => p.StartDate))
            {
                var exercises = plan.WorkoutExercises != null
                    ? plan.WorkoutExercises
                        .OrderBy(e => e.DisplayOrder)
                        .ToList()
                    : new List<WorkoutExercise>();

                <article class="cw-plan-card">

                    <!-- PLAN HEADER -->

                    <div class="cw-plan-heading">

                        <div>
                            <h3 class="cw-plan-name">
                                @plan.Name
                            </h3>
                        </div>

                        @if (plan.IsActive)
                        {
                            <span class="cw-badge cw-badge-active">
                                Active Plan
                            </span>
                        }
                        else
                        {
                            <span class="cw-badge cw-badge-inactive">
                                Inactive
                            </span>
                        }

                    </div>


                    <!-- DESCRIPTION -->

                    @if (!string.IsNullOrWhiteSpace(plan.Description))
                    {
                        <p class="cw-plan-desc">
                            @plan.Description
                        </p>
                    }


                    <!-- PLAN INFORMATION -->

                    <div class="cw-details">

                        <div class="cw-detail">

                            <span class="cw-detail-label">
                                START DATE
                            </span>

                            <strong class="cw-detail-value">
                                @plan.StartDate.ToString("dd MMM yyyy")
                            </strong>

                        </div>

                        <div class="cw-detail">

                            <span class="cw-detail-label">
                                END DATE
                            </span>

                            <strong class="cw-detail-value">
                                @(plan.EndDate.HasValue
                                    ? plan.EndDate.Value.ToString("dd MMM yyyy")
                                    : "Not set")
                            </strong>

                        </div>

                        <div class="cw-detail">

                            <span class="cw-detail-label">
                                EXERCISES
                            </span>

                            <strong class="cw-detail-value">
                                @exercises.Count
                            </strong>

                        </div>

                    </div>


                    <!-- EXERCISES -->

                    <h4 class="cw-exercises-heading">
                        Exercises
                    </h4>

                    @if (exercises.Count == 0)
                    {
                        <div class="cw-empty-small">
                            No exercises have been added
                            to this workout plan yet.
                        </div>
                    }
                    else
                    {
                        foreach (var workoutExercise in exercises)
                        {
                            var exercise = workoutExercise.Exercise;

                            <div class="cw-exercise">

                                <div class="cw-exercise-header">

                                    <div>

                                        <h5 class="cw-exercise-name">
                                            @(exercise != null
                                                ? exercise.Name
                                                : "Exercise details unavailable")
                                        </h5>

                                        @if (exercise != null &&
                                            !string.IsNullOrWhiteSpace(
                                                exercise.MuscleGroup))
                                        {
                                            <span class="cw-exercise-muscle">
                                                @exercise.MuscleGroup
                                            </span>
                                        }

                                    </div>


                                    @if (exercise != null &&
    Enum.IsDefined(
        typeof(HealthTrackPro.Web.Enums.WorkoutDifficulty),
        exercise.Difficulty))
{
    <span class="cw-exercise-difficulty">
        @exercise.Difficulty
    </span>
}

                                </div>


                                <!-- SETS / REPS / REST -->

                                <div class="cw-exercise-stats">

                                    <span class="cw-exercise-stat">
                                        @workoutExercise.Sets Sets
                                    </span>

                                    <span class="cw-exercise-stat">
                                        @workoutExercise.Repetitions Reps
                                    </span>

                                    <span class="cw-exercise-stat">
                                        @workoutExercise.RestSeconds sec Rest
                                    </span>

                                    @if (workoutExercise.DurationMinutes.HasValue)
                                    {
                                        <span class="cw-exercise-stat">
                                            @workoutExercise.DurationMinutes.Value min
                                        </span>
                                    }

                                </div>


                                <!-- EXERCISE INSTRUCTIONS -->

                                @if (exercise != null &&
                                    !string.IsNullOrWhiteSpace(
                                        exercise.Instructions))
                                {
                                    <p class="cw-exercise-description">
                                        @exercise.Instructions
                                    </p>
                                }


                                <!-- TRAINER NOTES -->

                                @if (!string.IsNullOrWhiteSpace(
                                    workoutExercise.Notes))
                                {
                                    <div class="cw-note">

                                        <strong>Trainer Notes:</strong>

                                        @workoutExercise.Notes

                                    </div>
                                }

                            </div>
                        }
                    }

                </article>
            }
        }

    </section>

</div>

