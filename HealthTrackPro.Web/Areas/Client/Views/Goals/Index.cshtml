           class="cg-back-link">

            <svg viewBox="0 0 24 24"
                 fill="none"
                 stroke-width="1.8"
                 stroke-linecap="round"
                 stroke-linejoin="round"
                 aria-hidden="true">

                <path d="M19 12H5"></path>
                <path d="M12 19l-7-7 7-7"></path>

            </svg>

            Dashboard

        </a>

    </header>


    <!-- =====================================
         SUMMARY STATISTICS
         ===================================== -->

    <section class="cg-summary-grid"
             aria-label="Fitness goal statistics">

        <!-- TOTAL GOALS -->

        <div class="cg-summary-card">

            <div class="cg-summary-top">

                <span class="cg-summary-label">
                    TOTAL GOALS
                </span>

                <div class="cg-summary-icon">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <circle cx="12" cy="12" r="9"></circle>
                        <circle cx="12" cy="12" r="5"></circle>
                        <circle cx="12" cy="12" r="1"></circle>

                    </svg>

                </div>

            </div>

            <p class="cg-summary-value">
                @totalGoals
            </p>

            <p class="cg-summary-description">
                All your fitness targets
            </p>

        </div>


        <!-- ACTIVE GOALS -->

        <div class="cg-summary-card">

            <div class="cg-summary-top">

                <span class="cg-summary-label">
                    ACTIVE GOALS
                </span>

                <div class="cg-summary-icon">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <path d="M3 17l6-6 4 4 8-8"></path>
                        <path d="M15 7h6v6"></path>

                    </svg>

                </div>

            </div>

            <p class="cg-summary-value">
                @activeGoals
            </p>

            <p class="cg-summary-description">
                Goals currently in progress
            </p>

        </div>


        <!-- COMPLETED GOALS -->

        <div class="cg-summary-card">

            <div class="cg-summary-top">

                <span class="cg-summary-label">
                    COMPLETED
                </span>

                <div class="cg-summary-icon">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <circle cx="12" cy="12" r="9"></circle>
                        <path d="M8 12l3 3 5-6"></path>

                    </svg>

                </div>

            </div>

            <p class="cg-summary-value">
                @completedGoals
            </p>

            <p class="cg-summary-description">
                Goals marked as completed
            </p>

        </div>


        <!-- AVERAGE PROGRESS -->

        <div class="cg-summary-card">

            <div class="cg-summary-top">

                <span class="cg-summary-label">
                    AVG. PROGRESS
                </span>

                <div class="cg-summary-icon">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <path d="M4 20V13"></path>
                        <path d="M10 20V8"></path>
                        <path d="M16 20V4"></path>
                        <path d="M22 20H2"></path>

                    </svg>

                </div>

            </div>

            <p class="cg-summary-value">
                @averageProgress.ToString("0.#")%
            </p>

            <p class="cg-summary-description">
                Average measured goal progress
            </p>

        </div>

    </section>


    <!-- =====================================
         SUCCESS MESSAGE
         ===================================== -->

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="cg-alert cg-alert-success"
             role="status">

            @TempData["SuccessMessage"]

        </div>
    }


    <!-- =====================================
         ERROR MESSAGE
         ===================================== -->

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="cg-alert cg-alert-error"
             role="alert">

            @TempData["ErrorMessage"]

        </div>
    }


    <!-- =====================================
         CREATE FITNESS GOAL
         ===================================== -->

    <section class="cg-panel"
             aria-labelledby="cgCreateTitle">

        <div class="cg-panel-header">

            <div class="cg-panel-icon">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke-width="1.8"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     aria-hidden="true">

                    <circle cx="12" cy="12" r="9"></circle>
                    <path d="M12 8v8"></path>
                    <path d="M8 12h8"></path>

                </svg>

            </div>

            <div>

                <h2 id="cgCreateTitle"
                    class="cg-panel-title">

                    Create a New Goal

                </h2>

                <p class="cg-panel-subtitle">
                    Define a new fitness target
                    and start tracking your progress.
                </p>

            </div>

        </div>


        @using (Html.BeginForm(
            "Create",
            "Goals",
            new { area = "Client" },
            FormMethod.Post,
            new { @class = "cg-create-form" }))
        {
            @Html.AntiForgeryToken()

            @Html.ValidationSummary(
                true,
                "",
                new { @class = "text-danger" })


            <div class="cg-form-grid">

                <!-- GOAL TYPE -->

                <div class="cg-form-field">

                    @Html.LabelFor(m => m.NewGoal.GoalType)

                    <div class="cg-input-wrap">

                        @Html.EnumDropDownListFor(
                            m => m.NewGoal.GoalType,
                            "Select your goal type",
                            new { @class = "cg-select" })

                        <span class="cg-field-icon">

                            <svg viewBox="0 0 24 24"
                                 fill="none"
                                 stroke-width="2"
                                 stroke-linecap="round"
                                 stroke-linejoin="round">

                                <path d="M6 9l6 6 6-6"></path>

                            </svg>

                        </span>

                    </div>

                    @Html.ValidationMessageFor(
                        m => m.NewGoal.GoalType,
                        "",
                        new { @class = "text-danger" })

                </div>


                <!-- GOAL TITLE -->

                <div class="cg-form-field">

                    @Html.LabelFor(m => m.NewGoal.Title)

                    @Html.TextBoxFor(
                        m => m.NewGoal.Title,
                        new
                        {
                            @class = "cg-input",
                            placeholder = "e.g. Reach 65 kg",
                            maxlength = "150"
                        })

                    @Html.ValidationMessageFor(
                        m => m.NewGoal.Title,
                        "",
                        new { @class = "text-danger" })

                </div>


                <!-- DESCRIPTION -->

                <div class="cg-form-field cg-form-field-full">

                    @Html.LabelFor(m => m.NewGoal.Description)

                    @Html.TextAreaFor(
                        m => m.NewGoal.Description,
                        new
                        {
                            @class = "cg-textarea",
                            placeholder =
                                "Describe your goal and how you plan to achieve it...",
                            maxlength = "500",
                            rows = "3"
                        })

                    @Html.ValidationMessageFor(
                        m => m.NewGoal.Description,
                        "",
                        new { @class = "text-danger" })

                    <small class="cg-field-help">
                        Optional. Describe what motivates you
                        or what you plan to achieve.
                    </small>

                </div>


                <!-- STARTING VALUE -->

                <div class="cg-form-field">

                    @Html.LabelFor(m => m.NewGoal.StartValue)

                    @Html.TextBoxFor(
                        m => m.NewGoal.StartValue,
                        new
                        {
                            @class = "cg-input",
                            type = "number",
                            step = "any",
                            placeholder = "e.g. 70"
                        })

                    @Html.ValidationMessageFor(
                        m => m.NewGoal.StartValue,
                        "",
                        new { @class = "text-danger" })

                </div>


                <!-- TARGET VALUE -->

                <div class="cg-form-field">

                    @Html.LabelFor(m => m.NewGoal.TargetValue)

                    @Html.TextBoxFor(
                        m => m.NewGoal.TargetValue,
                        new
                        {
                            @class = "cg-input",
                            type = "number",
                            step = "any",
                            placeholder = "e.g. 65"
                        })

                    @Html.ValidationMessageFor(
                        m => m.NewGoal.TargetValue,
                        "",
                        new { @class = "text-danger" })

                </div>


                <!-- TARGET DATE -->

                <div class="cg-form-field">

                    @Html.LabelFor(m => m.NewGoal.TargetDate)

                    <div class="cg-input-wrap">

                        @Html.TextBoxFor(
                            m => m.NewGoal.TargetDate,
                            "{0:yyyy-MM-dd}",
                            new
                            {
                                @class = "cg-input js-goal-datepicker",
                                type = "date",
                                min = DateTime.Today.ToString("yyyy-MM-dd")
                            })

                        <span class="cg-field-icon">

                            <svg viewBox="0 0 24 24"
                                 fill="none"
                                 stroke-width="1.8"
                                 stroke-linecap="round"
                                 stroke-linejoin="round"
                                 aria-hidden="true">

                                <rect x="3" y="5"
                                      width="18" height="16"
                                      rx="2"></rect>

                                <path d="M8 3v4"></path>
                                <path d="M16 3v4"></path>
                                <path d="M3 10h18"></path>

                            </svg>

                        </span>

                    </div>

                    @Html.ValidationMessageFor(
                        m => m.NewGoal.TargetDate,
                        "",
                        new { @class = "text-danger" })

                    <small class="cg-field-help">
                        Optional. Choose today or a future date.
                    </small>

                </div>

            </div>


            <!-- CREATE GOAL BUTTON -->

            <div class="cg-form-footer">

                <p class="cg-form-note">
                    Your goal will be added to your
                    personal fitness tracking dashboard.
                </p>

                <button type="submit"
                        class="cg-btn cg-btn-primary">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round"
                         aria-hidden="true">

                        <path d="M12 5v14"></path>
                        <path d="M5 12h14"></path>

                    </svg>

                    Create Fitness Goal

                </button>

            </div>
        }

    </section>


    <!-- =====================================
         EXISTING GOALS
         ===================================== -->

    <section aria-labelledby="cgMyGoalsHeading">

        <div class="cg-goals-header">

            <h2 id="cgMyGoalsHeading"
                class="cg-goals-heading">

                My Goals

                <span class="cg-count">
                    @totalGoals
                </span>

            </h2>

            <span class="cg-goals-caption">
                Track your personal milestones
            </span>

        </div>


        @if (totalGoals == 0)
        {
            <!-- EMPTY STATE -->

            <div class="cg-empty">

                <div class="cg-empty-icon">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round"
                         aria-hidden="true">

                        <circle cx="12" cy="12" r="9"></circle>
                        <circle cx="12" cy="12" r="5"></circle>
                        <circle cx="12" cy="12" r="1"></circle>

                    </svg>

                </div>

                <h3 class="cg-empty-title">
                    Your fitness journey starts here
                </h3>

                <p class="cg-empty-text">
                    No goals have been created yet.
                    Use the form above to set your
                    first fitness target.
                </p>

            </div>
        }
        else
        {
            foreach (var goal in goals)
            {
                var measuredProgress = goal.CalculateProgress();

                var progress = Math.Max(
                    0m,
                    Math.Min(100m, measuredProgress));

                var progressText = progress.ToString(
                    "0.##",
                    CultureInfo.InvariantCulture);

                var currentValueText = goal.CurrentValue.HasValue
                    ? goal.CurrentValue.Value.ToString(
                        "0.##",
                        CultureInfo.InvariantCulture)
                    : "";

                <article class="cg-goal-card">

                    <!-- GOAL TITLE AND STATUS -->

                    <div class="cg-goal-header">

                        <div>

                            <h3 class="cg-goal-title">
                                @goal.Title
                            </h3>

                            <span class="cg-goal-type">
                                @goal.GoalType
                            </span>

                        </div>

                        @if (goal.IsCompleted)
                        {
                            <span class="cg-status cg-status-completed">
                                Completed
                            </span>
                        }
                        else
                        {
                            <span class="cg-status cg-status-active">
                                In Progress
                            </span>
                        }

                    </div>


                    <!-- DESCRIPTION -->

                    @if (!string.IsNullOrWhiteSpace(goal.Description))
                    {
                        <p class="cg-goal-description">
                            @goal.Description
                        </p>
                    }


                    <!-- MEASUREMENTS -->

                    <div class="cg-metrics-grid">

                        <div class="cg-metric">

                            <span class="cg-metric-label">
                                STARTING VALUE
                            </span>

                            <strong class="cg-metric-value">

                                @(goal.StartValue.HasValue
                                    ? goal.StartValue.Value.ToString("0.##")
                                    : "--")

                            </strong>

                        </div>


                        <div class="cg-metric">

                            <span class="cg-metric-label">
                                CURRENT VALUE
                            </span>

                            <strong class="cg-metric-value">

                                @(goal.CurrentValue.HasValue
                                    ? goal.CurrentValue.Value.ToString("0.##")
                                    : "--")

                            </strong>

                        </div>


                        <div class="cg-metric">

                            <span class="cg-metric-label">
                                TARGET VALUE
                            </span>

                            <strong class="cg-metric-value">

                                @(goal.TargetValue.HasValue
                                    ? goal.TargetValue.Value.ToString("0.##")
                                    : "--")

                            </strong>

                        </div>


                        <div class="cg-metric">

                            <span class="cg-metric-label">
                                TARGET DATE
                            </span>

                            <strong class="cg-metric-value cg-metric-value-small">

                                @(goal.TargetDate.HasValue
                                    ? goal.TargetDate.Value.ToString(
                                        "dd MMM yyyy")
                                    : "Not set")

                            </strong>

                        </div>

                    </div>


                    <!-- PROGRESS -->

                    <div class="cg-progress-header">

                        <span class="cg-progress-label">
                            Measured Progress
                        </span>

                        <strong class="cg-progress-percent">
                            @progressText%
                        </strong>

                    </div>

                    <progress class="cg-progress"
                              value="@progressText"
                              max="100"
                              aria-label="Measured fitness goal progress">

                        @progressText%

                    </progress>


                    @if (goal.IsCompleted)
                    {
                        <small class="cg-progress-note">
                            This goal was marked as completed.
                            Measured progress is preserved
                            separately from completion status.
                        </small>
                    }


                    <!-- UPDATE CONTROLS -->

                    @if (!goal.IsCompleted)
                    {
                        <div class="cg-goal-actions">

                            <!-- UPDATE PROGRESS -->

                            @using (Html.BeginForm(
                                "UpdateProgress",
                                "Goals",
                                new { area = "Client" },
                                FormMethod.Post,
                                new { @class = "cg-update-form" }))
                            {
                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="FitnessGoalId"
                                       value="@goal.FitnessGoalId" />

                                <div class="cg-update-field">

                                    <label for="cg-current-@goal.FitnessGoalId">
                                        Current Value
                                    </label>

                                    <input type="number"
                                           id="cg-current-@goal.FitnessGoalId"
                                           name="CurrentValue"
                                           class="cg-input"
                                           step="any"
                                           required="required"
                                           value="@currentValueText"
                                           aria-label="Update goal current value" />

                                </div>

                                <button type="submit"
                                        class="cg-btn cg-btn-primary">

                                    Update Progress

                                </button>
                            }


                            <!-- MARK COMPLETED -->

                            @using (Html.BeginForm(
                                "MarkCompleted",
                                "Goals",
                                new { area = "Client" },
                                FormMethod.Post,
                                new
                                {
                                    @class =
                                        "cg-complete-form js-confirm-goal"
                                }))
                            {
                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="fitnessGoalId"
                                       value="@goal.FitnessGoalId" />

                                <button type="submit"
                                        class="cg-btn cg-btn-outline">

                                    <svg viewBox="0 0 24 24"
                                         fill="none"
                                         stroke-width="2"
                                         stroke-linecap="round"
                                         stroke-linejoin="round"
                                         aria-hidden="true">

                                        <path d="M5 12l5 5L19 7"></path>

                                    </svg>

                                    Mark Completed

                                </button>
                            }

                        </div>
                    }

                </article>
            }
        }

    </section>

</div>


<!-- =====================================
     FLATPICKR DATE PICKER
     ===================================== -->

<script src="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.js"></script>

<script>
    (function () {
        "use strict";

        function initializeGoalsPage() {

            // =====================================
            // DARK DATE PICKER
            // =====================================

            var dateInput = document.querySelector(
                ".js-goal-datepicker"
            );

            if (
                dateInput &&
                typeof flatpickr === "function"
            ) {
                flatpickr(dateInput, {
                    dateFormat: "Y-m-d",
                    altInput: true,
                    altFormat: "F j, Y",
                    minDate: "today",
                    disableMobile: true,
                    allowInput: false
                });
            }

            // If Flatpickr is unavailable,
            // the native date input remains usable.


            // =====================================
            // CONFIRM GOAL COMPLETION
            // =====================================

            var completeForms =
                document.querySelectorAll(
                    ".js-confirm-goal"
                );

            for (
                var i = 0;
                i < completeForms.length;
                i++
            ) {
                completeForms[i].addEventListener(
                    "submit",
                    function (event) {

                        var confirmed = window.confirm(
                            "Mark this fitness goal as completed?\n\n" +
                            "You will not be able to update its " +
                            "progress from this page afterward."
                        );

                        if (!confirmed) {
                            event.preventDefault();
                        }
                    }
                );
            }
        }

        if (document.readyState === "loading") {
            document.addEventListener(
                "DOMContentLoaded",
                initializeGoalsPage
            );
        } else {
            initializeGoalsPage();
        }

    })();
</script>
