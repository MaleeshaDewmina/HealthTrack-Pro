
@model HealthTrackPro.Web.Areas.Client.Models.ClientGoalsViewModel
@using System
@using System.Linq
@using System.Globalization
@using System.Collections.Generic

@{
    ViewBag.Title = "Fitness Goals";

    // Get real goals from the ViewModel.
    var goals = Model != null && Model.Goals != null
        ? Model.Goals
        : new List<HealthTrackPro.Web.Models.Fitness.FitnessGoal>();

    var totalGoals = goals.Count;
    var activeGoals = goals.Count(g => !g.IsCompleted);
    var completedGoals = goals.Count(g => g.IsCompleted);

    // Measured progress is independent of
    // manually completed goal status.
    var averageProgress = totalGoals > 0
        ? Math.Round(
            goals.Average(g => g.CalculateProgress()), 1)
        : 0m;

    var dashboardUrl = Url.Action(
        "Index",
        "Dashboard",
        new { area = "Client" });
}

