
@model HealthTrackPro.Web.Areas.Client.Models.ClientAiChatViewModel

@{
    ViewBag.Title = "HealthTrack AI Coach";

    bool hasMessages = Model != null &&
        Model.Messages != null &&
        Model.Messages.Count > 0;
}

<style>
    /* =====================================
       HEALTHTRACK AI COACH
       Black + Emerald Green Chat Interface
       ===================================== */

    .htai {
        --htai-bg: #080B09;
        --htai-surface: #111A14;
        --htai-green: #22C55E;
        --htai-green-light: #4ADE80;
        --htai-border: #26372B;
        --htai-text: #F3F4F6;
        --htai-muted: #9CA3AF;
        width: 100%;
        max-width: 1100px;
        height: calc(100vh - 115px);
        min-height: 500px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        color: var(--htai-text);
        background: transparent;
        font-family: inherit;
    }

        .htai,
        .htai * {
            box-sizing: border-box;
        }

    /* =====================================
       HEADER
       ===================================== */

    .htai-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 16px 20px;
        border-bottom: 1px solid var(--htai-border);
        flex-shrink: 0;
    }

    .htai-brand {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 0;
    }

    .htai-brand-icon {
        width: 43px;
        height: 43px;
        min-width: 43px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #153B24;
        border: 1px solid #205E36;
        border-radius: 13px;
        color: var(--htai-green-light);
        font-size: 25px;
        font-weight: 700;
    }

    .htai-brand-title {
        margin: 0;
        font-size: 17px;
        font-weight: 700;
        color: var(--htai-text);
    }

    .htai-brand-subtitle {
        margin: 4px 0 0;
        color: var(--htai-muted);
        font-size: 12px;
    }

    .htai-new-chat {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        background: #0D130F;
        border: 1px solid #304535;
        border-radius: 11px;
        color: #F3F4F6;
        padding: 10px 16px;
        font-size: 13px;
        cursor: pointer;
        white-space: nowrap;
        transition: all 0.2s ease;
    }

        .htai-new-chat:hover {
            border-color: var(--htai-green);
            color: var(--htai-green-light);
            background: #152219;
        }

    /* =====================================
       SCROLLABLE CHAT AREA
       ===================================== */

    .htai-chat-area {
        flex: 1;
        min-height: 0;
        overflow-y: auto;
        overflow-x: hidden;
        padding: 20px;
        scrollbar-width: thin;
        scrollbar-color: #294330 transparent;
    }

        .htai-chat-area::-webkit-scrollbar {
            width: 6px;
        }

        .htai-chat-area::-webkit-scrollbar-thumb {
            background: #294330;
            border-radius: 10px;
        }

    /* =====================================
       EMPTY / WELCOME SCREEN
       ===================================== */

    .htai-welcome {
        min-height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 20px 15px 35px;
    }

    .htai-welcome-icon {
        width: 68px;
        height: 68px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #142B1D;
        color: var(--htai-green-light);
        border: 1px solid #28633C;
        border-radius: 23px;
        font-size: 33px;
        margin-bottom: 23px;
    }

    .htai-welcome h1 {
        margin: 0 0 12px;
        font-size: 30px;
        font-weight: 700;
        line-height: 1.3;
        color: #F3F4F6;
    }

    .htai-welcome-description {
        margin: 0 0 30px;
        font-size: 14px;
        line-height: 1.7;
        color: #9CA3AF;
    }

    /* =====================================
       SUGGESTED QUESTIONS
       ===================================== */

    .htai-suggestions {
        width: 100%;
        max-width: 630px;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
    }

    .htai-suggestion {
        display: flex;
        align-items: center;
        gap: 12px;
        width: 100%;
        min-height: 55px;
        padding: 15px 17px;
        background: #111A14;
        border: 1px solid #293B2E;
        border-radius: 14px;
        color: #E5E7EB;
        font-size: 13px;
        text-align: left;
        cursor: pointer;
        transition: all 0.2s ease;
    }

        .htai-suggestion:hover {
            border-color: var(--htai-green);
            background: #17261C;
            transform: translateY(-2px);
        }

    .htai-suggestion-icon {
        color: var(--htai-green-light);
        font-size: 16px;
        flex-shrink: 0;
    }

    /* =====================================
       CONVERSATION THREAD
       ===================================== */

    .htai-thread {
        width: 100%;
        max-width: 820px;
        margin: 0 auto;
        padding: 12px 0 35px;
    }

    .htai-message-row {
        display: flex;
        width: 100%;
        margin-bottom: 24px;
    }

        .htai-message-row.user {
            justify-content: flex-end;
        }

        .htai-message-row.assistant {
            justify-content: flex-start;
        }

    .htai-message-bubble {
        max-width: 82%;
        padding: 14px 19px;
        border-radius: 19px;
        font-size: 14px;
        line-height: 1.75;
        overflow-wrap: anywhere;
    }

    .htai-message-row.user .htai-message-bubble {
        background: #17472B;
        border: 1px solid #246B3F;
        border-bottom-right-radius: 6px;
        color: #F3F4F6;
    }

    .htai-message-row.assistant .htai-message-bubble {
        background: #131E16;
        border: 1px solid #2B3B2F;
        border-bottom-left-radius: 6px;
        color: #F3F4F6;
    }

    .htai-message-role {
        margin-bottom: 7px;
        color: var(--htai-green-light);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.5px;
    }

    .htai-message-row.user .htai-message-role {
        color: #D1FAE5;
    }

    .htai-message-content {
        margin: 0;
        white-space: pre-wrap;
    }

    /* =====================================
       BOTTOM CHAT COMPOSER
       ===================================== */

    .htai-bottom {
        flex-shrink: 0;
        width: 100%;
        padding: 15px 20px 17px;
        background: #080D09;
    }

    .htai-form {
        width: 100%;
        max-width: 820px;
        margin: 0 auto;
    }

    .htai-composer {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 46px;
        align-items: end;
        gap: 12px;
        width: 100%;
        min-height: 75px;
        padding: 13px 14px 13px 20px;
        background: #172019;
        border: 1px solid #344638;
        border-radius: 23px;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

        .htai-composer:focus-within {
            border-color: var(--htai-green);
            box-shadow: 0 0 0 2px rgba(34, 197, 94, 0.08);
        }

    /* Input fills the available space */

    .htai .htai-input,
    .htai .htai-input:focus {
        display: block;
        width: 100% !important;
        max-width: none !important;
        min-width: 0 !important;
        height: 46px;
        min-height: 46px;
        max-height: 160px;
        margin: 0;
        padding: 11px 0;
        resize: none;
        overflow-y: auto;
        background: transparent !important;
        color: #F3F4F6 !important;
        border: none !important;
        outline: none !important;
        box-shadow: none !important;
        font-family: inherit;
        font-size: 14px;
        line-height: 24px;
    }

        .htai .htai-input::placeholder {
            color: #8B988D;
            opacity: 1;
        }

    /* Green round Send button on far right */

    .htai-send {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 46px;
        height: 46px;
        margin: 0;
        padding: 0;
        background: #22C55E;
        color: #061108;
        border: none;
        border-radius: 50%;
        font-size: 25px;
        font-weight: 700;
        line-height: 1;
        cursor: pointer;
        transition: all 0.2s ease;
    }

        .htai-send:hover:not(:disabled) {
            background: #4ADE80;
            transform: scale(1.06);
        }

        .htai-send:disabled {
            background: #35523E;
            color: #91AC98;
            cursor: not-allowed;
        }

    .htai-hint {
        margin: 11px 0 0;
        text-align: center;
        color: #859388;
        font-size: 11px;
        line-height: 1.5;
    }

    .htai-validation {
        display: block;
        margin-top: 9px;
        color: #FCA5A5;
        font-size: 12px;
    }

    /* =====================================
       RESPONSIVE DESIGN
       ===================================== */

    @@media (max-width: 768px) {

        .htai {
            height: calc(100dvh - 105px);
            min-height: 440px;
        }

        .htai-header {
            padding: 13px 8px;
        }

        .htai-chat-area {
            padding: 15px 6px;
        }

        .htai-bottom {
            padding: 12px 3px 15px;
        }

        .htai-welcome h1 {
            font-size: 25px;
        }

        .htai-message-bubble {
            max-width: 92%;
        }
    }

    @@media (max-width: 520px) {

        .htai-suggestions {
            grid-template-columns: 1fr;
        }

        .htai-welcome {
            justify-content: flex-start;
            padding-top: 35px;
        }

        .htai-welcome-icon {
            width: 56px;
            height: 56px;
            font-size: 27px;
            margin-bottom: 15px;
        }

        .htai-welcome h1 {
            font-size: 22px;
        }

        .htai-welcome-description {
            margin-bottom: 20px;
            font-size: 12px;
        }

        .htai-brand-title {
            font-size: 14px;
        }

        .htai-brand-subtitle {
            font-size: 10px;
        }

        .htai-new-chat {
            padding: 9px 11px;
            font-size: 11px;
        }

        .htai-composer {
            grid-template-columns: minmax(0, 1fr) 42px;
            padding: 10px 11px 10px 15px;
            min-height: 63px;
        }

        .htai-send {
            width: 42px;
            height: 42px;
        }
    }
</style>


<div class="htai">

    <!-- CHAT HEADER -->

    <header class="htai-header">

        <div class="htai-brand">

            <div class="htai-brand-icon">
                ✦
            </div>

            <div>
                <h2 class="htai-brand-title">
                    HealthTrack AI Coach
                </h2>

                <p class="htai-brand-subtitle">
                    Fitness • Nutrition • Wellness
                </p>
            </div>

        </div>

        @using (Html.BeginForm(
            "Clear",
            "AiChat",
            new { area = "Client" },
            FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <button type="submit"
                    class="htai-new-chat">
                <span>＋</span>
                New Chat
            </button>
        }

    </header>


    <!-- CHAT CONTENT -->

    <main class="htai-chat-area"
          id="htaiChatArea"
          aria-label="Chat conversation">

        @if (!hasMessages)
        {
            <!-- WELCOME SCREEN -->

            <section class="htai-welcome">

                <div class="htai-welcome-icon">
                    ✦
                </div>

                <h1>
                    What can I help you with?
                </h1>

                <p class="htai-welcome-description">
                    Your personal fitness assistant.
                    <br />
                    Ask about workouts, nutrition,
                    and healthy habits.
                </p>

                <div class="htai-suggestions">

                    <button type="button"
                            class="htai-suggestion"
                            data-prompt="Create a beginner workout plan for me">

                        <span class="htai-suggestion-icon">
                            ✦
                        </span>

                        Create a workout plan

                    </button>

                    <button type="button"
                            class="htai-suggestion"
                            data-prompt="Suggest healthy high-protein meal ideas">

                        <span class="htai-suggestion-icon">
                            ✦
                        </span>

                        Healthy meal ideas

                    </button>

                    <button type="button"
                            class="htai-suggestion"
                            data-prompt="Help me set achievable fitness goals">

                        <span class="htai-suggestion-icon">
                            ✦
                        </span>

                        My fitness goals

                    </button>

                    <button type="button"
                            class="htai-suggestion"
                            data-prompt="Give me beginner gym advice">

                        <span class="htai-suggestion-icon">
                            ✦
                        </span>

                        Beginner gym advice

                    </button>

                </div>

            </section>
        }
        else
        {
            <!-- CONVERSATION MESSAGES -->

            <div class="htai-thread">

                @foreach (var message in Model.Messages)
                {
                    bool isUser = message.Role == "user";

                    string roleClass = isUser
                        ? "user"
                        : "assistant";

                    <div class="htai-message-row @roleClass">

                        <div class="htai-message-bubble">

                            <div class="htai-message-role">
                                @(isUser
                                    ? "YOU"
                                    : "AI CONNECTION STATUS")
                            </div>

                            <div class="htai-message-content">@message.Content</div>

                        </div>

                    </div>
                }

            </div>
        }

    </main>


    <!-- MESSAGE COMPOSER -->

    <footer class="htai-bottom">

        @using (Html.BeginForm(
            "Index",
            "AiChat",
            new { area = "Client" },
            FormMethod.Post,
            new
            {
                @class = "htai-form",
                id = "htaiForm"
            }))
        {
            @Html.AntiForgeryToken()

            <div class="htai-composer">

                @Html.TextAreaFor(
                    m => m.NewMessage,
                    new
                    {
                        @class = "htai-input",
                        id = "htaiInput",
                        placeholder = "Ask anything about fitness...",
                        maxlength = "1500",
                        rows = "2",
                        aria_label = "Your message"
                    })

                <button type="submit"
                        id="htaiSend"
                        class="htai-send"
                        title="Send message"
                        aria-label="Send message">
                    &#8593;
                </button>

            </div>

            @Html.ValidationMessageFor(
                m => m.NewMessage,
                "",
                new
                {
                    @class = "htai-validation"
                })
        }

        <p class="htai-hint">
            Demo mode — AI responses are not enabled yet.
        </p>

    </footer>

</div>


<!-- CHAT INTERACTIONS -->

<script>
    (function () {

        "use strict";

        var input = document.getElementById("htaiInput");

        var sendButton =
            document.getElementById("htaiSend");

        var form =
            document.getElementById("htaiForm");

        var chatArea =
            document.getElementById("htaiChatArea");

        if (!input || !sendButton || !form) {
            return;
        }

        /* Enable Send when text is entered */

        function updateSendButton() {
            sendButton.disabled =
                input.value.trim().length === 0;
        }

        /* Auto-expand input while typing */

        function resizeInput() {
            input.style.height = "46px";

            var newHeight = Math.min(
                input.scrollHeight,
                160
            );

            input.style.height = newHeight + "px";
        }

        input.addEventListener("input", function () {
            updateSendButton();
            resizeInput();
        });

        /* Enter sends, Shift + Enter adds a line */

        input.addEventListener("keydown", function (event) {

            if (event.key === "Enter" && !event.shiftKey &&
                !event.isComposing) {

                event.preventDefault();

                if (input.value.trim().length > 0) {
                    form.requestSubmit
                        ? form.requestSubmit(sendButton)
                        : sendButton.click();
                }
            }

        });

        /* Clicking a suggestion fills the composer */

        var suggestions =
            document.querySelectorAll(".htai-suggestion");

        for (var i = 0; i < suggestions.length; i++) {

            suggestions[i].addEventListener(
                "click",
                function () {

                    var prompt =
                        this.getAttribute("data-prompt");

                    input.value = prompt;

                    updateSendButton();
                    resizeInput();

                    input.focus();
                }
            );
        }

        /* Prevent empty or repeated submissions */

        var submitting = false;

        form.addEventListener("submit", function (event) {

            if (!input.value.trim() || submitting) {
                event.preventDefault();
                return;
            }

            submitting = true;
            sendButton.disabled = true;

        });

        /* Scroll to latest chat message */

        if (chatArea) {
            chatArea.scrollTop = chatArea.scrollHeight;
        }

        updateSendButton();
        resizeInput();

    })();
</script>
