
@model HealthTrackPro.Web.Areas.Client.Models.ClientAiChatViewModel

@{
    ViewBag.Title = "HealthTrack AI Coach";

    bool hasMessages =
        Model != null &&
        Model.Messages != null &&
        Model.Messages.Count > 0;

    bool aiEnabled =
        ViewBag.AiEnabled != null &&
        (bool)ViewBag.AiEnabled;
}

<style>
    /* ==========================================
       HEALTHTRACK AI COACH
       PREMIUM GREEN + BLACK THEME
       ========================================== */

    .htai {
        --htai-bg: #080B09;
        --htai-surface: #111A14;
        --htai-green: #22C55E;
        --htai-green-light: #4ADE80;
        --htai-border: #26372B;
        --htai-text: #F3F4F6;
        --htai-muted: #9CA3AF;
        width: 100%;
        max-width: 1100px;
        height: calc(100vh - 115px);
        min-height: 500px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        color: var(--htai-text);
        background: transparent;
        font-family: inherit;
    }

        .htai,
        .htai * {
            box-sizing: border-box;
        }

    .htai-icon {
        display: inline-block;
        width: 20px;
        height: 20px;
        fill: none;
        stroke: currentColor;
        stroke-width: 2px;
        stroke-linecap: round;
        stroke-linejoin: round;
        flex-shrink: 0;
    }

    /* ==========================================
       HEADER
       ========================================== */

    .htai-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 16px 20px;
        border-bottom: 1px solid var(--htai-border);
        flex-shrink: 0;
    }

    .htai-brand {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 0;
    }

    .htai-brand-icon {
        width: 43px;
        height: 43px;
        min-width: 43px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #153B24;
        border: 1px solid #205E36;
        border-radius: 13px;
        color: #4ADE80;
    }

    .htai-brand-title {
        margin: 0;
        font-size: 17px;
        font-weight: 800;
        color: #F3F4F6;
    }

    .htai-brand-subtitle {
        margin: 4px 0 0;
        color: #9CA3AF;
        font-size: 12px;
    }

    .htai-header-actions {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    /* AI SERVICE INDICATOR */

    .htai-connection {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 7px 11px;
        border-radius: 30px;
        font-size: 11px;
        font-weight: 700;
        white-space: nowrap;
        border: 1px solid;
    }

        .htai-connection.enabled {
            background: #142B1D;
            border-color: #28633C;
            color: #4ADE80;
        }

        .htai-connection.disabled {
            background: #292214;
            border-color: #5B4825;
            color: #FBBF24;
        }

    .htai-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: currentColor;
        flex-shrink: 0;
    }

    /* NEW CHAT BUTTON */

    .htai-new-chat {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        padding: 10px 16px;
        background: #0D130F;
        border: 1px solid #304535;
        border-radius: 11px;
        color: #F3F4F6;
        font-size: 12px;
        font-weight: 700;
        cursor: pointer;
        white-space: nowrap;
        transition: all 0.2s ease;
    }

        .htai-new-chat:hover {
            border-color: #22C55E;
            color: #4ADE80;
            background: #152219;
        }

    /* ==========================================
       CHAT AREA
       ========================================== */

    .htai-chat-area {
        flex: 1;
        min-height: 0;
        overflow-y: auto;
        overflow-x: hidden;
        padding: 20px;
        scrollbar-width: thin;
        scrollbar-color: #294330 transparent;
    }

        .htai-chat-area::-webkit-scrollbar {
            width: 6px;
        }

        .htai-chat-area::-webkit-scrollbar-thumb {
            background: #294330;
            border-radius: 10px;
        }

    /* ==========================================
       WELCOME SCREEN
       ========================================== */

    .htai-welcome {
        min-height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 20px 15px 35px;
    }

    .htai-welcome-icon {
        width: 68px;
        height: 68px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #142B1D;
        border: 1px solid #28633C;
        border-radius: 23px;
        color: #4ADE80;
        margin-bottom: 23px;
    }

        .htai-welcome-icon .htai-icon {
            width: 33px;
            height: 33px;
        }

    .htai-welcome h1 {
        margin: 0 0 12px;
        font-size: 30px;
        font-weight: 800;
        line-height: 1.3;
        color: #F3F4F6;
    }

    .htai-welcome-description {
        margin: 0 0 30px;
        font-size: 14px;
        line-height: 1.7;
        color: #9CA3AF;
    }

    /* ==========================================
       SUGGESTED QUESTIONS
       ========================================== */

    .htai-suggestions {
        width: 100%;
        max-width: 630px;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
    }

    .htai-suggestion {
        display: flex;
        align-items: center;
        gap: 12px;
        width: 100%;
        min-height: 55px;
        padding: 15px 17px;
        background: #111A14;
        border: 1px solid #293B2E;
        border-radius: 14px;
        color: #E5E7EB;
        font-size: 13px;
        text-align: left;
        cursor: pointer;
        transition: all 0.2s ease;
    }

        .htai-suggestion:hover {
            border-color: #22C55E;
            background: #17261C;
            transform: translateY(-2px);
        }

    .htai-suggestion-icon {
        color: #4ADE80;
        display: flex;
        align-items: center;
        flex-shrink: 0;
    }

    /* ==========================================
       CONVERSATION THREAD
       ========================================== */

    .htai-thread {
        width: 100%;
        max-width: 820px;
        margin: 0 auto;
        padding: 12px 0 35px;
    }

    .htai-message-row {
        display: flex;
        width: 100%;
        margin-bottom: 24px;
    }

        .htai-message-row.user {
            justify-content: flex-end;
        }

        .htai-message-row.assistant {
            justify-content: flex-start;
        }

    .htai-message-bubble {
        max-width: 82%;
        padding: 14px 19px;
        border-radius: 19px;
        font-size: 14px;
        line-height: 1.75;
        overflow-wrap: anywhere;
    }

    /* USER MESSAGE */

    .htai-message-row.user .htai-message-bubble {
        background: #17472B;
        border: 1px solid #246B3F;
        border-bottom-right-radius: 6px;
        color: #F3F4F6;
    }

    /* REAL AI RESPONSE */

    .htai-message-row.assistant .htai-message-bubble {
        background: #131E16;
        border: 1px solid #2B3B2F;
        border-bottom-left-radius: 6px;
        color: #F3F4F6;
    }

    .htai-message-role {
        margin-bottom: 7px;
        color: #4ADE80;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 0.5px;
    }

    .htai-message-row.user .htai-message-role {
        color: #D1FAE5;
    }

    .htai-message-content {
        margin: 0;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
    }

    /* CONNECTION ERRORS */

    .htai-message-row.status {
        justify-content: center;
    }

        .htai-message-row.status .htai-message-bubble {
            max-width: 90%;
            background: #201C11;
            border: 1px solid #665024;
            border-radius: 14px;
            color: #FCD34D;
        }

        .htai-message-row.status .htai-message-role {
            color: #FBBF24;
        }

    /* ==========================================
       MESSAGE COMPOSER
       ========================================== */

    .htai-bottom {
        flex-shrink: 0;
        width: 100%;
        padding: 15px 20px 17px;
        background: #080D09;
        border-top: 1px solid #1F2A22;
    }

    .htai-form {
        width: 100%;
        max-width: 820px;
        margin: 0 auto;
    }

    .htai-composer {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 46px;
        align-items: end;
        gap: 12px;
        width: 100%;
        min-height: 75px;
        padding: 13px 14px 13px 20px;
        background: #172019;
        border: 1px solid #344638;
        border-radius: 23px;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

        .htai-composer:focus-within {
            border-color: #22C55E;
            box-shadow: 0 0 0 2px rgba(34, 197, 94, 0.08);
        }

    .htai .htai-input,
    .htai .htai-input:focus {
        display: block;
        width: 100% !important;
        max-width: none !important;
        min-width: 0 !important;
        height: 46px;
        min-height: 46px;
        max-height: 160px;
        margin: 0;
        padding: 11px 0;
        resize: none;
        overflow-y: auto;
        background: transparent !important;
        color: #F3F4F6 !important;
        border: none !important;
        outline: none !important;
        box-shadow: none !important;
        font-family: inherit;
        font-size: 14px;
        line-height: 24px;
    }

        .htai .htai-input::placeholder {
            color: #8B988D;
            opacity: 1;
        }

    /* SEND BUTTON */

    .htai-send {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 46px;
        height: 46px;
        margin: 0;
        padding: 0;
        background: #22C55E;
        color: #061108;
        border: none;
        border-radius: 50%;
        cursor: pointer;
        transition: all 0.2s ease;
    }

        .htai-send:hover:not(:disabled) {
            background: #4ADE80;
            transform: scale(1.06);
        }

        .htai-send:disabled {
            background: #35523E;
            color: #91AC98;
            cursor: not-allowed;
        }

    /* INFORMATION */

    .htai-hint {
        margin: 11px 0 0;
        text-align: center;
        color: #859388;
        font-size: 11px;
        line-height: 1.6;
    }

    .htai-validation {
        display: block;
        margin-top: 9px;
        color: #FCA5A5;
        font-size: 12px;
    }

    .htai-validation-summary {
        margin-bottom: 8px;
        color: #FCA5A5;
        font-size: 12px;
    }

        .htai-validation-summary ul {
            margin: 0;
            padding-left: 18px;
        }

    /* ==========================================
       RESPONSIVE DESIGN
       ========================================== */

    @@media (max-width: 768px) {

        .htai {
            height: calc(100dvh - 105px);
            min-height: 440px;
        }

        .htai-header {
            padding: 13px 8px;
        }

        .htai-chat-area {
            padding: 15px 6px;
        }

        .htai-bottom {
            padding: 12px 3px 15px;
        }

        .htai-welcome h1 {
            font-size: 25px;
        }

        .htai-message-bubble {
            max-width: 92%;
        }

        .htai-connection {
            font-size: 10px;
        }
    }

    @@media (max-width: 520px) {

        .htai-suggestions {
            grid-template-columns: 1fr;
        }

        .htai-welcome {
            justify-content: flex-start;
            padding-top: 35px;
        }

        .htai-welcome-icon {
            width: 56px;
            height: 56px;
            margin-bottom: 15px;
        }

        .htai-welcome h1 {
            font-size: 22px;
        }

        .htai-welcome-description {
            margin-bottom: 20px;
            font-size: 12px;
        }

        .htai-brand-title {
            font-size: 14px;
        }

        .htai-brand-subtitle {
            font-size: 10px;
        }

        .htai-header {
            gap: 8px;
        }

        .htai-header-actions {
            gap: 7px;
        }

        .htai-new-chat {
            padding: 9px 11px;
            font-size: 11px;
        }

        .htai-connection {
            padding: 6px 8px;
        }

        .htai-composer {
            grid-template-columns: minmax(0, 1fr) 42px;
            padding: 10px 11px 10px 15px;
            min-height: 63px;
        }

        .htai-send {
            width: 42px;
            height: 42px;
        }
    }

    @@media (max-width: 390px) {

        .htai-brand-subtitle {
            display: none;
        }

        .htai-connection {
            display: none;
        }
    }
    .htai-workspace {
        display: flex;
        flex: 1;
        min-height: 0;
        overflow: hidden;
    }

    .htai-history-sidebar {
        width: 250px;
        min-width: 250px;
        padding: 15px 10px;
        background: #0D130F;
        border-right: 1px solid #26372B;
        overflow-y: auto;
    }

    .htai-history-title {
        color: #9CA3AF;
        font-size: 12px;
        font-weight: 800;
        padding: 0 8px;
        margin: 0 0 14px;
        text-transform: uppercase;
    }

    .htai-history-item {
        display: flex;
        align-items: center;
        gap: 5px;
        padding: 5px;
        margin-bottom: 7px;
        background: #111A14;
        border: 1px solid transparent;
        border-radius: 11px;
    }

    .htai-history-item.active {
        background: #183522;
        border-color: #28633C;
    }

    .htai-history-link {
        flex: 1;
        min-width: 0;
        padding: 9px 7px;
        color: #D1D5DB;
        font-size: 12px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        text-decoration: none;
    }

    .htai-history-link:hover {
        color: #4ADE80;
    }

    .htai-history-delete {
        padding: 6px;
        background: transparent;
        border: none;
        color: #9CA3AF;
        cursor: pointer;
    }

    .htai-history-delete:hover {
        color: #FCA5A5;
    }

    .htai-history-empty {
        padding: 10px;
        color: #9CA3AF;
        font-size: 12px;
    }

    .htai-chat-main {
        display: flex;
        flex: 1;
        min-width: 0;
        min-height: 0;
        flex-direction: column;
    }

    @@media (max-width: 768px) {
        .htai-history-sidebar {
            width: 175px;
            min-width: 175px;
        }
    }

    @@media (max-width: 520px) {
        .htai-workspace {
            flex-direction: column;
        }

        .htai-history-sidebar {
            width: 100%;
            min-width: 0;
            max-height: 135px;
            border-right: none;
            border-bottom: 1px solid #26372B;
        }
    }
</style>

<div class="htai">

    <!-- CHAT HEADER -->

    <header class="htai-header">

        <div class="htai-brand">

            <div class="htai-brand-icon">
                <svg class="htai-icon"
                     viewBox="0 0 24 24"
                     aria-hidden="true">
                    <path d="M12 3a6 6 0 0 0-6 6v2a4 4 0 0 0 0 8h1"></path>
                    <path d="M12 3a6 6 0 0 1 6 6v2a4 4 0 0 1 0 8h-1"></path>
                    <path d="M12 3v18"></path>
                    <path d="M8 10l4 2 4-2"></path>
                    <path d="M8 16l4-2 4 2"></path>
                </svg>
            </div>

            <div>
                <h2 class="htai-brand-title">
                    HealthTrack AI Coach
                </h2>

                <p class="htai-brand-subtitle">
                    Fitness &bull; Nutrition &bull; Wellness
                </p>
            </div>

        </div>

        <div class="htai-header-actions">

            @if (aiEnabled)
            {
                <span class="htai-connection enabled"
                      title="Groq API key configured; live connection available when the service responds">
                    <span class="htai-dot"></span>
                    AI Configured
                </span>
            }
            else
            {
                <span class="htai-connection disabled"
                      title="AI service is not configured">
                    <span class="htai-dot"></span>
                    AI Unavailable
                </span>
            }

            @using (Html.BeginForm(
                "NewChat",
                "AiChat",
                new { area = "Client" },
                FormMethod.Get))
            {

                <button type="submit"
                        class="htai-new-chat">

                    <svg class="htai-icon"
                         viewBox="0 0 24 24"
                         aria-hidden="true"
                         style="width:15px;height:15px;">
                        <path d="M12 5v14M5 12h14"></path>
                    </svg>

                    New Chat
                </button>
            }

        </div>

    </header>

        <div class="htai-workspace">

        <aside class="htai-history-sidebar"
               aria-label="Saved conversations">

            <h3 class="htai-history-title">Your Chats</h3>

            @if (Model.Conversations != null && Model.Conversations.Count > 0)
            {
                foreach (var conversation in Model.Conversations)
                {
                    bool active = Model.ConversationId == conversation.ConversationId;

                    <div class="htai-history-item @(active ? "active" : "")">

                        <a class="htai-history-link"
                           href="@Url.Action("Open", "AiChat", new { area = "Client", id = conversation.ConversationId })"
                           title="@conversation.Title">
                            @conversation.Title
                        </a>

                        @using (Html.BeginForm(
                            "Delete",
                            "AiChat",
                            new { area = "Client", id = conversation.ConversationId },
                            FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="htai-history-delete"
                                    title="Delete conversation"
                                    onclick="return confirm('Delete this conversation permanently?');">

                                <svg class="htai-icon"
                                     viewBox="0 0 24 24"
                                     aria-hidden="true"
                                     style="width:15px;height:15px;">
                                    <path d="M3 6h18"></path>
                                    <path d="M8 6V4h8v2"></path>
                                    <path d="M6 6l1 15h10l1-15"></path>
                                    <path d="M10 10v7M14 10v7"></path>
                                </svg>
                            </button>
                        }
                    </div>
                }
            }
            else
            {
                <p class="htai-history-empty">
                    No saved conversations yet.
                </p>
            }

        </aside>

        <div class="htai-chat-main">

    <!-- CHAT CONVERSATION AREA -->

    <main class="htai-chat-area"
          id="htaiChatArea"
          aria-label="Chat conversation"
          aria-live="polite">

        @if (!hasMessages)
        {
            <section class="htai-welcome">

                <div class="htai-welcome-icon">

                    <svg class="htai-icon"
                         viewBox="0 0 24 24"
                         aria-hidden="true">
                        <path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9L12 3z"></path>
                        <path d="M19 16l.8 2.2L22 19l-2.2.8L19 22l-.8-2.2L16 19l2.2-.8L19 16z"></path>
                    </svg>

                </div>

                <h1>What can I help you with?</h1>

                <p class="htai-welcome-description">
                    Your personal fitness assistant.
                    <br />
                    Ask about workouts, nutrition,
                    and healthy habits.
                </p>

                <div class="htai-suggestions">

                    <!-- WORKOUT PLAN -->

                    <button type="button"
                            class="htai-suggestion"
                            data-prompt="Create a beginner workout plan for me">

                        <span class="htai-suggestion-icon">
                            <svg class="htai-icon"
                                 viewBox="0 0 24 24"
                                 aria-hidden="true">
                                <path d="M6 7v10M18 7v10M3 9v6M21 9v6M6 12h12"></path>
                            </svg>
                        </span>

                        Create a workout plan
                    </button>

                    <!-- MEAL IDEAS -->

                    <button type="button"
                            class="htai-suggestion"
                            data-prompt="Suggest healthy high-protein meal ideas">

                        <span class="htai-suggestion-icon">
                            <svg class="htai-icon"
                                 viewBox="0 0 24 24"
                                 aria-hidden="true">
                                <path d="M4 13a8 8 0 0 0 16 0"></path>
                                <path d="M3 13h18M9 5v4M13 3v6M17 5v4"></path>
                            </svg>
                        </span>

                        Healthy meal ideas
                    </button>

                    <!-- FITNESS GOALS -->

                    <button type="button"
                            class="htai-suggestion"
                            data-prompt="Help me set achievable fitness goals">

                        <span class="htai-suggestion-icon">
                            <svg class="htai-icon"
                                 viewBox="0 0 24 24"
                                 aria-hidden="true">
                                <circle cx="12" cy="12" r="9"></circle>
                                <circle cx="12" cy="12" r="5"></circle>
                                <circle cx="12" cy="12" r="1"></circle>
                            </svg>
                        </span>

                        My fitness goals
                    </button>

                    <!-- BEGINNER ADVICE -->

                    <button type="button"
                            class="htai-suggestion"
                            data-prompt="Give me beginner gym advice">

                        <span class="htai-suggestion-icon">
                            <svg class="htai-icon"
                                 viewBox="0 0 24 24"
                                 aria-hidden="true">
                                <path d="M9 18h6M10 22h4"></path>
                                <path d="M8 14a6 6 0 1 1 8 0c-1 1-1 2-1 4H9c0-2 0-3-1-4z"></path>
                            </svg>
                        </span>

                        Beginner gym advice
                    </button>

                </div>

            </section>
        }
        else
        {
            <!-- CONVERSATION THREAD -->

            <div class="htai-thread">

                @foreach (var message in Model.Messages)
                {
                    if (message == null)
                    {
                        continue;
                    }

                    bool isUser = message.Role == "user";

                    bool isStatus =
                        message.Role == "status" ||
                        message.Role == "system";

                    string roleClass = isUser
                        ? "user"
                        : isStatus
                            ? "status"
                            : "assistant";

                    string roleLabel = isUser
                        ? "YOU"
                        : isStatus
                            ? "CONNECTION STATUS"
                            : "HEALTHTRACK AI COACH";

                    <div class="htai-message-row @roleClass">

                        <div class="htai-message-bubble">

                            <div class="htai-message-role">
                                @roleLabel
                            </div>

                            <div class="htai-message-content">@message.Content</div>

                        </div>

                    </div>
                }

            </div>
        }

    </main>

    <!-- MESSAGE COMPOSER -->

    <footer class="htai-bottom">

        @using (Html.BeginForm(
            "Index",
            "AiChat",
            new { area = "Client" },
            FormMethod.Post,
            new
            {
                @class = "htai-form",
                id = "htaiForm"
            }))
        {
            @Html.AntiForgeryToken()

            @Html.HiddenFor(m => m.ConversationId)

            @Html.ValidationSummary(
                true,
                "",
                new { @class = "htai-validation-summary" })

            <div class="htai-composer">

                @Html.TextAreaFor(
                    m => m.NewMessage,
                    new
                    {
                        @class = "htai-input",
                        id = "htaiInput",
                        placeholder = "Ask anything about fitness...",
                        maxlength = "1500",
                        rows = "2",
                        aria_label = "Your message"
                    })

                <button type="submit"
                        id="htaiSend"
                        class="htai-send"
                        title="Send message"
                        aria-label="Send message">

                    <svg class="htai-icon"
                         viewBox="0 0 24 24"
                         aria-hidden="true">
                        <path d="M12 19V5"></path>
                        <path d="M5 12l7-7 7 7"></path>
                    </svg>

                </button>

            </div>

            @Html.ValidationMessageFor(
                m => m.NewMessage,
                "",
                new { @class = "htai-validation" })
        }

        <p class="htai-hint">

            @if (aiEnabled)
            {
                <text>
                    Powered by Groq AI when available.
                    Responses may contain mistakes.
                    General fitness guidance only, not medical advice.
                    Avoid sharing sensitive personal information.
                </text>
            }
            else
            {
                <text>
                    AI Coach is currently unavailable.
                    Live responses require server-side API configuration.
                </text>
            }

        </p>

    </footer>


        </div>
    </div>

</div>

<!-- ==========================================
     CHAT INTERACTIONS
     ========================================== -->

<script>
    (function () {

        "use strict";

        var input =
            document.getElementById("htaiInput");

        var sendButton =
            document.getElementById("htaiSend");

        var form =
            document.getElementById("htaiForm");

        var chatArea =
            document.getElementById("htaiChatArea");

        if (!input || !sendButton || !form) {
            return;
        }

        /* ENABLE OR DISABLE SEND */

        function updateSendButton() {
            sendButton.disabled =
                input.value.trim().length === 0;
        }

        /* AUTOMATIC TEXTAREA HEIGHT */

        function resizeInput() {

            input.style.height = "46px";

            var newHeight = Math.min(
                input.scrollHeight,
                160
            );

            input.style.height = newHeight + "px";
        }

        input.addEventListener("input", function () {
            updateSendButton();
            resizeInput();
        });

        /* ENTER SENDS, SHIFT + ENTER NEW LINE */

        input.addEventListener("keydown", function (event) {

            if (event.key === "Enter" &&
                !event.shiftKey &&
                !event.isComposing) {

                event.preventDefault();

                if (input.value.trim().length > 0) {

                    if (form.requestSubmit) {
                        form.requestSubmit(sendButton);
                    }
                    else {
                        sendButton.click();
                    }
                }
            }
        });

        /* SUGGESTED QUESTIONS */

        var suggestions =
            document.querySelectorAll(".htai-suggestion");

        for (var i = 0; i < suggestions.length; i++) {

            suggestions[i].addEventListener(
                "click",
                function () {

                    var prompt =
                        this.getAttribute("data-prompt");

                    input.value = prompt;

                    updateSendButton();
                    resizeInput();

                    input.focus();
                }
            );
        }

        /* PREVENT EMPTY OR REPEATED SUBMISSIONS */

        var submitting = false;

        form.addEventListener("submit", function (event) {

            if (!input.value.trim() || submitting) {
                event.preventDefault();
                return;
            }

            submitting = true;
            sendButton.disabled = true;
        });

        /* SCROLL TO LATEST MESSAGE */

        if (chatArea) {
            chatArea.scrollTop = chatArea.scrollHeight;
        }

        updateSendButton();
        resizeInput();

    })();
</script>
