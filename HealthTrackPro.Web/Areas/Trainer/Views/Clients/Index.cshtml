@model HealthTrackPro.Web.Areas.Trainer.Models.TrainerClientListViewModel

@{
    ViewBag.Title = "Assigned Clients";
}

<div class="ht-card">

    <h2 class="ht-card-title">Assigned Clients</h2>

    <p>Only clients assigned to you are listed here.</p>

    @if (Model.Clients.Count == 0)
    {
        <p class="text-muted" style="margin-top:16px;">
            No assigned Clients found.
        </p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Client</th>
                        <th>Primary goal</th>
                        <th>Current weight</th>
                        <th>BMI</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var client in Model.Clients)
                    {
                        <tr>
                            <td>@client.FullName</td>
                            <td>@client.PrimaryGoal</td>
                            <td>
                                @(client.CurrentWeightKg.HasValue
                                    ? client.CurrentWeightKg.Value.ToString("0.0") + " kg"
                                    : "--")
                            </td>
                            <td>
                                @(client.Bmi.HasValue
                                    ? client.Bmi.Value.ToString("0.0")
                                    : "--")
                            </td>
                            <td>
                                <span class="ht-status ht-status-success">@client.AssignmentStatus</span>
                            </td>
                            <td>
                                <a class="btn btn-default"
                                   href="@Url.Action("Details", "Clients", new { area = "Trainer", id = client.ClientUserId })">
                                    View Client
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

</div>
