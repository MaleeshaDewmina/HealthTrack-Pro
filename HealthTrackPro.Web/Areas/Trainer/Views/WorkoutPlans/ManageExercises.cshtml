@model HealthTrackPro.Web.Areas.Trainer.Models.WorkoutExerciseManageViewModel

@{
    ViewBag.Title = "Manage Workout Exercises";
}

<style>
    .hte-page {
        max-width: 1450px;
        margin: 0 auto;
    }

    .hte-hero {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
        margin-bottom: 22px;
    }

    .hte-hero h2 {
        margin: 0 0 5px;
        color: #F3F7F4;
        font-size: 27px;
        font-weight: 900;
    }

    .hte-hero p {
        margin: 0;
        color: #7D8A81;
        font-size: 12px;
    }

    .hte-back {
        display: inline-flex;
        min-height: 42px;
        align-items: center;
        padding: 0 15px;
        border: 1px solid var(--ht-role-tone-26342b);
        border-radius: 9px;
        background: var(--ht-role-tone-101612);
        color: #C7D0CA !important;
        font-size: 11px;
        font-weight: 800;
        text-decoration: none !important;
    }

    .hte-summary {
        display: grid;
        grid-template-columns:
            repeat(3,minmax(0,1fr));
        gap: 13px;
        margin-bottom: 18px;
    }

    .hte-stat,
    .hte-card {
        border: 1px solid var(--ht-role-tone-1f2a22);
        border-radius: 14px;
        background: var(--ht-role-tone-101612);
    }

    .hte-stat {
        padding: 16px;
    }

    .hte-label {
        display: block;
        margin-bottom: 7px;
        color: #69766E;
        font-size: 9px;
        font-weight: 900;
        letter-spacing: .7px;
        text-transform: uppercase;
    }

    .hte-value {
        color: #EFF4F0;
        font-size: 17px;
        font-weight: 900;
    }

    .hte-grid {
        display: grid;
        grid-template-columns:
            minmax(340px,.72fr)
            minmax(0,1.28fr);
        gap: 18px;
        align-items: start;
    }

    .hte-card-header {
        padding: 18px 20px;
        border-bottom: 1px solid var(--ht-role-tone-1b251e);
    }

    .hte-card-header h3 {
        margin: 0 0 4px;
        color: #EDF3EE;
        font-size: 15px;
        font-weight: 900;
    }

    .hte-card-header p {
        margin: 0;
        color: #748078;
        font-size: 10px;
    }

    .hte-body {
        padding: 20px;
    }

    .hte-field {
        margin-bottom: 15px;
    }

    .hte-field label {
        display: block;
        margin-bottom: 6px;
        color: #D5DED7;
        font-size: 10px;
        font-weight: 900;
    }

    .hte-page .form-control {
        width: 100%;
        max-width: none;
        min-height: 44px;
        border: 1px solid var(--ht-role-tone-27342b);
        border-radius: 9px;
        background: var(--ht-role-tone-0c120e);
        color: #F0F5F1;
        box-shadow: none;
    }

    .hte-page .form-control:focus {
        border-color: #22C55E;
        background: var(--ht-role-tone-0c120e);
        box-shadow:
            0 0 0 3px rgba(34,197,94,.10);
    }

    .hte-row {
        display: grid;
        grid-template-columns:
            repeat(2,minmax(0,1fr));
        gap: 10px;
    }

    .hte-submit {
        width: 100%;
        min-height: 46px;
        border: 0;
        border-radius: 9px;
        background:
            linear-gradient(
                135deg,
                #22C55E,
                #16A34A);
        color: #061009;
        font-size: 11px;
        font-weight: 900;
    }

    .hte-alert {
        margin-bottom: 16px;
        padding: 12px 14px;
        border-radius: 9px;
        font-size: 11px;
        font-weight: 700;
    }

    .hte-success {
        border:
            1px solid rgba(34,197,94,.24);
        background:
            rgba(34,197,94,.08);
        color: #86EFAC;
    }

    .hte-error {
        border:
            1px solid rgba(239,68,68,.24);
        background:
            rgba(239,68,68,.08);
        color: #FCA5A5;
    }

    .hte-validation {
        display: block;
        margin-top: 5px;
        color: #F87171;
        font-size: 9px;
    }

    .hte-list {
        display: grid;
        gap: 10px;
    }

    .hte-exercise {
        display: grid;
        grid-template-columns:
            minmax(0,1fr) auto;
        gap: 14px;
        padding: 15px;
        border: 1px solid var(--ht-role-tone-202c24);
        border-radius: 11px;
        background: var(--ht-role-tone-0d130f);
    }

    .hte-exercise h4 {
        margin: 0 0 5px;
        color: #EEF4EF;
        font-size: 13px;
        font-weight: 900;
    }

    .hte-muscle {
        margin-bottom: 10px;
        color: #4ADE80;
        font-size: 9px;
        font-weight: 800;
    }

    .hte-metrics {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
    }

    .hte-chip {
        padding: 5px 8px;
        border: 1px solid var(--ht-role-tone-26342b);
        border-radius: 999px;
        color: #AAB5AD;
        font-size: 8px;
        font-weight: 800;
    }

    .hte-notes {
        margin: 9px 0 0;
        color: #7C8980;
        font-size: 9px;
        line-height: 1.5;
    }

    .hte-remove {
        min-height: 34px;
        padding: 0 10px;
        border:
            1px solid rgba(239,68,68,.25);
        border-radius: 8px;
        background:
            rgba(239,68,68,.06);
        color: #FCA5A5;
        font-size: 9px;
        font-weight: 900;
    }

    .hte-empty {
        padding: 45px 20px;
        border: 1px dashed var(--ht-role-tone-29362d);
        border-radius: 11px;
        color: #758279;
        text-align: center;
        font-size: 11px;
    }

    @@media (max-width: 950px) {
        .hte-grid,
        .hte-summary {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 600px) {
        .hte-hero {
            flex-direction: column;
        }

        .hte-row {
            grid-template-columns: 1fr;
        }

        .hte-exercise {
            grid-template-columns: 1fr;
        }
    }
</style>


<div class="hte-page">

    <div class="hte-hero">

        <div>
            <h2>Manage Exercises</h2>

            <p>
                Build the exercise sequence for
                <strong>@Model.PlanName</strong>.
            </p>
        </div>

        <a class="hte-back"
           href="@Url.Action(
               "Index",
               "WorkoutPlans",
               new { area = "Trainer" })">
            &larr; Back to workout plans
        </a>

    </div>


    @if (TempData["SuccessMessage"] != null)
    {
        <div class="hte-alert hte-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="hte-alert hte-error">
            @TempData["ErrorMessage"]
        </div>
    }


    <div class="hte-summary">

        <div class="hte-stat">
            <span class="hte-label">
                Client
            </span>

            <span class="hte-value">
                @Model.ClientName
            </span>
        </div>

        <div class="hte-stat">
            <span class="hte-label">
                Exercises
            </span>

            <span class="hte-value">
                @Model.Exercises.Count
            </span>
        </div>

        <div class="hte-stat">
            <span class="hte-label">
                Plan status
            </span>

            <span class="hte-value">
                @(Model.IsActive
                    ? "Active"
                    : "Inactive")
            </span>
        </div>

    </div>


    <div class="hte-grid">

        <section class="hte-card">

            <div class="hte-card-header">
                <h3>Add exercise</h3>

                <p>
                    Choose an exercise and configure
                    its workout targets.
                </p>
            </div>


            <div class="hte-body">

                @using (Html.BeginForm(
                    "AddExercise",
                    "WorkoutPlans",
                    new { area = "Trainer" },
                    FormMethod.Post,
                    null))
                {
                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="WorkoutPlanId"
                           value="@Model.WorkoutPlanId" />


                    <div class="hte-field">

                        <label>Exercise</label>

                        @Html.DropDownList(
                            "ExerciseId",
                            Model.ExerciseOptions,
                            "Choose an exercise",
                            new
                            {
                                @class = "form-control"
                            })

                        @Html.ValidationMessage(
                            "ExerciseId",
                            "",
                            new
                            {
                                @class =
                                    "hte-validation"
                            })

                    </div>


                    <div class="hte-row">

                        <div class="hte-field">

                            <label>Sets</label>

                            <input
                                class="form-control"
                                type="number"
                                name="Sets"
                                min="1"
                                max="20"
                                value="@Model.Form.Sets" />

                        </div>


                        <div class="hte-field">

                            <label>Repetitions</label>

                            <input
                                class="form-control"
                                type="number"
                                name="Repetitions"
                                min="1"
                                max="100"
                                value="@Model.Form.Repetitions" />

                        </div>

                    </div>


                    <div class="hte-row">

                        <div class="hte-field">

                            <label>Rest seconds</label>

                            <input
                                class="form-control"
                                type="number"
                                name="RestSeconds"
                                min="0"
                                max="300"
                                value="@Model.Form.RestSeconds" />

                        </div>


                        <div class="hte-field">

                            <label>Duration minutes</label>

                            <input
                                class="form-control"
                                type="number"
                                name="DurationMinutes"
                                min="0"
                                max="300"
                                value="@Model.Form.DurationMinutes" />

                        </div>

                    </div>


                    <div class="hte-field">

                        <label>Display order</label>

                        <input
                            class="form-control"
                            type="number"
                            name="DisplayOrder"
                            min="1"
                            max="100"
                            value="@Model.Form.DisplayOrder" />

                    </div>


                    <div class="hte-field">

                        <label>Trainer notes</label>

                        <textarea
                            class="form-control"
                            name="Notes"
                            maxlength="500"
                            rows="4"
                            placeholder="Optional instructions...">@Model.Form.Notes</textarea>

                    </div>


                    <button
                        class="hte-submit"
                        type="submit">
                        + Add exercise to plan
                    </button>
                }

            </div>

        </section>


        <section class="hte-card">

            <div class="hte-card-header">

                <h3>Plan exercise sequence</h3>

                <p>
                    These exercises are visible
                    to the assigned client.
                </p>

            </div>


            <div class="hte-body">

                @if (Model.Exercises.Count == 0)
                {
                    <div class="hte-empty">

                        No exercises have been added yet.
                        Use the form to build this
                        workout plan.

                    </div>
                }
                else
                {
                    <div class="hte-list">

                        @foreach (
                            var exercise
                            in Model.Exercises)
                        {
                            <article class="hte-exercise">

                                <div>

                                    <h4>
                                        @exercise.DisplayOrder.
                                        @exercise.ExerciseName
                                    </h4>

                                    <div class="hte-muscle">

                                        @(string.IsNullOrWhiteSpace(
                                            exercise.MuscleGroup)
                                            ? "General exercise"
                                            : exercise.MuscleGroup)

                                    </div>


                                    <div class="hte-metrics">

                                        <span class="hte-chip">
                                            @exercise.Sets sets
                                        </span>

                                        <span class="hte-chip">
                                            @exercise.Repetitions reps
                                        </span>

                                        <span class="hte-chip">
                                            @exercise.RestSeconds sec rest
                                        </span>

                                        @if (
                                            exercise
                                                .DurationMinutes
                                                .HasValue)
                                        {
                                            <span class="hte-chip">
                                                @exercise.DurationMinutes min
                                            </span>
                                        }

                                    </div>


                                    @if (
                                        !string.IsNullOrWhiteSpace(
                                            exercise.Notes))
                                    {
                                        <p class="hte-notes">
                                            @exercise.Notes
                                        </p>
                                    }

                                </div>


                                @using (Html.BeginForm(
                                    "RemoveExercise",
                                    "WorkoutPlans",
                                    new
                                    {
                                        area =
                                            "Trainer"
                                    },
                                    FormMethod.Post,
                                    null))
                                {
                                    @Html.AntiForgeryToken()

                                    <input
                                        type="hidden"
                                        name="id"
                                        value="@exercise.WorkoutExerciseId" />

                                    <input
                                        type="hidden"
                                        name="workoutPlanId"
                                        value="@Model.WorkoutPlanId" />

                                    <button
                                        class="hte-remove"
                                        type="submit"
                                        onclick="return confirm('Remove this exercise from the workout plan?');">
                                        Remove
                                    </button>
                                }

                            </article>
                        }

                    </div>
                }

            </div>

        </section>

    </div>

</div>