@model HealthTrackPro.Web.Areas.Trainer.Models.AppointmentIndexViewModel
@using System.Linq

@{
    ViewBag.Title = "Appointments";

    var pendingCount =
        Model.Appointments.Count(a => a.Status == "Pending");

    var approvedCount =
        Model.Appointments.Count(a => a.Status == "Approved");

    var completedCount =
        Model.Appointments.Count(a => a.Status == "Completed");

    var rejectedCount =
        Model.Appointments.Count(a => a.Status == "Rejected");

    var minimumReschedule =
        DateTime.Now.ToString("yyyy-MM-ddTHH:mm");
}

<style>
    .hta-page {
        max-width: 1450px;
        margin: 0 auto;
    }

    .hta-hero {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 22px;
    }

    .hta-heading {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .hta-heading-icon {
        display: flex;
        width: 48px;
        height: 48px;
        align-items: center;
        justify-content: center;
        flex: 0 0 48px;
        border: 1px solid rgba(74,222,128,.14);
        border-radius: 14px;
        background:
            linear-gradient(
                145deg,
                rgba(34,197,94,.18),
                rgba(34,197,94,.06)
            );
        color: #4ADE80;
    }

    .hta-heading-icon svg {
        width: 24px;
        height: 24px;
        fill: currentColor;
    }

    .hta-hero h2 {
        margin: 0 0 5px;
        color: #F4F7F5;
        font-size: 27px;
        font-weight: 800;
        letter-spacing: -.4px;
    }

    .hta-hero p {
        margin: 0;
        color: #829087;
        font-size: 12px;
    }

    .hta-date {
        padding: 11px 14px;
        border: 1px solid #203026;
        border-radius: 10px;
        background: #101612;
        color: #C8D1CB;
        font-size: 11px;
        font-weight: 800;
    }

    .hta-summary {
        display: grid;
        grid-template-columns:
            repeat(5,minmax(0,1fr));
        gap: 12px;
        margin-bottom: 18px;
    }

    .hta-stat {
        position: relative;
        overflow: hidden;
        padding: 16px;
        border: 1px solid #1F2A22;
        border-radius: 12px;
        background:
            radial-gradient(
                circle at 100% 0,
                rgba(34,197,94,.07),
                transparent 48%
            ),
            #101612;
    }

    .hta-stat-label {
        display: block;
        margin-bottom: 8px;
        color: #66736A;
        font-size: 8px;
        font-weight: 900;
        letter-spacing: .8px;
        text-transform: uppercase;
    }

    .hta-stat-value {
        color: #F1F5F2;
        font-size: 24px;
        font-weight: 900;
    }

    .hta-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        margin-bottom: 17px;
        padding: 13px;
        border: 1px solid #1F2A22;
        border-radius: 12px;
        background: #101612;
    }

    .hta-search {
        width: 100%;
        max-width: 420px;
        height: 42px;
        padding: 10px 13px;
        border: 1px solid #26332A;
        border-radius: 9px;
        outline: none;
        background: #0C120E;
        color: #EEF3EF;
    }

    .hta-search:focus {
        border-color: #22C55E;
        box-shadow: 0 0 0 3px rgba(34,197,94,.10);
    }

    .hta-filters {
        display: flex;
        gap: 6px;
        overflow-x: auto;
    }

    .hta-filter {
        min-height: 38px;
        padding: 0 12px;
        border: 1px solid #26332A;
        border-radius: 8px;
        background: #0D130F;
        color: #8C9990;
        font-size: 9px;
        font-weight: 800;
        cursor: pointer;
        white-space: nowrap;
    }

    .hta-filter.active {
        border-color: #285C39;
        background: rgba(34,197,94,.12);
        color: #4ADE80;
    }

    .hta-alert {
        margin-bottom: 16px;
        padding: 12px 14px;
        border-radius: 10px;
        font-size: 11px;
        font-weight: 700;
    }

    .hta-alert-success {
        border: 1px solid rgba(34,197,94,.22);
        background: rgba(34,197,94,.08);
        color: #86EFAC;
    }

    .hta-alert-danger {
        border: 1px solid rgba(239,68,68,.22);
        background: rgba(239,68,68,.08);
        color: #FCA5A5;
    }

    .hta-grid {
        display: grid;
        grid-template-columns:
            repeat(2,minmax(0,1fr));
        gap: 15px;
    }

    .hta-card {
        overflow: hidden;
        border: 1px solid #1F2A22;
        border-radius: 14px;
        background:
            radial-gradient(
                circle at 100% 0,
                rgba(34,197,94,.06),
                transparent 48%
            ),
            #101612;
        transition: .2s ease;
    }

    .hta-card:hover {
        transform: translateY(-2px);
        border-color: #2B4934;
        box-shadow: 0 15px 30px rgba(0,0,0,.15);
    }

    .hta-card-head {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 15px;
        padding: 17px 18px;
        border-bottom: 1px solid #1B251E;
    }

    .hta-client-wrap {
        display: flex;
        align-items: center;
        gap: 11px;
    }

    .hta-avatar {
        display: flex;
        width: 40px;
        height: 40px;
        align-items: center;
        justify-content: center;
        flex: 0 0 40px;
        border-radius: 11px;
        background:
            linear-gradient(
                145deg,
                #15351F,
                #0E2114
            );
        color: #4ADE80;
        font-size: 14px;
        font-weight: 900;
    }

    .hta-client-name {
        margin: 0 0 4px;
        color: #EEF3EF;
        font-size: 14px;
        font-weight: 900;
    }

    .hta-reason {
        color: #758178;
        font-size: 10px;
        line-height: 1.45;
    }

    .hta-status {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 5px 8px;
        border-radius: 999px;
        font-size: 8px;
        font-weight: 900;
        letter-spacing: .5px;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .hta-status:before {
        content: "";
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: currentColor;
    }

    .hta-pending {
        background: rgba(245,158,11,.10);
        color: #FBBF24;
    }

    .hta-approved {
        background: rgba(34,197,94,.12);
        color: #4ADE80;
    }

    .hta-completed {
        background: rgba(59,130,246,.12);
        color: #60A5FA;
    }

    .hta-rejected,
    .hta-cancelled {
        background: rgba(239,68,68,.10);
        color: #F87171;
    }

    .hta-card-body {
        padding: 16px 18px 18px;
    }

    .hta-schedule {
        display: grid;
        grid-template-columns:
            minmax(0,1.5fr)
            minmax(100px,.5fr);
        gap: 10px;
        margin-bottom: 14px;
    }

    .hta-info {
        padding: 12px;
        border: 1px solid #1D2820;
        border-radius: 9px;
        background: #0D130F;
    }

    .hta-info-label {
        display: block;
        margin-bottom: 5px;
        color: #647168;
        font-size: 8px;
        font-weight: 900;
        letter-spacing: .7px;
        text-transform: uppercase;
    }

    .hta-info-value {
        color: #E4EAE6;
        font-size: 11px;
        font-weight: 800;
        line-height: 1.45;
    }

    .hta-actions {
        padding-top: 13px;
        border-top: 1px solid #1B251E;
    }

    .hta-action-row {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .hta-form {
        margin: 0;
    }

    .hta-button {
        min-height: 37px;
        padding: 0 13px;
        border-radius: 8px;
        font-size: 10px;
        font-weight: 900;
    }

    .hta-approve {
        border: 0;
        background: linear-gradient(135deg,#22C55E,#16A34A);
        color: #061009;
    }

    .hta-reject {
        border: 1px solid rgba(239,68,68,.30);
        background: rgba(239,68,68,.07);
        color: #FCA5A5;
    }

    .hta-complete {
        border: 1px solid #285C39;
        background: rgba(34,197,94,.10);
        color: #4ADE80;
    }

    .hta-reschedule {
        margin-top: 11px;
        padding: 12px;
        border: 1px solid #1D2920;
        border-radius: 10px;
        background: #0C120E;
    }

    .hta-reschedule-label {
        display: block;
        margin-bottom: 7px;
        color: #7E8B82;
        font-size: 8px;
        font-weight: 900;
        letter-spacing: .7px;
        text-transform: uppercase;
    }

    .hta-reschedule-form {
        display: grid;
        grid-template-columns: minmax(0,1fr) auto;
        gap: 8px;
        margin: 0;
    }

    .hta-datetime {
        width: 100%;
        max-width: none;
        height: 39px;
        padding: 8px 10px;
        border: 1px solid #26332A;
        border-radius: 8px;
        outline: none;
        background: #0A100C;
        color: #EEF3EF;
        color-scheme: dark;
    }

    .hta-datetime:focus {
        border-color: #22C55E;
        box-shadow: 0 0 0 3px rgba(34,197,94,.08);
    }

    .hta-reschedule-button {
        min-height: 39px;
        padding: 0 12px;
        border: 1px solid #2A382E;
        border-radius: 8px;
        background: #121A14;
        color: #C8D1CB;
        font-size: 9px;
        font-weight: 900;
    }

    .hta-final {
        padding: 11px;
        border: 1px solid #1B261E;
        border-radius: 9px;
        background: #0C120E;
        color: #748178;
        font-size: 10px;
        text-align: center;
    }

    .hta-empty,
    .hta-no-results {
        grid-column: 1 / -1;
        padding: 60px 25px;
        border: 1px dashed #28352C;
        border-radius: 14px;
        background: #0E140F;
        text-align: center;
        color: #758178;
    }

    .hta-empty-icon {
        display: flex;
        width: 60px;
        height: 60px;
        align-items: center;
        justify-content: center;
        margin: 0 auto 14px;
        border-radius: 16px;
        background: rgba(34,197,94,.08);
        color: #4ADE80;
    }

    .hta-empty-icon svg {
        width: 28px;
        height: 28px;
        fill: currentColor;
    }

    .hta-empty h3 {
        margin: 0 0 6px;
        color: #E9EEEA;
        font-size: 17px;
        font-weight: 900;
    }

    .hta-empty p {
        margin: 0;
        font-size: 11px;
    }

    .hta-no-results {
        display: none;
        margin-top: 16px;
        padding: 35px;
        font-size: 11px;
    }

    @@media (max-width: 1100px) {
        .hta-summary {
            grid-template-columns:
                repeat(3,minmax(0,1fr));
        }

        .hta-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 750px) {
        .hta-hero,
        .hta-toolbar {
            flex-direction: column;
            align-items: stretch;
        }

        .hta-summary {
            grid-template-columns:
                repeat(2,minmax(0,1fr));
        }

        .hta-search {
            max-width: none;
        }

        .hta-schedule,
        .hta-reschedule-form {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 500px) {
        .hta-summary {
            grid-template-columns: 1fr;
        }
    }
</style>


<div class="hta-page">

    <div class="hta-hero">

        <div class="hta-heading">

            <div class="hta-heading-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M7 2h2v2h6V2h2v2h3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h3V2Zm13 8H4v10h16V10ZM4 8h16V6H4v2Zm3 5h4v4H7v-4Z"/>
                </svg>
            </div>

            <div>
                <h2>Appointment Management</h2>
                <p>
                    Review consultation requests, manage schedules
                    and complete client appointments.
                </p>
            </div>

        </div>

        <div class="hta-date">
            @DateTime.Now.ToString("dddd, dd MMMM yyyy")
        </div>

    </div>


    @if (TempData["SuccessMessage"] != null)
    {
        <div class="hta-alert hta-alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="hta-alert hta-alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }


    <div class="hta-summary">

        <div class="hta-stat">
            <span class="hta-stat-label">Total</span>
            <span class="hta-stat-value">
                @Model.Appointments.Count
            </span>
        </div>

        <div class="hta-stat">
            <span class="hta-stat-label">Pending</span>
            <span class="hta-stat-value">
                @pendingCount
            </span>
        </div>

        <div class="hta-stat">
            <span class="hta-stat-label">Approved</span>
            <span class="hta-stat-value">
                @approvedCount
            </span>
        </div>

        <div class="hta-stat">
            <span class="hta-stat-label">Completed</span>
            <span class="hta-stat-value">
                @completedCount
            </span>
        </div>

        <div class="hta-stat">
            <span class="hta-stat-label">Rejected</span>
            <span class="hta-stat-value">
                @rejectedCount
            </span>
        </div>

    </div>


    @if (Model.Appointments.Count > 0)
    {
        <div class="hta-toolbar">

            <input
                id="htaSearch"
                class="hta-search"
                type="search"
                placeholder="Search client, reason or status..." />

            <div class="hta-filters">

                <button
                    type="button"
                    class="hta-filter active"
                    data-filter="all">
                    All
                </button>

                <button
                    type="button"
                    class="hta-filter"
                    data-filter="pending">
                    Pending
                </button>

                <button
                    type="button"
                    class="hta-filter"
                    data-filter="approved">
                    Approved
                </button>

                <button
                    type="button"
                    class="hta-filter"
                    data-filter="completed">
                    Completed
                </button>

                <button
                    type="button"
                    class="hta-filter"
                    data-filter="rejected">
                    Rejected
                </button>

            </div>

        </div>
    }


    <div class="hta-grid">

        @if (Model.Appointments.Count == 0)
        {
            <div class="hta-empty">

                <div class="hta-empty-icon">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M7 2h2v2h6V2h2v2h3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h3V2Zm13 8H4v10h16V10ZM4 8h16V6H4v2Z"/>
                    </svg>
                </div>

                <h3>No appointments yet</h3>

                <p>
                    Client consultation requests will appear here.
                </p>

            </div>
        }
        else
        {
            foreach (var row in Model.Appointments)
            {
                var statusLower =
                    (row.Status ?? "")
                        .ToLowerInvariant();

                var initial =
                    string.IsNullOrWhiteSpace(row.ClientName)
                        ? "C"
                        : row.ClientName.Substring(0, 1).ToUpper();

                var statusClass =
                    statusLower == "approved"
                        ? "hta-approved"
                        : statusLower == "completed"
                            ? "hta-completed"
                            : statusLower == "rejected"
                                ? "hta-rejected"
                                : statusLower == "cancelled"
                                    ? "hta-cancelled"
                                    : "hta-pending";

                var searchText =
                    (
                        row.ClientName +
                        " " +
                        row.Reason +
                        " " +
                        row.Status +
                        " " +
                        row.When
                    ).ToLowerInvariant();

                <article
                    class="hta-card"
                    data-status="@statusLower"
                    data-search="@searchText">

                    <div class="hta-card-head">

                        <div class="hta-client-wrap">

                            <div class="hta-avatar">
                                @initial
                            </div>

                            <div>

                                <h3 class="hta-client-name">
                                    @row.ClientName
                                </h3>

                                <div class="hta-reason">
                                    @(string.IsNullOrWhiteSpace(row.Reason)
                                        ? "General consultation"
                                        : row.Reason)
                                </div>

                            </div>

                        </div>

                        <span class="hta-status @statusClass">
                            @row.Status
                        </span>

                    </div>


                    <div class="hta-card-body">

                        <div class="hta-schedule">

                            <div class="hta-info">

                                <span class="hta-info-label">
                                    Appointment
                                </span>

                                <span class="hta-info-value">
                                    @row.When
                                </span>

                            </div>

                            <div class="hta-info">

                                <span class="hta-info-label">
                                    Duration
                                </span>

                                <span class="hta-info-value">
                                    @row.DurationMinutes min
                                </span>

                            </div>

                        </div>


                        <div class="hta-actions">

                            @if (row.IsPending)
                            {
                                <div class="hta-action-row">

                                    <form
                                        class="hta-form"
                                        method="post"
                                        action="@Url.Action(
                                            "Approve",
                                            "Appointments",
                                            new { area = "Trainer" })">

                                        @Html.AntiForgeryToken()

                                        <input
                                            type="hidden"
                                            name="id"
                                            value="@row.AppointmentId" />

                                        <button
                                            type="submit"
                                            class="hta-button hta-approve">
                                            &#10003; Approve
                                        </button>

                                    </form>


                                    <form
                                        class="hta-form"
                                        method="post"
                                        action="@Url.Action(
                                            "Reject",
                                            "Appointments",
                                            new { area = "Trainer" })">

                                        @Html.AntiForgeryToken()

                                        <input
                                            type="hidden"
                                            name="id"
                                            value="@row.AppointmentId" />

                                        <button
                                            type="submit"
                                            class="hta-button hta-reject">
                                            Reject
                                        </button>

                                    </form>

                                </div>
                            }


                            @if (row.IsApproved)
                            {
                                <div class="hta-action-row">

                                    <form
                                        class="hta-form"
                                        method="post"
                                        action="@Url.Action(
                                            "Complete",
                                            "Appointments",
                                            new { area = "Trainer" })">

                                        @Html.AntiForgeryToken()

                                        <input
                                            type="hidden"
                                            name="id"
                                            value="@row.AppointmentId" />

                                        <button
                                            type="submit"
                                            class="hta-button hta-complete">
                                            Mark completed
                                        </button>

                                    </form>

                                </div>
                            }


                            @if (row.CanReschedule)
                            {
                                <div class="hta-reschedule">

                                    <span class="hta-reschedule-label">
                                        Reschedule appointment
                                    </span>

                                    <form
                                        class="hta-reschedule-form"
                                        method="post"
                                        action="@Url.Action(
                                            "Reschedule",
                                            "Appointments",
                                            new { area = "Trainer" })">

                                        @Html.AntiForgeryToken()

                                        <input
                                            type="hidden"
                                            name="id"
                                            value="@row.AppointmentId" />

                                        <input
                                            class="hta-datetime"
                                            type="datetime-local"
                                            name="newDateTime"
                                            min="@minimumReschedule"
                                            required />

                                        <button
                                            type="submit"
                                            class="hta-reschedule-button">
                                            Reschedule
                                        </button>

                                    </form>

                                </div>
                            }


                            @if (!row.IsPending &&
                                 !row.IsApproved &&
                                 !row.CanReschedule)
                            {
                                <div class="hta-final">
                                    This appointment requires no further action.
                                </div>
                            }

                        </div>

                    </div>

                </article>
            }
        }

    </div>


    @if (Model.Appointments.Count > 0)
    {
        <div
            id="htaNoResults"
            class="hta-no-results">
            No appointments match your current search or filter.
        </div>
    }

</div>


@section scripts {

<script>
(function () {

    "use strict";

    var search =
        document.getElementById("htaSearch");

    var cards =
        Array.prototype.slice.call(
            document.querySelectorAll(
                ".hta-card"
            )
        );

    var filters =
        Array.prototype.slice.call(
            document.querySelectorAll(
                ".hta-filter"
            )
        );

    var noResults =
        document.getElementById(
            "htaNoResults"
        );

    if (!search || cards.length === 0) {
        return;
    }

    var currentFilter = "all";


    function refresh() {

        var term =
            search.value
                .trim()
                .toLowerCase();

        var visible = 0;

        cards.forEach(function (card) {

            var status =
                card.getAttribute(
                    "data-status"
                );

            var searchable =
                card.getAttribute(
                    "data-search"
                ) || "";

            var statusMatch =
                currentFilter === "all" ||
                status === currentFilter;

            var searchMatch =
                !term ||
                searchable.indexOf(term) !== -1;

            var show =
                statusMatch &&
                searchMatch;

            card.style.display =
                show ? "" : "none";

            if (show) {
                visible++;
            }
        });


        if (noResults) {
            noResults.style.display =
                visible === 0
                    ? "block"
                    : "none";
        }
    }


    filters.forEach(function (button) {

        button.addEventListener(
            "click",
            function () {

                currentFilter =
                    button.getAttribute(
                        "data-filter"
                    );

                filters.forEach(
                    function (item) {
                        item.classList.remove(
                            "active"
                        );
                    }
                );

                button.classList.add(
                    "active"
                );

                refresh();
            }
        );
    });


    search.addEventListener(
        "input",
        refresh
    );

})();
</script>

}