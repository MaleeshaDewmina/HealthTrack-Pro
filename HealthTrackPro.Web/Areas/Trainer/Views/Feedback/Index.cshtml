@model HealthTrackPro.Web.Areas.Trainer.Models.FeedbackIndexViewModel

@{
    ViewBag.Title = "Feedback";
}

<div class="ht-card">
    <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;">
        <h2 class="ht-card-title" style="margin:0;">Feedback</h2>
        <a class="btn btn-success" href="@Url.Action("Create", "Feedback", new { area = "Trainer" })">Give feedback</a>
    </div>

    @if (TempData["SuccessMessage"] != null) { <div class="alert alert-success" style="margin-top:12px;">@TempData["SuccessMessage"]</div> }

    @if (Model.Items.Count == 0)
    {
        <p class="text-muted" style="margin-top:16px;">You haven't given any feedback yet.</p>
    }
    else
    {
        <div class="table-responsive" style="margin-top:16px;">
            <table class="table table-hover">
                <thead>
                    <tr><th>Date</th><th>Client</th><th>Area</th><th>Feedback</th><th>Rating</th><th>Next focus</th></tr>
                </thead>
                <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.CreatedAt</td>
                        <td>@item.ClientName</td>
                        <td>@item.RelatedArea</td>
                        <td>@item.FeedbackText</td>
                        <td>@item.Rating</td>
                        <td>@item.NextFocus</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
