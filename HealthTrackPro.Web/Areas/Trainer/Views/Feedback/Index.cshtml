@model HealthTrackPro.Web.Areas.Trainer.Models.FeedbackIndexViewModel
@using System.Linq

@{
    ViewBag.Title = "Feedback";

    var ratedCount =
        Model.Items.Count(x => x.Rating != "-");

    var focusCount =
        Model.Items.Count(x =>
            !string.IsNullOrWhiteSpace(x.NextFocus));
}

<style>
    .htf-page {
        max-width: 1450px;
        margin: 0 auto;
    }

    .htf-hero {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 22px;
    }

    .htf-heading {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .htf-heading-icon {
        display: flex;
        width: 48px;
        height: 48px;
        align-items: center;
        justify-content: center;
        flex: 0 0 48px;
        border: 1px solid rgba(74,222,128,.14);
        border-radius: 14px;
        background:
            linear-gradient(
                145deg,
                rgba(34,197,94,.18),
                rgba(34,197,94,.06)
            );
        color: #4ADE80;
    }

    .htf-heading-icon svg {
        width: 24px;
        height: 24px;
        fill: currentColor;
    }

    .htf-hero h2 {
        margin: 0 0 5px;
        color: #F4F7F5;
        font-size: 27px;
        font-weight: 800;
    }

    .htf-hero p {
        margin: 0;
        color: #829087;
        font-size: 12px;
    }

    .htf-create {
        display: inline-flex;
        min-height: 45px;
        align-items: center;
        justify-content: center;
        padding: 0 18px;
        border-radius: 10px;
        background: linear-gradient(135deg,#22C55E,#16A34A);
        color: #061009 !important;
        font-size: 12px;
        font-weight: 900;
        text-decoration: none !important;
    }

    .htf-summary {
        display: grid;
        grid-template-columns: repeat(3,minmax(0,1fr));
        gap: 13px;
        margin-bottom: 18px;
    }

    .htf-stat {
        padding: 17px;
        border: 1px solid #1F2A22;
        border-radius: 13px;
        background:
            radial-gradient(
                circle at 100% 0,
                rgba(34,197,94,.08),
                transparent 48%
            ),
            #101612;
    }

    .htf-stat-label {
        display: block;
        margin-bottom: 8px;
        color: #68766D;
        font-size: 9px;
        font-weight: 900;
        letter-spacing: .8px;
        text-transform: uppercase;
    }

    .htf-stat-value {
        color: #F1F5F2;
        font-size: 25px;
        font-weight: 900;
    }

    .htf-alert {
        margin-bottom: 17px;
        padding: 12px 14px;
        border: 1px solid rgba(34,197,94,.22);
        border-radius: 10px;
        background: rgba(34,197,94,.08);
        color: #86EFAC;
        font-size: 11px;
        font-weight: 700;
    }

    .htf-toolbar {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 17px;
        padding: 13px;
        border: 1px solid #1F2A22;
        border-radius: 12px;
        background: #101612;
    }

    .htf-search {
        width: 100%;
        max-width: 440px;
        height: 42px;
        padding: 10px 13px;
        border: 1px solid #26332A;
        border-radius: 9px;
        outline: none;
        background: #0C120E;
        color: #EEF3EF;
    }

    .htf-search:focus {
        border-color: #22C55E;
        box-shadow: 0 0 0 3px rgba(34,197,94,.10);
    }

    .htf-grid {
        display: grid;
        grid-template-columns: repeat(2,minmax(0,1fr));
        gap: 15px;
    }

    .htf-card {
        overflow: hidden;
        border: 1px solid #1F2A22;
        border-radius: 14px;
        background:
            radial-gradient(
                circle at 100% 0,
                rgba(34,197,94,.06),
                transparent 50%
            ),
            #101612;
    }

    .htf-card-head {
        display: flex;
        justify-content: space-between;
        gap: 15px;
        padding: 17px 18px;
        border-bottom: 1px solid #1B251E;
    }

    .htf-client {
        display: flex;
        align-items: center;
        gap: 11px;
    }

    .htf-avatar {
        display: flex;
        width: 40px;
        height: 40px;
        align-items: center;
        justify-content: center;
        flex: 0 0 40px;
        border-radius: 11px;
        background: linear-gradient(145deg,#15351F,#0E2114);
        color: #4ADE80;
        font-size: 14px;
        font-weight: 900;
    }

    .htf-client-name {
        margin: 0 0 4px;
        color: #EEF3EF;
        font-size: 14px;
        font-weight: 900;
    }

    .htf-date {
        color: #718077;
        font-size: 9px;
    }

    .htf-area {
        display: inline-flex;
        height: 25px;
        align-items: center;
        padding: 0 9px;
        border-radius: 999px;
        background: rgba(34,197,94,.10);
        color: #4ADE80;
        font-size: 8px;
        font-weight: 900;
        text-transform: uppercase;
    }

    .htf-body {
        padding: 18px;
    }

    .htf-stars {
        display: flex;
        gap: 3px;
        margin-bottom: 13px;
    }

    .htf-star {
        color: #28352C;
        font-size: 16px;
    }

    .htf-star-filled {
        color: #FBBF24;
    }

    .htf-feedback {
        margin: 0 0 15px;
        color: #CBD4CD;
        font-size: 11px;
        line-height: 1.65;
    }

    .htf-focus {
        padding: 12px;
        border: 1px solid #1D2820;
        border-radius: 9px;
        background: #0D130F;
    }

    .htf-focus-label {
        display: block;
        margin-bottom: 5px;
        color: #647168;
        font-size: 8px;
        font-weight: 900;
        letter-spacing: .7px;
        text-transform: uppercase;
    }

    .htf-focus-text {
        color: #E0E7E2;
        font-size: 10px;
        line-height: 1.5;
    }

    .htf-empty,
    .htf-no-results {
        grid-column: 1 / -1;
        padding: 60px 25px;
        border: 1px dashed #28352C;
        border-radius: 14px;
        background: #0E140F;
        text-align: center;
        color: #758178;
    }

    .htf-empty h3 {
        margin: 0 0 7px;
        color: #E9EEEA;
        font-size: 17px;
    }

    .htf-empty p {
        margin-bottom: 16px;
        font-size: 11px;
    }

    .htf-no-results {
        display: none;
        margin-top: 16px;
        padding: 35px;
        font-size: 11px;
    }

    @@media (max-width: 900px) {
        .htf-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 700px) {
        .htf-hero,
        .htf-toolbar {
            flex-direction: column;
            align-items: stretch;
        }

        .htf-summary {
            grid-template-columns: 1fr;
        }

        .htf-search {
            max-width: none;
        }
    }
</style>


<div class="htf-page">

    <div class="htf-hero">

        <div class="htf-heading">

            <div class="htf-heading-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M4 3h16a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2h-9l-5 4v-4H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Zm2 5v2h12V8H6Zm0 4v2h8v-2H6Z"/>
                </svg>
            </div>

            <div>
                <h2>Client Feedback</h2>
                <p>
                    Review coaching feedback and future focus
                    guidance shared with your assigned clients.
                </p>
            </div>

        </div>

        <a
            class="htf-create"
            href="@Url.Action(
                "Create",
                "Feedback",
                new { area = "Trainer" })">
            + Give feedback
        </a>

    </div>


    @if (TempData["SuccessMessage"] != null)
    {
        <div class="htf-alert">
            @TempData["SuccessMessage"]
        </div>
    }


    <div class="htf-summary">

        <div class="htf-stat">
            <span class="htf-stat-label">Feedback records</span>
            <span class="htf-stat-value">@Model.Items.Count</span>
        </div>

        <div class="htf-stat">
            <span class="htf-stat-label">Rated records</span>
            <span class="htf-stat-value">@ratedCount</span>
        </div>

        <div class="htf-stat">
            <span class="htf-stat-label">Next-focus plans</span>
            <span class="htf-stat-value">@focusCount</span>
        </div>

    </div>


    @if (Model.Items.Count > 0)
    {
        <div class="htf-toolbar">

            <input
                id="htfSearch"
                class="htf-search"
                type="search"
                placeholder="Search client, area or feedback..." />

        </div>
    }


    <div class="htf-grid">

        @if (Model.Items.Count == 0)
        {
            <div class="htf-empty">

                <h3>No feedback yet</h3>

                <p>
                    Give your first coaching feedback to an
                    assigned client.
                </p>

                <a
                    class="htf-create"
                    href="@Url.Action(
                        "Create",
                        "Feedback",
                        new { area = "Trainer" })">
                    + Give first feedback
                </a>

            </div>
        }
        else
        {
            foreach (var item in Model.Items)
            {
                var initial =
                    string.IsNullOrWhiteSpace(item.ClientName)
                        ? "C"
                        : item.ClientName.Substring(0,1).ToUpper();

                int ratingValue = 0;

                if (!string.IsNullOrWhiteSpace(item.Rating) &&
                    item.Rating != "-")
                {
                    int.TryParse(
                        item.Rating.Split('/')[0].Trim(),
                        out ratingValue);
                }

                var searchText =
                    (
                        item.ClientName +
                        " " +
                        item.RelatedArea +
                        " " +
                        item.FeedbackText +
                        " " +
                        item.NextFocus
                    ).ToLowerInvariant();

                <article
                    class="htf-card"
                    data-search="@searchText">

                    <div class="htf-card-head">

                        <div class="htf-client">

                            <div class="htf-avatar">
                                @initial
                            </div>

                            <div>
                                <h3 class="htf-client-name">
                                    @item.ClientName
                                </h3>

                                <div class="htf-date">
                                    @item.CreatedAt
                                </div>
                            </div>

                        </div>

                        <span class="htf-area">
                            @item.RelatedArea
                        </span>

                    </div>


                    <div class="htf-body">

                        @if (ratingValue > 0)
                        {
                            <div class="htf-stars">

                                @for (int i = 1; i <= 5; i++)
                                {
                                    <span
                                        class="htf-star @(i <= ratingValue ? "htf-star-filled" : "")">
                                        &#9733;
                                    </span>
                                }

                            </div>
                        }

                        <p class="htf-feedback">
                            @item.FeedbackText
                        </p>


                        @if (!string.IsNullOrWhiteSpace(item.NextFocus))
                        {
                            <div class="htf-focus">

                                <span class="htf-focus-label">
                                    Next focus
                                </span>

                                <span class="htf-focus-text">
                                    @item.NextFocus
                                </span>

                            </div>
                        }

                    </div>

                </article>
            }
        }

    </div>


    @if (Model.Items.Count > 0)
    {
        <div
            id="htfNoResults"
            class="htf-no-results">
            No feedback records match your search.
        </div>
    }

</div>


@section scripts {

<script>
(function () {

    "use strict";

    var search =
        document.getElementById("htfSearch");

    var cards =
        Array.prototype.slice.call(
            document.querySelectorAll(".htf-card")
        );

    var noResults =
        document.getElementById("htfNoResults");

    if (!search || cards.length === 0) {
        return;
    }


    search.addEventListener(
        "input",
        function () {

            var term =
                search.value
                    .trim()
                    .toLowerCase();

            var visible = 0;

            cards.forEach(function (card) {

                var text =
                    card.getAttribute(
                        "data-search"
                    ) || "";

                var show =
                    !term ||
                    text.indexOf(term) !== -1;

                card.style.display =
                    show ? "" : "none";

                if (show) {
                    visible++;
                }
            });


            if (noResults) {
                noResults.style.display =
                    visible === 0
                        ? "block"
                        : "none";
            }
        }
    );

})();
</script>

}