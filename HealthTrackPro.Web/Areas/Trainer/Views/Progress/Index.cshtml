    }

    .htpr-ring-value {
        color: #F4F8F5;
        font-size: 22px;
        font-weight: 900;
    }

    .htpr-ring-label {
        color: #68756C;
        font-size: 7px;
        font-weight: 900;
        letter-spacing: .7px;
        text-transform: uppercase;
    }

    .htpr-overview-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
    }

    .htpr-overview-item {
