    }

    .htpr-overview-label {
        display: block;
        margin-bottom: 5px;
        color: #6E7B72;
        font-size: 8px;
        font-weight: 900;
        letter-spacing: .7px;
        text-transform: uppercase;
    }

    .htpr-overview-name {
        display: block;
        margin-bottom: 5px;
        color: #F0F5F1;
        font-size: 18px;
        font-weight: 900;
    }

    .htpr-overview-goal {
        color: #4ADE80;
        font-size: 10px;
        font-weight: 800;
    }

    .htpr-ring-wrap {
        display: flex;
        justify-content: center;
        margin: 16px 0;
    }

    .htpr-ring {
