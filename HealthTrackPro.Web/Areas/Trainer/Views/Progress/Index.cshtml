        gap: 16px;
        margin-bottom: 18px;
    }

    .htpr-card {
        overflow: hidden;
        border: 1px solid #1F2A22;
        border-radius: 14px;
        background: #101612;
    }

    .htpr-card-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        padding: 17px 19px;
        border-bottom: 1px solid #1B251E;
    }

    .htpr-card-head h3 {
        margin: 0 0 4px;
        color: #EEF3EF;
        font-size: 14px;
        font-weight: 900;
    }

    .htpr-card-head p {
