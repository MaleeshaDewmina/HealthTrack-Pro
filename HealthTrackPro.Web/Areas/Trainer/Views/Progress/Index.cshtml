            #101612;
    }

    .htpr-stat-label {
        display: block;
        margin-bottom: 8px;
        color: #68766D;
        font-size: 8px;
        font-weight: 900;
        letter-spacing: .8px;
        text-transform: uppercase;
    }

    .htpr-stat-value {
        color: #F1F5F2;
        font-size: 25px;
        font-weight: 900;
    }

    .htpr-analytics {
