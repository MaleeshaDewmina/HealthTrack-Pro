</style>


<div class="htpr-page">

    <div class="htpr-hero">

        <div class="htpr-heading">

            <div class="htpr-heading-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M4 19h16v2H2V3h2v16Zm3-3 4-5 3 3 5-7 2 1-7 10-3-3-2 3-2-2Z"/>
                </svg>
            </div>

            <div>
                <h2>Progress Analytics</h2>

                <p>
                    Monitor client goals, health measurements,
                    weight trends and BMI progression.
                </p>
            </div>

        </div>

        <div class="htpr-generated">
            Generated
            @Model.GeneratedAt.ToString(
                "dd MMM yyyy, h:mm tt")
        </div>

    </div>


    <div class="htpr-summary">

        <div class="htpr-stat">
            <span class="htpr-stat-label">
                Assigned clients
            </span>

            <span class="htpr-stat-value">
                @Model.Clients.Count
            </span>
        </div>

        <div class="htpr-stat">
            <span class="htpr-stat-label">
                Active goals
            </span>

            <span class="htpr-stat-value">
                @Model.TotalActiveGoals
            </span>
        </div>

        <div class="htpr-stat">
            <span class="htpr-stat-label">
                Completed goals
            </span>

            <span class="htpr-stat-value">
                @Model.TotalCompletedGoals
            </span>
        </div>

        <div class="htpr-stat">
            <span class="htpr-stat-label">
                Overall goal progress
            </span>

            <span class="htpr-stat-value">
                @Model.OverallAverageGoalProgress.ToString("0")%
            </span>
        </div>

    </div>


    @if (Model.Clients.Count == 0)
    {
        <div class="htpr-empty">
            No assigned clients yet, so there is no progress
            information to analyze.
        </div>
    }
    else
    {
        <div class="htpr-analytics">

            <section class="htpr-card">

                <div class="htpr-card-head">

                    <div>
                        <h3>Health trend analysis</h3>

                        <p>
                            Latest ten recorded health measurements.
                        </p>
                    </div>


                    <select
                        id="htprClientSelect"
                        class="htpr-select">

                        @foreach (var client in Model.Clients)
                        {
                            <option value="@client.ClientUserId">
                                @client.ClientName
                            </option>
                        }

                    </select>

                </div>


                <div class="htpr-chart-grid">

                    <div class="htpr-chart-box">

                        <div class="htpr-chart-title">
                            <strong>Weight trend</strong>
                            <span>kg</span>
                        </div>

                        <canvas
                            id="htprWeightChart"
                            class="htpr-canvas">
                        </canvas>

                    </div>


                    <div class="htpr-chart-box">

                        <div class="htpr-chart-title">
                            <strong>BMI trend</strong>
                            <span>BMI</span>
                        </div>

                        <canvas
                            id="htprBmiChart"
                            class="htpr-canvas">
                        </canvas>

                    </div>

                </div>

            </section>


            <aside class="htpr-card">

                <div class="htpr-card-head">

                    <div>
                        <h3>Selected client</h3>
                        <p>Current progress overview.</p>
                    </div>

                </div>


                <div class="htpr-client-overview">

                    <div class="htpr-overview-hero">

                        <span class="htpr-overview-label">
                            Client
                        </span>

                        <span
                            id="htprSelectedName"
                            class="htpr-overview-name">
                        </span>

                        <span
                            id="htprSelectedGoal"
                            class="htpr-overview-goal">
                        </span>

                    </div>


                    <div class="htpr-ring-wrap">

                        <div
                            id="htprProgressRing"
                            class="htpr-ring"
                            style="--angle:0deg;">

                            <div class="htpr-ring-inner">

                                <span
                                    id="htprProgressValue"
                                    class="htpr-ring-value">
                                    0%
                                </span>

                                <span class="htpr-ring-label">
                                    Goal progress
                                </span>

                            </div>

                        </div>

                    </div>


                    <div class="htpr-overview-grid">

                        <div class="htpr-overview-item">

                            <span class="htpr-overview-item-label">
                                Current weight
                            </span>

                            <span
                                id="htprSelectedWeight"
                                class="htpr-overview-item-value">
                            </span>

                        </div>


                        <div class="htpr-overview-item">

                            <span class="htpr-overview-item-label">
                                BMI
                            </span>

                            <span
                                id="htprSelectedBmi"
                                class="htpr-overview-item-value">
                            </span>

                        </div>


                        <div class="htpr-overview-item">

                            <span class="htpr-overview-item-label">
                                Active goals
                            </span>

                            <span
                                id="htprSelectedActive"
                                class="htpr-overview-item-value">
                            </span>

                        </div>


                        <div class="htpr-overview-item">

                            <span class="htpr-overview-item-label">
                                Completed
                            </span>

                            <span
                                id="htprSelectedCompleted"
                                class="htpr-overview-item-value">
                            </span>

                        </div>


                        <div class="htpr-overview-item">

                            <span class="htpr-overview-item-label">
                                Measurements
                            </span>

                            <span
                                id="htprSelectedMeasurements"
                                class="htpr-overview-item-value">
                            </span>

                        </div>


                        <div class="htpr-overview-item">

                            <span class="htpr-overview-item-label">
                                Last recorded
                            </span>

                            <span
                                id="htprSelectedRecorded"
                                class="htpr-overview-item-value">
                            </span>

                        </div>

                    </div>

                </div>

            </aside>

        </div>


        <div class="htpr-report-head">

            <h3>Client progress report</h3>

            <input
                id="htprSearch"
                class="htpr-search"
                type="search"
                placeholder="Search client or fitness goal..." />

        </div>


        <div class="htpr-client-grid">

            @foreach (var row in Model.Clients)
            {
                var initial =
                    string.IsNullOrWhiteSpace(row.ClientName)
                        ? "C"
                        : row.ClientName
                            .Substring(0,1)
                            .ToUpper();

                <article
                    class="htpr-client-card"
                    data-search="@((row.ClientName + " " + row.Goal).ToLowerInvariant())">

                    <div class="htpr-client-head">

                        <div class="htpr-avatar">
                            @initial
                        </div>

                        <div>
                            <h4 class="htpr-client-name">
                                @row.ClientName
                            </h4>

                            <div class="htpr-client-goal">
                                @row.Goal
                            </div>
                        </div>

                    </div>


                    <div class="htpr-client-body">

                        <div class="htpr-mini-grid">

                            <div class="htpr-mini">
                                <span class="htpr-mini-label">
                                    Weight
                                </span>
                                <span class="htpr-mini-value">
                                    @row.CurrentWeight
                                </span>
                            </div>

                            <div class="htpr-mini">
                                <span class="htpr-mini-label">
                                    BMI
                                </span>
                                <span class="htpr-mini-value">
                                    @row.Bmi
                                </span>
                            </div>

                            <div class="htpr-mini">
                                <span class="htpr-mini-label">
                                    Active goals
                                </span>
                                <span class="htpr-mini-value">
                                    @row.ActiveGoals
                                </span>
                            </div>

                            <div class="htpr-mini">
                                <span class="htpr-mini-label">
                                    Completed
                                </span>
                                <span class="htpr-mini-value">
                                    @row.CompletedGoals
                                </span>
                            </div>

                        </div>


                        <div class="htpr-progress-head">

                            <span>Average goal progress</span>

                            <span>
                                @row.AverageGoalProgress
                            </span>

                        </div>


                        <div class="htpr-progress-track">

                            <div
                                class="htpr-progress-fill"
                                style="width:@Math.Min(100m, row.AverageGoalProgressValue).ToString("0")%;">
                            </div>

                        </div>


                        <a
                            class="htpr-view"
                            href="@Url.Action(
                                "Details",
                                "Clients",
                                new
                                {
                                    area = "Trainer",
                                    id = row.ClientUserId
                                })">
                            View full client profile
                        </a>

                    </div>

                </article>
            }

        </div>


        <div
            id="htprNoResults"
            class="htpr-no-results">
            No clients match your search.
        </div>
    }

</div>


@section scripts {

<script>
(function () {

    "use strict";

    var clients =
        @Html.Raw(chartJson);

    if (!clients || clients.length === 0) {
        return;
    }


    var select =
        document.getElementById(
            "htprClientSelect"
        );

    var weightCanvas =
        document.getElementById(
            "htprWeightChart"
        );

    var bmiCanvas =
        document.getElementById(
            "htprBmiChart"
        );


    function findClient(id) {

        for (var i = 0; i < clients.length; i++) {

            if (clients[i].id === id) {
                return clients[i];
            }
        }

        return clients[0];
    }


    function drawChart(
        canvas,
        points,
        key,
        suffix,
        strokeColor) {

        if (!canvas) {
            return;
        }

        var width =
            canvas.clientWidth || 500;

        var height = 230;

        var ratio =
            window.devicePixelRatio || 1;

        canvas.width =
            width * ratio;

        canvas.height =
            height * ratio;

        var ctx =
            canvas.getContext("2d");

        ctx.setTransform(
            ratio,
            0,
            0,
            ratio,
            0,
            0
        );

        ctx.clearRect(
            0,
            0,
            width,
            height
        );


        var usable =
            points.filter(
                function (p) {
                    return p[key] !== null &&
                           p[key] !== undefined;
                }
            );


        if (usable.length === 0) {

            ctx.fillStyle =
                "#748078";

            ctx.font =
                "11px sans-serif";

            ctx.textAlign =
                "center";

            ctx.fillText(
                "No recorded data available",
                width / 2,
                height / 2
            );

            return;
        }


        var values =
            usable.map(
                function (p) {
                    return Number(p[key]);
                }
            );

        var min =
            Math.min.apply(
                null,
                values
            );

        var max =
            Math.max.apply(
                null,
                values
            );

        if (min === max) {
            min -= 1;
            max += 1;
        }


        var paddingLeft = 42;
        var paddingRight = 14;
        var paddingTop = 18;
        var paddingBottom = 34;

        var plotWidth =
            width -
            paddingLeft -
            paddingRight;

        var plotHeight =
            height -
            paddingTop -
            paddingBottom;


        ctx.strokeStyle =
            "#1B261E";

        ctx.lineWidth = 1;


        for (var grid = 0; grid <= 4; grid++) {

            var y =
                paddingTop +
                plotHeight *
                grid /
                4;

            ctx.beginPath();

            ctx.moveTo(
                paddingLeft,
                y
            );

            ctx.lineTo(
                width -
                paddingRight,
                y
            );

            ctx.stroke();


            var gridValue =
                max -
                (max - min) *
                grid /
                4;

            ctx.fillStyle =
                "#647168";

            ctx.font =
                "9px sans-serif";

            ctx.textAlign =
                "right";

            ctx.fillText(
                gridValue.toFixed(1),
                paddingLeft - 7,
                y + 3
            );
        }


        var coords =
            usable.map(
                function (point, index) {

                    var x =
                        usable.length === 1
                            ? paddingLeft +
                              plotWidth / 2
                            : paddingLeft +
                              plotWidth *
                              index /
                              (usable.length - 1);

                    var value =
                        Number(
                            point[key]
                        );

                    var y =
                        paddingTop +
                        (
                            1 -
                            (
                                value - min
                            ) /
                            (
                                max - min
                            )
                        ) *
                        plotHeight;

                    return {
                        x: x,
                        y: y,
                        point: point,
                        value: value
                    };
                }
            );


        ctx.strokeStyle =
            strokeColor;

        ctx.lineWidth = 2.5;

        ctx.beginPath();

        coords.forEach(
            function (coord, index) {

                if (index === 0) {
                    ctx.moveTo(
                        coord.x,
                        coord.y
                    );
                } else {
                    ctx.lineTo(
                        coord.x,
                        coord.y
                    );
                }
            }
        );

        ctx.stroke();


        coords.forEach(
            function (coord) {

                ctx.beginPath();

                ctx.arc(
                    coord.x,
                    coord.y,
                    4,
                    0,
                    Math.PI * 2
                );

                ctx.fillStyle =
                    strokeColor;

                ctx.fill();


                ctx.fillStyle =
                    "#738078";

                ctx.font =
                    "8px sans-serif";

                ctx.textAlign =
                    "center";

                ctx.fillText(
                    coord.point.label,
                    coord.x,
                    height - 10
                );
            }
        );
    }


    function updateClient() {

        var client =
            findClient(
                select.value
            );


        document.getElementById(
            "htprSelectedName"
        ).textContent =
            client.name;

        document.getElementById(
            "htprSelectedGoal"
        ).textContent =
            client.goal;

        document.getElementById(
            "htprSelectedWeight"
        ).textContent =
            client.weight;

        document.getElementById(
            "htprSelectedBmi"
        ).textContent =
            client.bmi;

        document.getElementById(
            "htprSelectedActive"
        ).textContent =
            client.activeGoals;

        document.getElementById(
            "htprSelectedCompleted"
        ).textContent =
            client.completedGoals;

        document.getElementById(
            "htprSelectedMeasurements"
        ).textContent =
            client.measurementCount;

        document.getElementById(
            "htprSelectedRecorded"
        ).textContent =
            client.lastRecorded;


        var progress =
            Math.max(
                0,
                Math.min(
                    100,
                    Number(
                        client.progress || 0
                    )
                )
            );

        document.getElementById(
            "htprProgressValue"
        ).textContent =
            Math.round(progress) +
            "%";

        document.getElementById(
            "htprProgressRing"
        ).style.setProperty(
            "--angle",
            (
                progress /
                100 *
                360
            ) +
            "deg"
        );


        drawChart(
            weightCanvas,
            client.trend || [],
            "weight",
            "kg",
            "#22C55E"
        );

        drawChart(
            bmiCanvas,
            client.trend || [],
            "bmi",
            "",
            "#3B82F6"
        );
    }


    select.addEventListener(
        "change",
        updateClient
    );


    var search =
        document.getElementById(
            "htprSearch"
        );

    var cards =
        Array.prototype.slice.call(
            document.querySelectorAll(
                ".htpr-client-card"
            )
        );

    var noResults =
        document.getElementById(
            "htprNoResults"
        );


    if (search) {

        search.addEventListener(
            "input",
            function () {

                var term =
                    search.value
                        .trim()
                        .toLowerCase();

                var visible = 0;

                cards.forEach(
                    function (card) {

                        var text =
                            card.getAttribute(
                                "data-search"
                            ) || "";

                        var show =
                            !term ||
                            text.indexOf(
                                term
                            ) !== -1;

                        card.style.display =
                            show
                                ? ""
                                : "none";

                        if (show) {
                            visible++;
                        }
                    }
                );


                if (noResults) {
                    noResults.style.display =
                        visible === 0
                            ? "block"
                            : "none";
                }
            }
        );
    }


    var resizeTimer;

    window.addEventListener(
        "resize",
        function () {

            clearTimeout(
                resizeTimer
            );

            resizeTimer =
                setTimeout(
                    updateClient,
                    150
                );
        }
    );


    updateClient();

})();
</script>

}