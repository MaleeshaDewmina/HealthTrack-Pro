@model HealthTrackPro.Web.Areas.Trainer.Models.ProgressReportViewModel

@using System.Linq
@using System.Web.Script.Serialization

@{
    ViewBag.Title = "Progress Report";

    var serializer =
        new JavaScriptSerializer();

    var chartClients =
        Model.Clients.Select(
            c => new
            {
                id = c.ClientUserId,
                name = c.ClientName,
                goal = c.Goal,
                weight = c.CurrentWeight,
                bmi = c.Bmi,
                lastRecorded = c.LastRecorded,
                activeGoals = c.ActiveGoals,
                completedGoals = c.CompletedGoals,
                totalGoals = c.TotalGoals,
                progress = c.AverageGoalProgressValue,
                measurementCount = c.MeasurementCount,

                trend =
                    c.Trend.Select(
                        p => new
                        {
                            label = p.Label,
                            weight = p.WeightKg,
                            bmi = p.Bmi,
                            steps = p.Steps
                        }
                    )
            }
        );

    var chartJson =
        serializer.Serialize(chartClients);
}

<style>
    .htpr-page {
        max-width: 1450px;
        margin: 0 auto;
    }

    .htpr-hero {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 22px;
    }

    .htpr-heading {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .htpr-heading-icon {
        display: flex;
        width: 48px;
        height: 48px;
        align-items: center;
        justify-content: center;
        flex: 0 0 48px;
        border: 1px solid rgba(74,222,128,.14);
        border-radius: 14px;
        background:
            linear-gradient(
                145deg,
                rgba(34,197,94,.18),
                rgba(34,197,94,.06)
            );
        color: #4ADE80;
    }

    .htpr-heading-icon svg {
        width: 24px;
        height: 24px;
        fill: currentColor;
    }

    .htpr-hero h2 {
        margin: 0 0 5px;
        color: #F4F7F5;
        font-size: 27px;
        font-weight: 800;
        letter-spacing: -.4px;
    }

    .htpr-hero p {
        margin: 0;
        color: #829087;
        font-size: 12px;
    }

    .htpr-generated {
        padding: 11px 14px;
        border: 1px solid #203026;
        border-radius: 10px;
        background: #101612;
        color: #C8D1CB;
        font-size: 10px;
        font-weight: 800;
    }

    .htpr-summary {
        display: grid;
        grid-template-columns:
            repeat(4,minmax(0,1fr));
        gap: 12px;
        margin-bottom: 18px;
    }

    .htpr-stat {
        position: relative;
        overflow: hidden;
        padding: 17px;
        border: 1px solid #1F2A22;
        border-radius: 13px;
