@model HealthTrackPro.Web.Areas.Trainer.Models.DietPlanDetailsViewModel

@{
    ViewBag.Title = "Diet Plan Details";
}

<div class="ht-card">
    <a href="@Url.Action("Index", "DietPlans", new { area = "Trainer" })">&larr; Back to diet plans</a>
    <h2 class="ht-card-title" style="margin-top:12px;">@Model.PlanName</h2>
    <p>
        <strong>Client:</strong> @Model.ClientName<br />
        <strong>Dates:</strong> @Model.Dates<br />
        <strong>Target:</strong> @Model.Targets<br />
        <strong>Status:</strong> @(Model.IsActive ? "Active" : "Inactive")
    </p>

    @if (TempData["SuccessMessage"] != null) { <div class="alert alert-success">@TempData["SuccessMessage"]</div> }
@if (TempData["ErrorMessage"] != null) { <div class="alert alert-danger">@TempData["ErrorMessage"]</div> }
</div>

<div class="ht-card">
    <h3 class="ht-card-title">Meals</h3>
    @if (Model.Meals.Count == 0)
    {
        <p class="text-muted">No meals added yet.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr><th>Order</th><th>Meal</th><th>Name</th><th>Calories</th><th>Protein (g)</th><th>Carbs (g)</th><th>Fat (g)</th><th>Notes</th></tr>
                </thead>
                <tbody>
                @foreach (var meal in Model.Meals)
                {
                    <tr>
                        <td>@meal.DisplayOrder</td>
                        <td>@meal.MealType</td>
                        <td>@meal.Name</td>
                        <td>@meal.Calories</td>
                        <td>@(meal.ProteinGrams.HasValue ? meal.ProteinGrams.Value.ToString("0.#") : "-")</td>
                        <td>@(meal.CarbohydrateGrams.HasValue ? meal.CarbohydrateGrams.Value.ToString("0.#") : "-")</td>
                        <td>@(meal.FatGrams.HasValue ? meal.FatGrams.Value.ToString("0.#") : "-")</td>
                        <td>@meal.Description</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="ht-card">
    <h3 class="ht-card-title">Add a meal</h3>
    @using (Html.BeginForm("AddMeal", "DietPlans", new { area = "Trainer" }, FormMethod.Post, new { @class = "form-horizontal" }))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @Html.HiddenFor(m => m.MealForm.DietPlanId)

        <div class="form-group">
            @Html.LabelFor(m => m.MealForm.MealType, new { @class = "col-md-3 control-label" })
            <div class="col-md-9">
                @Html.DropDownListFor(m => m.MealForm.MealType, Model.MealForm.MealTypes, "Select a meal", new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.MealForm.MealType, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.MealForm.Name, new { @class = "col-md-3 control-label" })
            <div class="col-md-9">
                @Html.TextBoxFor(m => m.MealForm.Name, new { @class = "form-control", placeholder = "e.g. Oats with banana" })
                @Html.ValidationMessageFor(m => m.MealForm.Name, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.MealForm.Description, new { @class = "col-md-3 control-label" })
            <div class="col-md-9">
                @Html.TextAreaFor(m => m.MealForm.Description, new { @class = "form-control", rows = 2 })
                @Html.ValidationMessageFor(m => m.MealForm.Description, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.MealForm.Calories, new { @class = "col-md-3 control-label" })
            <div class="col-md-9">
                @Html.TextBoxFor(m => m.MealForm.Calories, new { @class = "form-control", type = "number", min = 0, max = 10000 })
                @Html.ValidationMessageFor(m => m.MealForm.Calories, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.MealForm.ProteinGrams, new { @class = "col-md-3 control-label" })
            <div class="col-md-9">
                @Html.TextBoxFor(m => m.MealForm.ProteinGrams, new { @class = "form-control", type = "number", step = "0.1", min = 0 })
                @Html.ValidationMessageFor(m => m.MealForm.ProteinGrams, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.MealForm.CarbohydrateGrams, new { @class = "col-md-3 control-label" })
            <div class="col-md-9">
                @Html.TextBoxFor(m => m.MealForm.CarbohydrateGrams, new { @class = "form-control", type = "number", step = "0.1", min = 0 })
                @Html.ValidationMessageFor(m => m.MealForm.CarbohydrateGrams, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.MealForm.FatGrams, new { @class = "col-md-3 control-label" })
            <div class="col-md-9">
                @Html.TextBoxFor(m => m.MealForm.FatGrams, new { @class = "form-control", type = "number", step = "0.1", min = 0 })
                @Html.ValidationMessageFor(m => m.MealForm.FatGrams, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.MealForm.DisplayOrder, new { @class = "col-md-3 control-label" })
            <div class="col-md-9">
                @Html.TextBoxFor(m => m.MealForm.DisplayOrder, new { @class = "form-control", type = "number", min = 1, max = 100 })
                @Html.ValidationMessageFor(m => m.MealForm.DisplayOrder, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-offset-3 col-md-9">
                <button type="submit" class="btn btn-success">Add meal</button>
            </div>
        </div>
    }
</div>
