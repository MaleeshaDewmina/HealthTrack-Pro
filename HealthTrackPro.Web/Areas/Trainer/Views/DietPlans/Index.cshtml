@model HealthTrackPro.Web.Areas.Trainer.Models.DietPlanIndexViewModel
@using System.Linq

@{
    ViewBag.Title = "Diet Plans";

    var activeCount = Model.Plans.Count(p => p.IsActive);
    var inactiveCount = Model.Plans.Count - activeCount;
}

<style>
    .htdi-page {
        max-width: 1450px;
        margin: 0 auto;
    }

    .htdi-hero {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 22px;
    }

    .htdi-heading {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .htdi-heading-icon {
        display: flex;
        width: 48px;
        height: 48px;
        align-items: center;
        justify-content: center;
        flex: 0 0 48px;
        border: 1px solid rgba(74,222,128,.14);
        border-radius: 14px;
        background:
            linear-gradient(
                145deg,
                rgba(34,197,94,.18),
                rgba(34,197,94,.06)
            );
        color: #4ADE80;
    }

    .htdi-heading-icon svg {
        width: 24px;
        height: 24px;
        fill: currentColor;
    }

    .htdi-hero h2 {
        margin: 0 0 5px;
        color: #F4F7F5;
        font-size: 27px;
        font-weight: 800;
        letter-spacing: -.4px;
    }

    .htdi-hero p {
        margin: 0;
        color: #829087;
        font-size: 12px;
    }

    .htdi-create {
        display: inline-flex;
        min-height: 45px;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 0 18px;
        border-radius: 10px;
        background:
            linear-gradient(
                135deg,
                #22C55E,
                #16A34A
            );
        color: #061009 !important;
        font-size: 12px;
        font-weight: 900;
        text-decoration: none !important;
        box-shadow:
            0 10px 24px
            rgba(34,197,94,.13);
    }

    .htdi-create:hover {
        transform: translateY(-1px);
    }

    .htdi-summary {
        display: grid;
        grid-template-columns:
            repeat(3,minmax(0,1fr));
        gap: 13px;
        margin-bottom: 18px;
    }

    .htdi-stat {
        position: relative;
        overflow: hidden;
        padding: 17px;
        border: 1px solid #1F2A22;
        border-radius: 13px;
        background:
            radial-gradient(
                circle at 100% 0,
                rgba(34,197,94,.08),
                transparent 48%
            ),
            #101612;
    }

    .htdi-stat-label {
        display: block;
        margin-bottom: 8px;
        color: #68766D;
        font-size: 9px;
        font-weight: 900;
        letter-spacing: .8px;
        text-transform: uppercase;
    }

    .htdi-stat-value {
        color: #F1F5F2;
        font-size: 25px;
        font-weight: 900;
    }

    .htdi-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        margin-bottom: 17px;
        padding: 13px;
        border: 1px solid #1F2A22;
        border-radius: 12px;
        background: #101612;
    }

    .htdi-search {
        width: 100%;
        max-width: 420px;
        height: 42px;
        padding: 10px 13px;
        border: 1px solid #26332A;
        border-radius: 9px;
        outline: none;
        background: #0C120E;
        color: #EEF3EF;
    }

    .htdi-search:focus {
        border-color: #22C55E;
        box-shadow:
            0 0 0 3px
            rgba(34,197,94,.10);
    }

    .htdi-filters {
        display: flex;
        gap: 6px;
    }

    .htdi-filter {
        min-height: 38px;
        padding: 0 13px;
        border: 1px solid #26332A;
        border-radius: 8px;
        background: #0D130F;
        color: #8C9990;
        font-size: 10px;
        font-weight: 800;
        cursor: pointer;
    }

    .htdi-filter.active {
        border-color: #285C39;
        background:
            rgba(34,197,94,.12);
        color: #4ADE80;
    }

    .htdi-alert {
        margin-bottom: 17px;
        padding: 12px 14px;
        border-radius: 10px;
        font-size: 11px;
        font-weight: 700;
    }

    .htdi-alert-success {
        border:
            1px solid
            rgba(34,197,94,.22);
        background:
            rgba(34,197,94,.08);
        color: #86EFAC;
    }

    .htdi-alert-danger {
        border:
            1px solid
            rgba(239,68,68,.22);
        background:
            rgba(239,68,68,.08);
        color: #FCA5A5;
    }

    .htdi-grid {
        display: grid;
        grid-template-columns:
            repeat(3,minmax(0,1fr));
        gap: 15px;
    }

    .htdi-plan {
        position: relative;
        overflow: hidden;
        min-height: 330px;
        border: 1px solid #1F2A22;
        border-radius: 14px;
        background:
            radial-gradient(
                circle at 100% 0,
                rgba(34,197,94,.08),
                transparent 48%
            ),
            #101612;
        transition: .2s ease;
    }

    .htdi-plan:hover {
        transform: translateY(-2px);
        border-color: #2B4934;
        box-shadow:
            0 15px 30px
            rgba(0,0,0,.15);
    }

    .htdi-plan-head {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 12px;
        padding: 18px;
        border-bottom:
            1px solid #1B251E;
    }

    .htdi-plan-icon {
        display: flex;
        width: 39px;
        height: 39px;
        align-items: center;
        justify-content: center;
        margin-bottom: 12px;
        border-radius: 10px;
        background:
            rgba(34,197,94,.11);
        color: #4ADE80;
    }

    .htdi-plan-icon svg {
        width: 19px;
        height: 19px;
        fill: currentColor;
    }

    .htdi-plan-name {
        margin: 0;
        color: #EEF3EF;
        font-size: 15px;
        font-weight: 900;
        line-height: 1.35;
    }

    .htdi-status {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 5px 8px;
        border-radius: 999px;
        font-size: 8px;
        font-weight: 900;
        letter-spacing: .5px;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .htdi-status-active {
        background:
            rgba(34,197,94,.12);
        color: #4ADE80;
    }

    .htdi-status-inactive {
        background:
            rgba(245,158,11,.10);
        color: #FBBF24;
    }

    .htdi-dot {
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: currentColor;
    }

    .htdi-plan-body {
        padding: 16px 18px 18px;
    }

    .htdi-calorie {
        margin-bottom: 12px;
        padding: 14px;
        border:
            1px solid #1E3225;
        border-radius: 11px;
        background:
            linear-gradient(
                145deg,
                #10261A,
                #0D150F
            );
    }

    .htdi-calorie-label {
        display: block;
        margin-bottom: 6px;
        color: #7A8C80;
        font-size: 8px;
        font-weight: 900;
        letter-spacing: .7px;
        text-transform: uppercase;
    }

    .htdi-calorie-value {
        color: #F1F6F2;
        font-size: 20px;
        font-weight: 900;
    }

    .htdi-meta {
        display: grid;
        gap: 10px;
        margin-bottom: 15px;
    }

    .htdi-meta-item {
        padding: 11px 12px;
        border: 1px solid #1C2720;
        border-radius: 9px;
        background: #0D130F;
    }

    .htdi-meta-label {
        display: block;
        margin-bottom: 4px;
        color: #637068;
        font-size: 8px;
        font-weight: 900;
        letter-spacing: .7px;
        text-transform: uppercase;
    }

    .htdi-meta-value {
        color: #DDE5DF;
        font-size: 11px;
        font-weight: 800;
        line-height: 1.45;
    }

    .htdi-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 8px;
        margin-top: 4px;
    }

    .htdi-view {
        display: inline-flex;
        min-height: 37px;
        align-items: center;
        justify-content: center;
        padding: 0 13px;
        border:
            1px solid #285C39;
        border-radius: 8px;
        background:
            rgba(34,197,94,.10);
        color: #4ADE80 !important;
        font-size: 10px;
        font-weight: 900;
        text-decoration: none !important;
    }

    .htdi-view:hover {
        background:
            rgba(34,197,94,.16);
    }

    .htdi-action-form {
        margin: 0;
    }

    .htdi-toggle {
        min-height: 37px;
        padding: 0 13px;
        border: 1px solid #2A382E;
        border-radius: 8px;
        background: #121A14;
        color: #C4CDC7;
        font-size: 10px;
        font-weight: 800;
    }

    .htdi-toggle:hover {
        border-color: #3A5742;
        color: #4ADE80;
    }

    .htdi-empty {
        grid-column: 1 / -1;
        padding: 65px 25px;
        border: 1px dashed #28352C;
        border-radius: 14px;
        background: #0E140F;
        text-align: center;
    }

    .htdi-empty-icon {
        display: flex;
        width: 60px;
        height: 60px;
        align-items: center;
        justify-content: center;
        margin: 0 auto 15px;
        border-radius: 16px;
        background:
            rgba(34,197,94,.08);
        color: #4ADE80;
    }

    .htdi-empty-icon svg {
        width: 28px;
        height: 28px;
        fill: currentColor;
    }

    .htdi-empty h3 {
        margin: 0 0 7px;
        font-size: 17px;
        font-weight: 800;
    }

    .htdi-empty p {
        max-width: 460px;
        margin: 0 auto 17px;
        color: #748078;
        font-size: 11px;
    }

    .htdi-no-results {
        display: none;
        margin-top: 18px;
        padding: 35px;
        border: 1px dashed #28352C;
        border-radius: 12px;
        text-align: center;
        color: #758178;
        font-size: 11px;
    }

    @@media (max-width: 1150px) {
        .htdi-grid {
            grid-template-columns:
                repeat(2,minmax(0,1fr));
        }
    }

    @@media (max-width: 750px) {
        .htdi-hero,
        .htdi-toolbar {
            flex-direction: column;
            align-items: stretch;
        }

        .htdi-create {
            width: 100%;
        }

        .htdi-summary,
        .htdi-grid {
            grid-template-columns: 1fr;
        }

        .htdi-search {
            max-width: none;
        }

        .htdi-filters {
            overflow-x: auto;
        }

        .htdi-actions {
            flex-direction: column;
            align-items: stretch;
        }

        .htdi-view,
        .htdi-toggle {
            width: 100%;
        }
    }
</style>


<div class="htdi-page">

    <div class="htdi-hero">

        <div class="htdi-heading">

            <div class="htdi-heading-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M7 2v7H5V2H3v7a4 4 0 0 0 3 3.87V22h2v-9.13A4 4 0 0 0 11 9V2H9v7H7V2Zm9 0c-2.2 0-4 2.7-4 6 0 2.7 1.2 5 3 5.7V22h2v-8.3c1.8-.7 3-3 3-5.7 0-3.3-1.8-6-4-6Z"/>
                </svg>
            </div>

            <div>
                <h2>Diet Plans</h2>
                <p>
                    Manage personalized nutrition plans,
                    calorie targets and client meals.
                </p>
            </div>

        </div>

        <a
            class="htdi-create"
            href="@Url.Action(
                "Create",
                "DietPlans",
                new { area = "Trainer" })">
            + Create diet plan
        </a>

    </div>


    @if (TempData["SuccessMessage"] != null)
    {
        <div class="htdi-alert htdi-alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="htdi-alert htdi-alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }


    <div class="htdi-summary">

        <div class="htdi-stat">

            <span class="htdi-stat-label">
                Total plans
            </span>

            <span class="htdi-stat-value">
                @Model.Plans.Count
            </span>

        </div>

        <div class="htdi-stat">

            <span class="htdi-stat-label">
                Active plans
            </span>

            <span class="htdi-stat-value">
                @activeCount
            </span>

        </div>

        <div class="htdi-stat">

            <span class="htdi-stat-label">
                Inactive plans
            </span>

            <span class="htdi-stat-value">
                @inactiveCount
            </span>

        </div>

    </div>


    @if (Model.Plans.Count > 0)
    {
        <div class="htdi-toolbar">

            <input
                id="htdiSearch"
                class="htdi-search"
                type="search"
                placeholder="Search by client, plan or target..." />

            <div class="htdi-filters">

                <button
                    type="button"
                    class="htdi-filter active"
                    data-filter="all">
                    All
                </button>

                <button
                    type="button"
                    class="htdi-filter"
                    data-filter="active">
                    Active
                </button>

                <button
                    type="button"
                    class="htdi-filter"
                    data-filter="inactive">
                    Inactive
                </button>

            </div>

        </div>
    }


    <div
        id="htdiGrid"
        class="htdi-grid">

        @if (Model.Plans.Count == 0)
        {
            <div class="htdi-empty">

                <div class="htdi-empty-icon">

                    <svg
                        viewBox="0 0 24 24"
                        aria-hidden="true">
                        <path d="M7 2v7H5V2H3v7a4 4 0 0 0 3 3.87V22h2v-9.13A4 4 0 0 0 11 9V2H9v7H7V2Zm9 0c-2.2 0-4 2.7-4 6 0 2.7 1.2 5 3 5.7V22h2v-8.3c1.8-.7 3-3 3-5.7 0-3.3-1.8-6-4-6Z"/>
                    </svg>

                </div>

                <h3>No diet plans yet</h3>

                <p>
                    Create your first personalized nutrition plan
                    for one of your assigned clients.
                </p>

                <a
                    class="htdi-create"
                    href="@Url.Action(
                        "Create",
                        "DietPlans",
                        new { area = "Trainer" })">
                    + Create first diet plan
                </a>

            </div>
        }
        else
        {
            foreach (var plan in Model.Plans)
            {
                var state =
                    plan.IsActive
                        ? "active"
                        : "inactive";

                var searchText =
                    (
                        plan.ClientName +
                        " " +
                        plan.PlanName +
                        " " +
                        plan.Targets
                    ).ToLowerInvariant();

                <article
                    class="htdi-plan"
                    data-status="@state"
                    data-search="@searchText">

                    <div class="htdi-plan-head">

                        <div>

                            <div class="htdi-plan-icon">

                                <svg
                                    viewBox="0 0 24 24"
                                    aria-hidden="true">
                                    <path d="M7 2v7H5V2H3v7a4 4 0 0 0 3 3.87V22h2v-9.13A4 4 0 0 0 11 9V2H9v7H7V2Zm9 0c-2.2 0-4 2.7-4 6 0 2.7 1.2 5 3 5.7V22h2v-8.3c1.8-.7 3-3 3-5.7 0-3.3-1.8-6-4-6Z"/>
                                </svg>

                            </div>

                            <h3 class="htdi-plan-name">
                                @plan.PlanName
                            </h3>

                        </div>

                        <span
                            class="htdi-status @(plan.IsActive ? "htdi-status-active" : "htdi-status-inactive")">

                            <span class="htdi-dot"></span>

                            @(plan.IsActive
                                ? "Active"
                                : "Inactive")

                        </span>

                    </div>


                    <div class="htdi-plan-body">

                        <div class="htdi-calorie">

                            <span class="htdi-calorie-label">
                                Nutrition target
                            </span>

                            <span class="htdi-calorie-value">
                                @plan.Targets
                            </span>

                        </div>


                        <div class="htdi-meta">

                            <div class="htdi-meta-item">

                                <span class="htdi-meta-label">
                                    Client
                                </span>

                                <span class="htdi-meta-value">
                                    @plan.ClientName
                                </span>

                            </div>


                            <div class="htdi-meta-item">

                                <span class="htdi-meta-label">
                                    Plan duration
                                </span>

                                <span class="htdi-meta-value">
                                    @plan.Dates
                                </span>

                            </div>

                        </div>


                        <div class="htdi-actions">

                            <a
                                class="htdi-view"
                                href="@Url.Action(
                                    "Details",
                                    "DietPlans",
                                    new
                                    {
                                        area = "Trainer",
                                        id = plan.DietPlanId
                                    })">
                                View meals &amp; details
                            </a>


                            <form
                                class="htdi-action-form"
                                method="post"
                                action="@Url.Action(
                                    "SetActive",
                                    "DietPlans",
                                    new { area = "Trainer" })">

                                @Html.AntiForgeryToken()

                                <input
                                    type="hidden"
                                    name="id"
                                    value="@plan.DietPlanId" />

                                <input
                                    type="hidden"
                                    name="isActive"
                                    value="@(!plan.IsActive)" />

                                <button
                                    type="submit"
                                    class="htdi-toggle">

                                    @(plan.IsActive
                                        ? "Deactivate"
                                        : "Activate")

                                </button>

                            </form>

                        </div>

                    </div>

                </article>
            }
        }

    </div>


    @if (Model.Plans.Count > 0)
    {
        <div
            id="htdiNoResults"
            class="htdi-no-results">
            No diet plans match your search or filter.
        </div>
    }

</div>


@section scripts {

<script>
(function () {

    "use strict";

    var search =
        document.getElementById(
            "htdiSearch"
        );

    var cards =
        Array.prototype.slice.call(
            document.querySelectorAll(
                ".htdi-plan"
            )
        );

    var buttons =
        Array.prototype.slice.call(
            document.querySelectorAll(
                ".htdi-filter"
            )
        );

    var empty =
        document.getElementById(
            "htdiNoResults"
        );

    if (!search || cards.length === 0) {
        return;
    }

    var currentFilter = "all";


    function refresh() {

        var term =
            search.value
                .trim()
                .toLowerCase();

        var visible = 0;

        cards.forEach(function (card) {

            var status =
                card.getAttribute(
                    "data-status"
                );

            var searchable =
                card.getAttribute(
                    "data-search"
                ) || "";

            var matchesFilter =
                currentFilter === "all" ||
                status === currentFilter;

            var matchesSearch =
                !term ||
                searchable.indexOf(term) !== -1;

            var show =
                matchesFilter &&
                matchesSearch;

            card.style.display =
                show ? "" : "none";

            if (show) {
                visible++;
            }
        });


        if (empty) {

            empty.style.display =
                visible === 0
                    ? "block"
                    : "none";
        }
    }


    buttons.forEach(function (button) {

        button.addEventListener(
            "click",
            function () {

                currentFilter =
                    button.getAttribute(
                        "data-filter"
                    );

                buttons.forEach(
                    function (item) {

                        item.classList.remove(
                            "active"
                        );
                    }
                );

                button.classList.add(
                    "active"
                );

                refresh();
            }
        );
    });


    search.addEventListener(
        "input",
        refresh
    );

})();
</script>

}