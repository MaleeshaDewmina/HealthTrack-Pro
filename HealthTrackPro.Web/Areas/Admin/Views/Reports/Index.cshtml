@model HealthTrackPro.Web.Areas.Admin.Models.AdminReportsViewModel

@{
    ViewBag.Title = "Reports & Analytics";
}

<style>
    .har-page {
        max-width: 1500px;
        margin: 0 auto;
    }

    .har-hero {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 20px;
        padding: 24px;
        border: 1px solid #203027;
        border-radius: 17px;
        background:
            radial-gradient(
                circle at 92% 5%,
                rgba(34,197,94,.14),
                transparent 35%
            ),
            #101712;
    }

    .har-hero h1 {
        margin: 0 0 7px;
        color: #f2f6f3;
        font-size: 29px;
        font-weight: 900;
    }

    .har-hero p {
        margin: 0;
        color: #849188;
        font-size: 11px;
    }

    .har-badge {
        padding: 7px 10px;
        border-radius: 999px;
        background: rgba(34,197,94,.10);
        color: #4ade80;
        font-size: 8px;
        font-weight: 900;
        text-transform: uppercase;
    }

    .har-kpis {
        display: grid;
        grid-template-columns:
            repeat(5, minmax(0, 1fr));
        gap: 11px;
        margin-bottom: 15px;
    }

    .har-kpi {
        padding: 17px;
        border: 1px solid #1f2d24;
        border-radius: 13px;
        background: #101712;
    }

    .har-kpi span {
        display: block;
        margin-bottom: 7px;
        color: #718078;
        font-size: 8px;
        font-weight: 900;
        text-transform: uppercase;
    }

    .har-kpi strong {
        display: block;
        color: #f3f7f4;
        font-size: 25px;
        font-weight: 900;
    }

    .har-kpi small {
        color: #748178;
        font-size: 8px;
    }

    .har-progress-grid {
        display: grid;
        grid-template-columns:
            repeat(3, 1fr);
        gap: 11px;
        margin-bottom: 15px;
    }

    .har-progress-card {
        padding: 17px;
        border: 1px solid #1f2d24;
        border-radius: 13px;
        background: #101712;
    }

    .har-progress-head {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 11px;
        color: #b9c4bc;
        font-size: 9px;
        font-weight: 800;
    }

    .har-progress-head strong {
        color: #4ade80;
    }

    .har-track {
        overflow: hidden;
        height: 7px;
        border-radius: 999px;
        background: #1a261e;
    }

    .har-fill {
        height: 100%;
        border-radius: 999px;
        background:
            linear-gradient(
                90deg,
                #166534,
                #22c55e,
                #4ade80
            );
    }

    .har-charts {
        display: grid;
        grid-template-columns:
            repeat(3, minmax(0, 1fr));
        gap: 13px;
        margin-bottom: 15px;
    }

    .har-panel {
        border: 1px solid #1f2d24;
        border-radius: 14px;
        background: #101712;
    }

    .har-panel-head {
        padding: 17px 17px 0;
    }

    .har-panel-head h3 {
        margin: 0 0 4px;
        color: #edf3ef;
        font-size: 13px;
        font-weight: 900;
    }

    .har-panel-head p {
        margin: 0;
        color: #748178;
        font-size: 8px;
    }

    .har-chart {
        height: 275px;
        padding: 13px 15px 17px;
    }

    .har-chart canvas {
        width: 100% !important;
        height: 100% !important;
    }

    .har-groups {
        display: grid;
        grid-template-columns:
            repeat(4, minmax(0, 1fr));
        gap: 12px;
    }

    .har-group {
        padding: 17px;
        border: 1px solid #1f2d24;
        border-radius: 13px;
        background: #101712;
    }

    .har-group h3 {
        margin: 0 0 14px;
        color: #eef3ef;
        font-size: 12px;
        font-weight: 900;
    }

    .har-row {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        padding: 9px 0;
        border-bottom: 1px solid #1d2921;
        color: #829087;
        font-size: 9px;
    }

    .har-row:last-child {
        border-bottom: 0;
    }

    .har-row strong {
        color: #e5ece7;
    }

    @@media (max-width: 1200px) {
        .har-kpis {
            grid-template-columns:
                repeat(3, 1fr);
        }

        .har-charts {
            grid-template-columns: 1fr;
        }

        .har-groups {
            grid-template-columns:
                repeat(2, 1fr);
        }
    }

    @@media (max-width: 760px) {
        .har-hero {
            flex-direction: column;
            align-items: flex-start;
        }

        .har-kpis,
        .har-progress-grid,
        .har-groups {
            grid-template-columns: 1fr;
        }
    }
</style>


<div class="har-page">

    <section class="har-hero">

        <div>
            <h1>Reports & Analytics</h1>

            <p>
                System-wide activity, engagement,
                progress and operational statistics.
            </p>
        </div>

        <span class="har-badge">
            Live database data
        </span>

    </section>


    <section class="har-kpis">

        <div class="har-kpi">
            <span>Registered clients</span>
            <strong>@Model.TotalClients</strong>
            <small>Client profiles</small>
        </div>

        <div class="har-kpi">
            <span>Registered trainers</span>
            <strong>@Model.TotalTrainers</strong>
            <small>Trainer profiles</small>
        </div>

        <div class="har-kpi">
            <span>Active assignments</span>
            <strong>@Model.ActiveAssignments</strong>
            <small>Trainer / Client links</small>
        </div>

        <div class="har-kpi">
            <span>Total appointments</span>
            <strong>@Model.TotalAppointments</strong>
            <small>All workflow states</small>
        </div>

        <div class="har-kpi">
            <span>Health measurements</span>
            <strong>@Model.HealthMeasurements</strong>
            <small>Progress records</small>
        </div>

    </section>


    <section class="har-progress-grid">

        <div class="har-progress-card">

            <div class="har-progress-head">
                <span>Trainer assignment coverage</span>
                <strong>
                    @Model.AssignmentCoveragePercentage%
                </strong>
            </div>

            <div class="har-track">
                <div
                    class="har-fill"
                    style="width:@Model.AssignmentCoveragePercentage%;">
                </div>
            </div>

        </div>


        <div class="har-progress-card">

            <div class="har-progress-head">
                <span>Goal completion</span>
                <strong>
                    @Model.GoalCompletionPercentage%
                </strong>
            </div>

            <div class="har-track">
                <div
                    class="har-fill"
                    style="width:@Model.GoalCompletionPercentage%;">
                </div>
            </div>

        </div>


        <div class="har-progress-card">

            <div class="har-progress-head">
                <span>Appointment completion</span>
                <strong>
                    @Model.AppointmentCompletionPercentage%
                </strong>
            </div>

            <div class="har-track">
                <div
                    class="har-fill"
                    style="width:@Model.AppointmentCompletionPercentage%;">
                </div>
            </div>

        </div>

    </section>


    <section class="har-charts">

        <article class="har-panel">

            <div class="har-panel-head">
                <h3>Appointment Workflow</h3>
                <p>
                    Current status distribution.
                </p>
            </div>

            <div class="har-chart">
                <canvas id="harAppointmentChart"></canvas>
            </div>

        </article>


        <article class="har-panel">

            <div class="har-panel-head">
                <h3>Workout & Nutrition Activity</h3>
                <p>
                    Plans compared with logged activity.
                </p>
            </div>

            <div class="har-chart">
                <canvas id="harActivityChart"></canvas>
            </div>

        </article>


        <article class="har-panel">

            <div class="har-panel-head">
                <h3>Progress & Communication</h3>
                <p>
                    Goals, measurements and notifications.
                </p>
            </div>

            <div class="har-chart">
                <canvas id="harProgressChart"></canvas>
            </div>

        </article>

    </section>


    <section class="har-groups">

        <article class="har-group">
            <h3>User Overview</h3>

            <div class="har-row">
                <span>Clients</span>
                <strong>@Model.TotalClients</strong>
            </div>

            <div class="har-row">
                <span>Trainers</span>
                <strong>@Model.TotalTrainers</strong>
            </div>

            <div class="har-row">
                <span>Unassigned clients</span>
                <strong>@Model.UnassignedClients</strong>
            </div>

            <div class="har-row">
                <span>Suspended users</span>
                <strong>@Model.SuspendedUsers</strong>
            </div>
        </article>


        <article class="har-group">
            <h3>Workout Activity</h3>

            <div class="har-row">
                <span>Total plans</span>
                <strong>@Model.TotalWorkoutPlans</strong>
            </div>

            <div class="har-row">
                <span>Active plans</span>
                <strong>@Model.ActiveWorkoutPlans</strong>
            </div>

            <div class="har-row">
                <span>Workout logs</span>
                <strong>@Model.WorkoutLogs</strong>
            </div>
        </article>


        <article class="har-group">
            <h3>Nutrition Activity</h3>

            <div class="har-row">
                <span>Total diet plans</span>
                <strong>@Model.TotalDietPlans</strong>
            </div>

            <div class="har-row">
                <span>Active plans</span>
                <strong>@Model.ActiveDietPlans</strong>
            </div>

            <div class="har-row">
                <span>Meal logs</span>
                <strong>@Model.MealLogs</strong>
            </div>
        </article>


        <article class="har-group">
            <h3>Progress & Alerts</h3>

            <div class="har-row">
                <span>Total goals</span>
                <strong>@Model.TotalGoals</strong>
            </div>

            <div class="har-row">
                <span>Completed goals</span>
                <strong>@Model.CompletedGoals</strong>
            </div>

            <div class="har-row">
                <span>Notifications</span>
                <strong>@Model.Notifications</strong>
            </div>

            <div class="har-row">
                <span>Unread</span>
                <strong>@Model.UnreadNotifications</strong>
            </div>
        </article>

    </section>

</div>


<script
    src="https://cdn.jsdelivr.net/npm/chart.js@4.4.8/dist/chart.umd.min.js">
</script>

<script>
(function () {

    "use strict";

    if (typeof Chart === "undefined") {
        return;
    }

    Chart.defaults.color = "#829087";
    Chart.defaults.borderColor =
        "rgba(111,130,118,.14)";


    new Chart(
        document.getElementById(
            "harAppointmentChart"
        ),
        {
            type: "doughnut",

            data: {
                labels: [
                    "Pending",
                    "Approved",
                    "Completed",
                    "Cancelled",
                    "Rejected"
                ],

                datasets: [{
                    data: [
                        @Model.PendingAppointments,
                        @Model.ApprovedAppointments,
                        @Model.CompletedAppointments,
                        @Model.CancelledAppointments,
                        @Model.RejectedAppointments
                    ],

                    backgroundColor: [
                        "#F59E0B",
                        "#22C55E",
                        "#4ADE80",
                        "#EF4444",
                        "#7F1D1D"
                    ],

                    borderColor: "#101712",
                    borderWidth: 4
                }]
            },

            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: "67%",

                plugins: {
                    legend: {
                        position: "bottom",

                        labels: {
                            usePointStyle: true,
                            boxWidth: 9,
                            padding: 12
                        }
                    }
                }
            }
        }
    );


    new Chart(
        document.getElementById(
            "harActivityChart"
        ),
        {
            type: "bar",

            data: {
                labels: [
                    "Workout plans",
                    "Workout logs",
                    "Diet plans",
                    "Meal logs"
                ],

                datasets: [{
                    label: "Records",

                    data: [
                        @Model.TotalWorkoutPlans,
                        @Model.WorkoutLogs,
                        @Model.TotalDietPlans,
                        @Model.MealLogs
                    ],

                    backgroundColor:
                        "rgba(34,197,94,.62)",

                    borderColor:
                        "#22C55E",

                    borderWidth: 1,
                    borderRadius: 7
                }]
            },

            options: {
                responsive: true,
                maintainAspectRatio: false,

                plugins: {
                    legend: {
                        display: false
                    }
                },

                scales: {
                    x: {
                        grid: {
                            display: false
                        }
                    },

                    y: {
                        beginAtZero: true,

                        ticks: {
                            precision: 0
                        },

                        grid: {
                            color:
                                "rgba(111,130,118,.10)"
                        }
                    }
                }
            }
        }
    );


    new Chart(
        document.getElementById(
            "harProgressChart"
        ),
        {
            type: "bar",

            data: {
                labels: [
                    "Goals",
                    "Completed",
                    "Measurements",
                    "Notifications",
                    "Unread"
                ],

                datasets: [{
                    label: "Records",

                    data: [
                        @Model.TotalGoals,
                        @Model.CompletedGoals,
                        @Model.HealthMeasurements,
                        @Model.Notifications,
                        @Model.UnreadNotifications
                    ],

                    backgroundColor:
                        "rgba(74,222,128,.58)",

                    borderColor:
                        "#4ADE80",

                    borderWidth: 1,
                    borderRadius: 7
                }]
            },

            options: {
                responsive: true,
                maintainAspectRatio: false,

                plugins: {
                    legend: {
                        display: false
                    }
                },

                scales: {
                    x: {
                        grid: {
                            display: false
                        }
                    },

                    y: {
                        beginAtZero: true,

                        ticks: {
                            precision: 0
                        },

                        grid: {
                            color:
                                "rgba(111,130,118,.10)"
                        }
                    }
                }
            }
        }
    );

})();
</script>