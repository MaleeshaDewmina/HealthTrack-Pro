@model HealthTrackPro.Web.Areas.Admin.Models.AdminReportsViewModel

@{
    ViewBag.Title = "Reports & Analytics";
}

<style>
    .har-page {
        max-width: 1500px;
        margin: 0 auto;
    }

    .har-hero {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 20px;
        padding: 24px;
        border: 1px solid var(--ht-role-tone-203027);
        border-radius: 17px;
        background:
            radial-gradient(
                circle at 92% 5%,
                rgba(34,197,94,.14),
                transparent 35%
            ),
            var(--ht-role-tone-101712);
    }

    .har-hero h1 {
        margin: 0 0 7px;
        color: #f2f6f3;
        font-size: 29px;
        font-weight: 900;
    }

    .har-hero p {
        margin: 0;
        color: #849188;
        font-size: 11px;
    }

    .har-badge {
        padding: 7px 10px;
        border-radius: 999px;
        background: rgba(34,197,94,.10);
        color: #4ade80;
        font-size: 8px;
        font-weight: 900;
        text-transform: uppercase;
    }

    .har-kpis {
        display: grid;
        grid-template-columns:
            repeat(5, minmax(0, 1fr));
        gap: 11px;
        margin-bottom: 15px;
    }

    .har-kpi {
        padding: 17px;
        border: 1px solid var(--ht-role-tone-1f2d24);
        border-radius: 13px;
        background: var(--ht-role-tone-101712);
    }

    .har-kpi span {
        display: block;
        margin-bottom: 7px;
        color: #718078;
        font-size: 8px;
        font-weight: 900;
        text-transform: uppercase;
    }

    .har-kpi strong {
        display: block;
        color: #f3f7f4;
        font-size: 25px;
        font-weight: 900;
    }

    .har-kpi small {
        color: #748178;
        font-size: 8px;
    }

    .har-progress-grid {
        display: grid;
        grid-template-columns:
            repeat(3, 1fr);
        gap: 11px;
        margin-bottom: 15px;
    }

    .har-progress-card {
        padding: 17px;
        border: 1px solid var(--ht-role-tone-1f2d24);
        border-radius: 13px;
        background: var(--ht-role-tone-101712);
    }

    .har-progress-head {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 11px;
        color: #b9c4bc;
        font-size: 9px;
        font-weight: 800;
    }

    .har-progress-head strong {
        color: #4ade80;
    }

    .har-track {
        overflow: hidden;
        height: 7px;
        border-radius: 999px;
        background: var(--ht-role-tone-1a261e);
    }

    .har-fill {
        height: 100%;
        border-radius: 999px;
        background:
            linear-gradient(
                90deg,
                #166534,
                #22c55e,
                #4ade80
            );
    }

    .har-charts {
        display: grid;
        grid-template-columns:
            repeat(3, minmax(0, 1fr));
        gap: 13px;
        margin-bottom: 15px;
    }

    .har-panel {
        border: 1px solid var(--ht-role-tone-1f2d24);
        border-radius: 14px;
        background: var(--ht-role-tone-101712);
    }

    .har-panel-head {
        padding: 17px 17px 0;
    }

    .har-panel-head h3 {
        margin: 0 0 4px;
        color: #edf3ef;
        font-size: 13px;
        font-weight: 900;
    }

    .har-panel-head p {
        margin: 0;
        color: #748178;
        font-size: 8px;
    }

    .har-chart {
        height: 275px;
        padding: 13px 15px 17px;
    }

    .har-chart canvas {
        width: 100% !important;
        height: 100% !important;
    }

    .har-groups {
        display: grid;
        grid-template-columns:
            repeat(4, minmax(0, 1fr));
        gap: 12px;
    }

    .har-group {
        padding: 17px;
        border: 1px solid var(--ht-role-tone-1f2d24);
        border-radius: 13px;
        background: var(--ht-role-tone-101712);
    }

    .har-group h3 {
        margin: 0 0 14px;
        color: #eef3ef;
        font-size: 12px;
        font-weight: 900;
    }

    .har-row {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        padding: 9px 0;
        border-bottom: 1px solid var(--ht-role-tone-1d2921);
        color: #829087;
        font-size: 9px;
    }

    .har-row:last-child {
        border-bottom: 0;
    }

    .har-row strong {
        color: #e5ece7;
    }

    @@media (max-width: 1200px) {
        .har-kpis {
            grid-template-columns:
                repeat(3, 1fr);
        }

        .har-charts {
            grid-template-columns: 1fr;
        }

        .har-groups {
            grid-template-columns:
                repeat(2, 1fr);
        }
    }

    @@media (max-width: 760px) {
        .har-hero {
            flex-direction: column;
            align-items: flex-start;
        }

        .har-kpis,
        .har-progress-grid,
        .har-groups {
            grid-template-columns: 1fr;
        }
    }
</style>


<div class="har-page">

    <section class="har-hero">

        <div>
            <h1>Reports & Analytics</h1>

            <p>
                System-wide activity, engagement,
                progress and operational statistics.
            </p>
        </div>

        <span class="har-badge">
            Live database data
        </span>

    </section>


    <!-- HT-VIVA-REPORT-FILTER: optional time period and print/export controls -->
    <form method="get" action="@Url.Action("Index", "Reports", new { area = "Admin" })" class="ht-viva-report-tools">
        <label>
            From date
            <input type="date" name="fromDate" value="@ViewBag.ReportFrom" aria-label="Report from date" />
        </label>
        <label>
            To date
            <input type="date" name="toDate" value="@ViewBag.ReportTo" aria-label="Report to date" />
        </label>
        <button class="ht-viva-report-primary" type="submit">Apply dates</button>
        <button type="submit" formaction="@Url.Action("ExportExcel", "Reports", new { area = "Admin" })">Export to Excel (CSV)</button>
        <button type="button" onclick="window.print()">Print report</button>
        <a href="@Url.Action("Index", "Reports", new { area = "Admin" })">Clear</a>
    </form>
    @if (ViewBag.ReportError != null)
    {
        <p class="ht-viva-report-error">@ViewBag.ReportError</p>
    }
    <div class="ht-viva-report-caption">
        @(ViewBag.ReportFiltered ? "Selected date range" : "All-time activity")
        <span>Dates are inclusive. Appointments use their scheduled dates; plans and goals use start dates.</span>
    </div>

    <section class="har-kpis">

        <div class="har-kpi">
            <span>Registered clients</span>
            <strong>@Model.TotalClients</strong>
            <small>Client profiles</small>
        </div>

        <div class="har-kpi">
            <span>Registered trainers</span>
            <strong>@Model.TotalTrainers</strong>
            <small>Trainer profiles</small>
        </div>

        <div class="har-kpi">
            <span>Active assignments</span>
            <strong>@Model.ActiveAssignments</strong>
            <small>Trainer / Client links</small>
        </div>

        <div class="har-kpi">
            <span>Total appointments</span>
            <strong>@Model.TotalAppointments</strong>
            <small>All workflow states</small>
        </div>

        <div class="har-kpi">
            <span>Health measurements</span>
            <strong>@Model.HealthMeasurements</strong>
            <small>Progress records</small>
        </div>

    </section>


    <section class="har-progress-grid">

        <div class="har-progress-card">

            <div class="har-progress-head">
                <span>Trainer assignment coverage</span>
                <strong>
                    @Model.AssignmentCoveragePercentage%
                </strong>
            </div>

            <div class="har-track">
                <div
                    class="har-fill"
                    style="width:@Model.AssignmentCoveragePercentage%;">
                </div>
            </div>

        </div>


        <div class="har-progress-card">

            <div class="har-progress-head">
                <span>Goal completion</span>
                <strong>
                    @Model.GoalCompletionPercentage%
                </strong>
            </div>

            <div class="har-track">
                <div
                    class="har-fill"
                    style="width:@Model.GoalCompletionPercentage%;">
                </div>
            </div>

        </div>


        <div class="har-progress-card">

            <div class="har-progress-head">
                <span>Appointment completion</span>
                <strong>
                    @Model.AppointmentCompletionPercentage%
                </strong>
            </div>

            <div class="har-track">
                <div
                    class="har-fill"
                    style="width:@Model.AppointmentCompletionPercentage%;">
                </div>
            </div>

        </div>

    </section>


    <section class="har-charts">

        <article class="har-panel">

            <div class="har-panel-head">
                <h3>Appointment Workflow</h3>
                <p>
                    Current status distribution.
                </p>
            </div>

            <div class="har-chart">
                <canvas id="harAppointmentChart"></canvas>
            </div>

        </article>


        <article class="har-panel">

            <div class="har-panel-head">
                <h3>Workout & Nutrition Activity</h3>
                <p>
                    Plans compared with logged activity.
                </p>
            </div>

            <div class="har-chart">
                <canvas id="harActivityChart"></canvas>
            </div>

        </article>


        <article class="har-panel">

            <div class="har-panel-head">
                <h3>Progress & Communication</h3>
                <p>
                    Goals, measurements and notifications.
                </p>
            </div>

            <div class="har-chart">
                <canvas id="harProgressChart"></canvas>
            </div>

        </article>

    </section>


    <section class="har-groups">

        <article class="har-group">
            <h3>User Overview</h3>

            <div class="har-row">
                <span>Clients</span>
                <strong>@Model.TotalClients</strong>
            </div>

            <div class="har-row">
                <span>Trainers</span>
                <strong>@Model.TotalTrainers</strong>
            </div>

            <div class="har-row">
                <span>Unassigned clients</span>
                <strong>@Model.UnassignedClients</strong>
            </div>

            <div class="har-row">
                <span>Suspended users</span>
                <strong>@Model.SuspendedUsers</strong>
            </div>
        </article>


        <article class="har-group">
            <h3>Workout Activity</h3>

            <div class="har-row">
                <span>Total plans</span>
                <strong>@Model.TotalWorkoutPlans</strong>
            </div>

            <div class="har-row">
                <span>Active plans</span>
                <strong>@Model.ActiveWorkoutPlans</strong>
            </div>

            <div class="har-row">
                <span>Workout logs</span>
                <strong>@Model.WorkoutLogs</strong>
            </div>
        </article>


        <article class="har-group">
            <h3>Nutrition Activity</h3>

            <div class="har-row">
                <span>Total diet plans</span>
                <strong>@Model.TotalDietPlans</strong>
            </div>

            <div class="har-row">
                <span>Active plans</span>
                <strong>@Model.ActiveDietPlans</strong>
            </div>

            <div class="har-row">
                <span>Meal logs</span>
                <strong>@Model.MealLogs</strong>
            </div>
        </article>


        <article class="har-group">
            <h3>Progress & Alerts</h3>

            <div class="har-row">
                <span>Total goals</span>
                <strong>@Model.TotalGoals</strong>
            </div>

            <div class="har-row">
                <span>Completed goals</span>
                <strong>@Model.CompletedGoals</strong>
            </div>

            <div class="har-row">
                <span>Notifications</span>
                <strong>@Model.Notifications</strong>
            </div>

            <div class="har-row">
                <span>Unread</span>
                <strong>@Model.UnreadNotifications</strong>
            </div>
        </article>

    </section>

</div>


<script
    src="https://cdn.jsdelivr.net/npm/chart.js@4.4.8/dist/chart.umd.min.js">
</script>

<script>
(function () {

    "use strict";

    if (typeof Chart === "undefined") {
        return;
    }

    Chart.defaults.color = "#829087";
    Chart.defaults.borderColor =
        "rgba(111,130,118,.14)";


    new Chart(
        document.getElementById(
            "harAppointmentChart"
        ),
        {
            type: "doughnut",

            data: {
                labels: [
                    "Pending",
                    "Approved",
                    "Completed",
                    "Cancelled",
                    "Rejected"
                ],

                datasets: [{
                    data: [
                        @Model.PendingAppointments,
                        @Model.ApprovedAppointments,
                        @Model.CompletedAppointments,
                        @Model.CancelledAppointments,
                        @Model.RejectedAppointments
                    ],

                    backgroundColor: [
                        "#F59E0B",
                        "#22C55E",
                        "#4ADE80",
                        "#EF4444",
                        "#7F1D1D"
                    ],

                    borderColor: "#101712",
                    borderWidth: 4
                }]
            },

            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: "67%",

                plugins: {
                    legend: {
                        position: "bottom",

                        labels: {
                            usePointStyle: true,
                            boxWidth: 9,
                            padding: 12
                        }
                    }
                }
            }
        }
    );


    new Chart(
        document.getElementById(
            "harActivityChart"
        ),
        {
            type: "bar",

            data: {
                labels: [
                    "Workout plans",
                    "Workout logs",
                    "Diet plans",
                    "Meal logs"
                ],

                datasets: [{
                    label: "Records",

                    data: [
                        @Model.TotalWorkoutPlans,
                        @Model.WorkoutLogs,
                        @Model.TotalDietPlans,
                        @Model.MealLogs
                    ],

                    backgroundColor:
                        "rgba(34,197,94,.62)",

                    borderColor:
                        "#22C55E",

                    borderWidth: 1,
                    borderRadius: 7
                }]
            },

            options: {
                responsive: true,
                maintainAspectRatio: false,

                plugins: {
                    legend: {
                        display: false
                    }
                },

                scales: {
                    x: {
                        grid: {
                            display: false
                        }
                    },

                    y: {
                        beginAtZero: true,

                        ticks: {
                            precision: 0
                        },

                        grid: {
                            color:
                                "rgba(111,130,118,.10)"
                        }
                    }
                }
            }
        }
    );


    new Chart(
        document.getElementById(
            "harProgressChart"
        ),
        {
            type: "bar",

            data: {
                labels: [
                    "Goals",
                    "Completed",
                    "Measurements",
                    "Notifications",
                    "Unread"
                ],

                datasets: [{
                    label: "Records",

                    data: [
                        @Model.TotalGoals,
                        @Model.CompletedGoals,
                        @Model.HealthMeasurements,
                        @Model.Notifications,
                        @Model.UnreadNotifications
                    ],

                    backgroundColor:
                        "rgba(74,222,128,.58)",

                    borderColor:
                        "#4ADE80",

                    borderWidth: 1,
                    borderRadius: 7
                }]
            },

            options: {
                responsive: true,
                maintainAspectRatio: false,

                plugins: {
                    legend: {
                        display: false
                    }
                },

                scales: {
                    x: {
                        grid: {
                            display: false
                        }
                    },

                    y: {
                        beginAtZero: true,

                        ticks: {
                            precision: 0
                        },

                        grid: {
                            color:
                                "rgba(111,130,118,.10)"
                        }
                    }
                }
            }
        }
    );

})();
</script>
<style>
/* HT-VIVA-REPORT-FILTER: scoped to the existing Administrator Reports page */
.ht-viva-report-tools {display:flex;flex-wrap:wrap;align-items:end;gap:10px;padding:14px 16px;margin:0 0 12px;border:1px solid #284130;border-radius:13px;background:#111b15;}
.ht-viva-report-tools label {display:flex;flex-direction:column;gap:6px;font-size:11px;color:#b4cabc;font-weight:700;}
.ht-viva-report-tools input {min-height:39px;padding:7px 10px;border:1px solid #32523b;border-radius:8px;background:#0b130e;color:#edf7ef;color-scheme:dark;font-size:13px;}
.ht-viva-report-tools button,.ht-viva-report-tools a {min-height:39px;border:1px solid #34533e;border-radius:8px;background:#16251b;color:#d7efe0;padding:9px 12px;font-size:11px;font-weight:800;text-decoration:none;cursor:pointer;display:inline-flex;align-items:center;}
.ht-viva-report-tools .ht-viva-report-primary {background:#22c55e;border-color:#22c55e;color:#06140a;}
.ht-viva-report-tools button:hover,.ht-viva-report-tools a:hover {border-color:#22c55e;}
.ht-viva-report-caption {display:flex;flex-wrap:wrap;gap:10px;color:#4ade80;font-size:11px;font-weight:700;margin:0 0 14px;}
.ht-viva-report-caption span {color:#94aa9a;font-weight:400;}
.ht-viva-report-error {color:#fca5a5;margin:0 0 12px;font-size:12px;}
html[data-theme="light"] .ht-viva-report-tools {background:#f5faf6;border-color:#c7decf;}
html[data-theme="light"] .ht-viva-report-tools label, html[data-theme="light"] .ht-viva-report-caption span {color:#405f4a;}
html[data-theme="light"] .ht-viva-report-tools input {background:#fff;color:#17271c;border-color:#bfd4c5;color-scheme:light;}
html[data-theme="light"] .ht-viva-report-tools button,html[data-theme="light"] .ht-viva-report-tools a {background:#e9f6ed;color:#21643b;}
html[data-theme="light"] .ht-viva-report-tools .ht-viva-report-primary {background:#22c55e;color:#06140a;}
@@media print {
 @@page {size:A4 landscape; margin:12mm;}
 .ht-sidebar,.ht-topbar,.ht-viva-report-tools,.ht-nav,.ht-notification-button {display:none!important;}
 .ht-main {margin-left:0!important;width:100%!important;}
 .ht-page-content {padding:0!important;}
 .har-page {max-width:none!important;color:#111!important;}
 .har-hero,.har-kpi,.har-progress-card,.har-panel {break-inside:avoid;box-shadow:none!important;}
 .har-charts {break-inside:avoid;}
 .har-hero h1,.har-kpi strong,.har-panel h3 {color:#111!important;}
 .har-hero,.har-kpi,.har-progress-card,.har-panel {background:#fff!important;border-color:#b6c5b9!important;}
 .ht-viva-report-caption {color:#111!important;}
}
</style>

<!-- HT-VIVA-POLISH-PRINT: separate, print-only report instead of printing dashboard cards -->
<section class="ht-viva-print-sheet" aria-label="Printable HealthTrack analytics summary">
    <header class="ht-viva-print-heading">
        <div>
            <p class="ht-viva-print-eyebrow">HEALTHTRACK PRO / ADMINISTRATION</p>
            <h1>Reports &amp; Analytics</h1>
            <p>Activity, engagement and operational statistics</p>
        </div>
        <div class="ht-viva-print-meta">
            <div><strong>Period</strong></div>
            <div>@(string.IsNullOrWhiteSpace(ViewBag.ReportFrom as string) ? "All dates" : (string)ViewBag.ReportFrom)
                to @(string.IsNullOrWhiteSpace(ViewBag.ReportTo as string) ? "All dates" : (string)ViewBag.ReportTo)</div>
            <div>Generated @DateTime.Now.ToString("dd MMM yyyy, HH:mm")</div>
        </div>
    </header>
    <div class="ht-viva-print-rule"></div>
    <div class="ht-viva-print-grid">
        <section class="ht-viva-print-panel">
            <h2>Users &amp; assignments</h2>
            <table><tbody>
                <tr><th>Registered clients</th><td>@Model.TotalClients</td></tr>
                <tr><th>Registered trainers</th><td>@Model.TotalTrainers</td></tr>
                <tr><th>Active assignments</th><td>@Model.ActiveAssignments</td></tr>
                <tr><th>Unassigned clients</th><td>@Model.UnassignedClients</td></tr>
                <tr><th>Suspended users*</th><td>@Model.SuspendedUsers</td></tr>
                <tr><th>Assignment coverage</th><td>@Model.AssignmentCoveragePercentage%</td></tr>
            </tbody></table>
        </section>
        <section class="ht-viva-print-panel">
            <h2>Appointment workflow</h2>
            <table><tbody>
                <tr><th>Total appointments</th><td>@Model.TotalAppointments</td></tr>
                <tr><th>Pending</th><td>@Model.PendingAppointments</td></tr>
                <tr><th>Approved</th><td>@Model.ApprovedAppointments</td></tr>
                <tr><th>Rejected</th><td>@Model.RejectedAppointments</td></tr>
                <tr><th>Cancelled</th><td>@Model.CancelledAppointments</td></tr>
                <tr><th>Completed</th><td>@Model.CompletedAppointments</td></tr>
                <tr><th>Completion rate</th><td>@Model.AppointmentCompletionPercentage%</td></tr>
            </tbody></table>
        </section>
        <section class="ht-viva-print-panel">
            <h2>Fitness &amp; nutrition</h2>
            <table><tbody>
                <tr><th>Workout plans</th><td>@Model.TotalWorkoutPlans</td></tr>
                <tr><th>Active workout plans</th><td>@Model.ActiveWorkoutPlans</td></tr>
                <tr><th>Workout logs</th><td>@Model.WorkoutLogs</td></tr>
                <tr><th>Diet plans</th><td>@Model.TotalDietPlans</td></tr>
                <tr><th>Active diet plans</th><td>@Model.ActiveDietPlans</td></tr>
                <tr><th>Meal logs</th><td>@Model.MealLogs</td></tr>
            </tbody></table>
        </section>
        <section class="ht-viva-print-panel">
            <h2>Progress &amp; communication</h2>
            <table><tbody>
                <tr><th>Fitness goals</th><td>@Model.TotalGoals</td></tr>
                <tr><th>Completed goals</th><td>@Model.CompletedGoals</td></tr>
                <tr><th>Goal completion</th><td>@Model.GoalCompletionPercentage%</td></tr>
                <tr><th>Health measurements</th><td>@Model.HealthMeasurements</td></tr>
                <tr><th>Notifications</th><td>@Model.Notifications</td></tr>
                <tr><th>Unread notifications*</th><td>@Model.UnreadNotifications</td></tr>
            </tbody></table>
        </section>
    </div>
    <footer class="ht-viva-print-footer">
        <p>Dates are inclusive. Appointment counts use scheduled dates; workout and diet plans use start dates; other activity uses its recorded date.</p>
        <p>*Suspensions and unread status are current values, not historical snapshots. Other status figures show the present state of records in the selected period.</p>
        <div>HealthTrack Pro • Administrator Reports • Locally generated</div>
    </footer>
</section>
<style>
/* HT-VIVA-POLISH-PRINT: screen remains exactly as before. */
.ht-viva-print-sheet { display: none; }
@@media print {
    @@page { size: A4 landscape; margin: 12mm; }
    html, body { background: #fff !important; color: #17231b !important; height: auto !important; }
    body, .ht-app-shell, .ht-main, .ht-page-content {
        background: #fff !important; min-height: 0 !important;
        height: auto !important; width: 100% !important;
        margin: 0 !important; padding: 0 !important;
        overflow: visible !important;
    }
    .ht-sidebar, .ht-topbar, .har-page { display: none !important; }
    .ht-viva-print-sheet {
        display: block !important; width: 100% !important; max-width: none !important;
        color: #17231b !important; font-family: Arial, 'Segoe UI', sans-serif !important;
