@model HealthTrackPro.Web.Areas.Admin.Models.AdminAppointmentListItemViewModel

@{
    ViewBag.Title = "Appointment Details";
}

<div class="ht-card">

    <div style="
        display:flex;
        justify-content:space-between;
        align-items:flex-start;
        gap:20px;
        margin-bottom:28px;">

        <div>
            <h2 class="ht-card-title">
                Appointment Details
            </h2>

            <p>
                Appointment #@Model.AppointmentId
            </p>
        </div>

        @Html.ActionLink(
            "Back to Appointments",
            "Index",
            "Appointments",
            new { area = "Admin" },
            new { @class = "btn btn-default" })

    </div>

    <div style="
        display:grid;
        grid-template-columns:
            repeat(auto-fit,minmax(220px,1fr));
        gap:18px;
        margin-bottom:28px;">

        <div class="ht-card">
            <small>CLIENT</small>
            <h4>@Model.ClientName</h4>
        </div>

        <div class="ht-card">
            <small>TRAINER</small>
            <h4>@Model.TrainerName</h4>
        </div>

        <div class="ht-card">
            <small>DATE & TIME</small>
            <h4>
                @(Model.AppointmentDateTime.ToString("dd MMM yyyy, hh:mm tt"))
            </h4>
        </div>

        <div class="ht-card">
            <small>DURATION</small>
            <h4>
                @Model.DurationMinutes minutes
            </h4>
        </div>

    </div>

    <div style="margin-bottom:24px;">
        <h4>Status</h4>
        <p>@Model.Status</p>
    </div>

    <div style="margin-bottom:24px;">
        <h4>Reason</h4>

        <p>
            @(string.IsNullOrWhiteSpace(Model.Reason)
                ? "No reason provided."
                : Model.Reason)
        </p>
    </div>

    <div style="margin-bottom:24px;">
        <h4>Notes</h4>

        <p>
            @(string.IsNullOrWhiteSpace(Model.Notes)
                ? "No notes provided."
                : Model.Notes)
        </p>
    </div>

    <hr />

    <div style="
        display:flex;
        gap:30px;
        flex-wrap:wrap;">

        <div>
            <small>CREATED</small>
            <div>
                @(Model.CreatedAt.ToString("dd MMM yyyy, hh:mm tt"))
            </div>
        </div>

        <div>
            <small>LAST UPDATED</small>
            <div>
                @(Model.UpdatedAt.HasValue
                    ? Model.UpdatedAt.Value
                        .ToString(
                            "dd MMM yyyy, hh:mm tt")
                    : "Not updated")
            </div>
        </div>

    </div>

</div>
