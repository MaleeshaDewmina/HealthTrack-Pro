@model HealthTrackPro.Web.Areas.Admin.Models.AdminDashboardViewModel

@{
    ViewBag.Title = "Administrator Dashboard";
}

<div style="
    display:flex;
    justify-content:space-between;
    align-items:flex-start;
    gap:20px;
    margin-bottom:26px;
    flex-wrap:wrap;">

    <div>
        <h1 style="margin:0 0 8px 0;">
            Administrator Dashboard
        </h1>

        <p style="margin:0; opacity:.7;">
            Monitor HealthTrack users, activity and system operations.
        </p>
    </div>

    <div>
        <span class="
            ht-status
            ht-status-success">
            System operational
        </span>
    </div>

</div>


<!-- SUMMARY CARDS -->

<div style="
    display:grid;
    grid-template-columns:
        repeat(auto-fit,minmax(180px,1fr));
    gap:16px;
    margin-bottom:28px;">

    <div class="ht-card">
        <small>CLIENTS</small>

        <h2 style="margin-bottom:4px;">
            @Model.TotalClients
        </h2>

        <div style="opacity:.7;">
            Registered Clients
        </div>
    </div>

    <div class="ht-card">
        <small>TRAINERS</small>

        <h2 style="margin-bottom:4px;">
            @Model.TotalTrainers
        </h2>

        <div style="opacity:.7;">
            Registered Trainers
        </div>
    </div>

    <div class="ht-card">
        <small>ASSIGNMENTS</small>

        <h2 style="margin-bottom:4px;">
            @Model.ActiveAssignments
        </h2>

        <div style="opacity:.7;">
            Active relationships
        </div>
    </div>

    <div class="ht-card">
        <small>PENDING APPOINTMENTS</small>

        <h2 style="margin-bottom:4px;">
            @Model.PendingAppointments
        </h2>

        <div style="opacity:.7;">
            Awaiting Trainer action
        </div>
    </div>

    <div class="ht-card">
        <small>SUSPENDED USERS</small>

        <h2 style="margin-bottom:4px;">
            @Model.SuspendedUsers
        </h2>

        <div style="opacity:.7;">
            Locked accounts
        </div>
    </div>

    <div class="ht-card">
        <small>COMPLETED GOALS</small>

        <h2 style="margin-bottom:4px;">
            @Model.CompletedGoals
        </h2>

        <div style="opacity:.7;">
            Client achievements
        </div>
    </div>

</div>


<!-- ACTIVITY SNAPSHOT -->

<div style="
    display:grid;
    grid-template-columns:
        repeat(auto-fit,minmax(230px,1fr));
    gap:16px;
    margin-bottom:28px;">

    <div class="ht-card">
        <small>ACTIVE WORKOUT PLANS</small>

        <h2>
            @Model.ActiveWorkoutPlans
        </h2>
    </div>

    <div class="ht-card">
        <small>ACTIVE DIET PLANS</small>

        <h2>
            @Model.ActiveDietPlans
        </h2>
    </div>

    <div class="ht-card">
        <small>UNREAD NOTIFICATIONS</small>

        <h2>
            @Model.UnreadNotifications
        </h2>
    </div>

</div>


<!-- MAIN DASHBOARD CONTENT -->

<div style="
    display:grid;
    grid-template-columns:
        repeat(auto-fit,minmax(430px,1fr));
    gap:20px;
    margin-bottom:28px;">

    <!-- RECENT ADMIN ACTIVITY -->

    <div class="ht-card">

        <div style="
            display:flex;
            justify-content:space-between;
            align-items:center;
            gap:14px;
            margin-bottom:20px;">

            <div>
                <h3 style="margin:0;">
                    Recent Administrative Activity
                </h3>
            </div>

            @Html.ActionLink(
                "View all",
                "Index",
                "AuditLogs",
                new { area = "Admin" },
                new { @class = "btn btn-default btn-sm" })

        </div>

        @if (!Model.RecentActivities.Any())
        {
            <p style="opacity:.7;">
                No administrative activity recorded yet.
            </p>
        }
        else
        {
            <div class="table-responsive">

                <table class="table">

                    <thead>
                        <tr>
                            <th>Action</th>
                            <th>User</th>
                            <th>Date</th>
                        </tr>
                    </thead>

                    <tbody>

                    @foreach (
                        var activity
                        in Model.RecentActivities)
                    {
                        <tr>

                            <td>
                                <strong>
                                    @activity.Action
                                </strong>

                                @if (
                                    !string.IsNullOrWhiteSpace(
                                        activity.Description))
                                {
                                    <div style="
                                        opacity:.65;
                                        font-size:12px;
                                        margin-top:4px;">
                                        @activity.Description
                                    </div>
                                }
                            </td>

                            <td>
                                @activity.UserEmail
                            </td>

                            <td style="white-space:nowrap;">
                                @(activity.CreatedAt
                                    .ToLocalTime()
                                    .ToString(
                                        "dd MMM, hh:mm tt"))
                            </td>

                        </tr>
                    }

                    </tbody>

                </table>

            </div>
        }

    </div>


    <!-- RECENT APPOINTMENTS -->

    <div class="ht-card">

        <div style="
            display:flex;
            justify-content:space-between;
            align-items:center;
            gap:14px;
            margin-bottom:20px;">

            <div>
                <h3 style="margin:0;">
                    Recent Appointments
                </h3>
            </div>

            @Html.ActionLink(
                "View all",
                "Index",
                "Appointments",
                new { area = "Admin" },
                new { @class = "btn btn-default btn-sm" })

        </div>

        @if (!Model.RecentAppointments.Any())
        {
            <p style="opacity:.7;">
                No appointments have been created yet.
            </p>
        }
        else
        {
            <div class="table-responsive">

                <table class="table">

                    <thead>
                        <tr>
                            <th>Client</th>
                            <th>Trainer</th>
                            <th>Date</th>
                            <th>Status</th>
                        </tr>
                    </thead>

                    <tbody>

                    @foreach (
                        var appointment
                        in Model.RecentAppointments)
                    {
                        <tr>

                            <td>
                                @appointment.ClientName
                            </td>

                            <td>
                                @appointment.TrainerName
                            </td>

                            <td style="white-space:nowrap;">
                                @appointment
                                    .AppointmentDateTime
                                    .ToString(
                                        "dd MMM, hh:mm tt")
                            </td>

                            <td>
                                <span class="
                                    ht-status
                                    @(appointment.Status ==
                                        HealthTrackPro.Web.Enums
                                            .AppointmentStatus.Completed ||
                                      appointment.Status ==
                                        HealthTrackPro.Web.Enums
                                            .AppointmentStatus.Approved
                                        ? "ht-status-success"
                                        : appointment.Status ==
                                            HealthTrackPro.Web.Enums
                                                .AppointmentStatus.Rejected ||
                                          appointment.Status ==
                                            HealthTrackPro.Web.Enums
                                                .AppointmentStatus.Cancelled
                                            ? "ht-status-danger"
                                            : "ht-status-warning")">

                                    @appointment.Status

                                </span>
                            </td>

                        </tr>
                    }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>


<!-- QUICK ACTIONS -->

<div class="ht-card">

    <h3 style="margin-top:0;">
        Quick Administration
    </h3>

    <p style="opacity:.7; margin-bottom:20px;">
        Access frequently used management tools.
    </p>

    <div style="
        display:flex;
        flex-wrap:wrap;
        gap:12px;">

        @Html.ActionLink(
            "Manage Users",
            "Index",
            "Users",
            new { area = "Admin" },
            new { @class = "btn btn-primary" })

        @Html.ActionLink(
            "Manage Trainers",
            "Index",
            "Trainers",
            new { area = "Admin" },
            new { @class = "btn btn-default" })

        @Html.ActionLink(
            "Trainer Assignments",
            "Index",
            "Assignments",
            new { area = "Admin" },
            new { @class = "btn btn-default" })

        @Html.ActionLink(
            "Appointments",
            "Index",
            "Appointments",
            new { area = "Admin" },
            new { @class = "btn btn-default" })

        @Html.ActionLink(
            "Reports & Analytics",
            "Index",
            "Reports",
            new { area = "Admin" },
            new { @class = "btn btn-default" })

        @Html.ActionLink(
            "Audit Logs",
            "Index",
            "AuditLogs",
            new { area = "Admin" },
            new { @class = "btn btn-default" })

    </div>

</div>
