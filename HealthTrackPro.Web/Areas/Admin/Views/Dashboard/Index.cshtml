@model HealthTrackPro.Web.Areas.Admin.Models.AdminDashboardViewModel

@{
    ViewBag.Title = "Administrator Dashboard";

    var totalUsers =
        Model.TotalClients +
        Model.TotalTrainers;

    var totalAppointments =
        Model.PendingAppointments +
        Model.ApprovedAppointments +
        Model.CompletedAppointments +
        Model.CancelledAppointments +
        Model.RejectedAppointments;
}

<style>
    .had-page {
        max-width: 1500px;
        margin: 0 auto;
    }

    .had-hero {
        position: relative;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        margin-bottom: 22px;
        padding: 26px;
        border: 1px solid #203027;
        border-radius: 18px;
        background:
            radial-gradient(
                circle at 90% 10%,
                rgba(34,197,94,.15),
                transparent 34%
            ),
            linear-gradient(
                135deg,
                #111914,
                #0c120e
            );
    }

    .had-hero h1 {
        margin: 0 0 8px;
        color: #f4f7f5;
        font-size: 32px;
        font-weight: 900;
    }

    .had-hero p {
        max-width: 650px;
        margin: 0;
        color: #8c9a91;
        font-size: 13px;
        line-height: 1.6;
    }

    .had-live {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        flex-shrink: 0;
        padding: 9px 13px;
        border: 1px solid rgba(34,197,94,.24);
        border-radius: 999px;
        background: rgba(34,197,94,.09);
        color: #4ade80;
        font-size: 9px;
        font-weight: 900;
        letter-spacing: .4px;
        text-transform: uppercase;
    }

    .had-live-dot {
        width: 7px;
        height: 7px;
        border-radius: 999px;
        background: #22c55e;
        box-shadow: 0 0 12px rgba(34,197,94,.65);
    }

    .had-kpis {
        display: grid;
        grid-template-columns:
            repeat(6, minmax(0, 1fr));
        gap: 12px;
        margin-bottom: 18px;
    }

    .had-kpi {
        position: relative;
        overflow: hidden;
        min-height: 125px;
        padding: 18px;
        border: 1px solid #1f2d24;
        border-radius: 14px;
        background:
            radial-gradient(
                circle at 100% 0,
                rgba(34,197,94,.08),
                transparent 48%
            ),
            #101712;
    }

    .had-kpi-label {
        display: block;
        margin-bottom: 10px;
        color: #718078;
        font-size: 8px;
        font-weight: 900;
        letter-spacing: .8px;
        text-transform: uppercase;
    }

    .had-kpi-value {
        display: block;
        margin-bottom: 4px;
        color: #f3f7f4;
        font-size: 28px;
        font-weight: 900;
    }

    .had-kpi-note {
        color: #829087;
        font-size: 9px;
    }

    .had-charts {
        display: grid;
        grid-template-columns:
            1fr 1fr 1.35fr;
        gap: 14px;
        margin-bottom: 18px;
    }

    .had-panel {
        border: 1px solid #1f2d24;
        border-radius: 15px;
        background: #101712;
    }

    .had-panel-head {
        display: flex;
        justify-content: space-between;
        gap: 15px;
        align-items: flex-start;
        padding: 18px 18px 0;
    }

    .had-panel-head h3 {
        margin: 0 0 4px;
        color: #edf3ef;
        font-size: 14px;
        font-weight: 900;
    }

    .had-panel-head p {
        margin: 0;
        color: #748178;
        font-size: 9px;
    }

    .had-panel-tag {
        padding: 5px 8px;
        border-radius: 999px;
        background: rgba(34,197,94,.09);
        color: #4ade80;
        font-size: 7px;
        font-weight: 900;
        text-transform: uppercase;
    }

    .had-chart {
        position: relative;
        height: 260px;
        padding: 14px 16px 18px;
    }

    .had-chart canvas {
        width: 100% !important;
        height: 100% !important;
    }

    .had-lower {
        display: grid;
        grid-template-columns:
            repeat(2, minmax(0, 1fr));
        gap: 14px;
        margin-bottom: 18px;
    }

    .had-table-wrap {
        overflow-x: auto;
        padding: 12px 18px 18px;
    }

    .had-table {
        width: 100%;
        border-collapse: collapse;
    }

    .had-table th {
        padding: 11px 10px;
        border-bottom: 1px solid #243329;
        color: #708077;
        font-size: 8px;
        font-weight: 900;
        text-align: left;
        letter-spacing: .6px;
        text-transform: uppercase;
    }

    .had-table td {
        padding: 13px 10px;
        border-bottom: 1px solid #1d2921;
        color: #d4ddd7;
        font-size: 9px;
        vertical-align: top;
    }

    .had-table tr:last-child td {
        border-bottom: 0;
    }

    .had-table strong {
        color: #edf3ef;
        font-size: 10px;
    }

    .had-muted {
        margin-top: 4px;
        color: #6f7c73;
        font-size: 8px;
        line-height: 1.5;
    }

    .had-status {
        display: inline-flex;
        padding: 5px 8px;
        border-radius: 999px;
        font-size: 7px;
        font-weight: 900;
        text-transform: uppercase;
    }

    .had-success {
        background: rgba(34,197,94,.12);
        color: #4ade80;
    }

    .had-warning {
        background: rgba(245,158,11,.12);
        color: #fbbf24;
    }

    .had-danger {
        background: rgba(239,68,68,.12);
        color: #f87171;
    }

    .had-actions {
        display: grid;
        grid-template-columns:
            repeat(6, minmax(0, 1fr));
        gap: 10px;
        padding: 18px;
    }

    .had-action {
        display: flex;
        min-height: 70px;
        flex-direction: column;
        justify-content: center;
        padding: 13px;
        border: 1px solid #26352b;
        border-radius: 11px;
        background: #0d140f;
        color: #d6dfd9 !important;
        text-decoration: none !important;
        transition: .15s ease;
    }

    .had-action:hover {
        transform: translateY(-2px);
        border-color: #2f6d45;
        background: rgba(34,197,94,.07);
    }

    .had-action strong {
        margin-bottom: 4px;
        color: #f0f5f1;
        font-size: 9px;
    }

    .had-action span {
        color: #748178;
        font-size: 8px;
    }

    @@media (max-width: 1250px) {
        .had-kpis {
            grid-template-columns:
                repeat(3, 1fr);
        }

        .had-charts {
            grid-template-columns:
                repeat(2, 1fr);
        }

        .had-charts .had-panel:last-child {
            grid-column: 1 / -1;
        }

        .had-actions {
            grid-template-columns:
                repeat(3, 1fr);
        }
    }

    @@media (max-width: 800px) {
        .had-hero {
            flex-direction: column;
            align-items: flex-start;
        }

        .had-kpis,
        .had-charts,
        .had-lower,
        .had-actions {
            grid-template-columns: 1fr;
        }

        .had-charts .had-panel:last-child {
            grid-column: auto;
        }
    }
</style>


<div class="had-page">

    <section class="had-hero">

        <div>
            <h1>Administrator Dashboard</h1>

            <p>
                Monitor platform activity, user engagement,
                trainer relationships and operational health
                from one control centre.
            </p>
        </div>

        <div class="had-live">
            <span class="had-live-dot"></span>
            Live database overview
        </div>

    </section>


    <section class="had-kpis">

        <div class="had-kpi">
            <span class="had-kpi-label">Registered clients</span>
            <span class="had-kpi-value">@Model.TotalClients</span>
            <span class="had-kpi-note">Active client profiles</span>
        </div>

        <div class="had-kpi">
            <span class="had-kpi-label">Registered trainers</span>
            <span class="had-kpi-value">@Model.TotalTrainers</span>
            <span class="had-kpi-note">Trainer profiles</span>
        </div>

        <div class="had-kpi">
            <span class="had-kpi-label">Active assignments</span>
            <span class="had-kpi-value">@Model.ActiveAssignments</span>
            <span class="had-kpi-note">Trainer / client links</span>
        </div>

        <div class="had-kpi">
            <span class="had-kpi-label">Appointments</span>
            <span class="had-kpi-value">@totalAppointments</span>
            <span class="had-kpi-note">
                @Model.PendingAppointments awaiting action
            </span>
        </div>

        <div class="had-kpi">
            <span class="had-kpi-label">Completed goals</span>
            <span class="had-kpi-value">@Model.CompletedGoals</span>
            <span class="had-kpi-note">Client achievements</span>
        </div>

        <div class="had-kpi">
            <span class="had-kpi-label">Suspended users</span>
            <span class="had-kpi-value">@Model.SuspendedUsers</span>
            <span class="had-kpi-note">Restricted accounts</span>
        </div>

    </section>


    <section class="had-charts">

        <article class="had-panel">

            <div class="had-panel-head">
                <div>
                    <h3>User Distribution</h3>
                    <p>Clients compared with Trainers.</p>
                </div>

                <span class="had-panel-tag">
                    @totalUsers users
                </span>
            </div>

            <div class="had-chart">
                <canvas id="hadUserChart"></canvas>
            </div>

        </article>


        <article class="had-panel">

            <div class="had-panel-head">
                <div>
                    <h3>Appointment Status</h3>
                    <p>Current workflow distribution.</p>
                </div>

                <span class="had-panel-tag">
                    @totalAppointments total
                </span>
            </div>

            <div class="had-chart">
                <canvas id="hadAppointmentChart"></canvas>
            </div>

        </article>


        <article class="had-panel">

            <div class="had-panel-head">
                <div>
                    <h3>Platform Activity</h3>
                    <p>
                        Live operational records across
                        HealthTrack.
                    </p>
                </div>

                <span class="had-panel-tag">
                    activity
                </span>
            </div>

            <div class="had-chart">
                <canvas id="hadActivityChart"></canvas>
            </div>

        </article>

    </section>


    <section class="had-lower">

        <article class="had-panel">

            <div class="had-panel-head">
                <div>
                    <h3>Recent Administrative Activity</h3>
                    <p>Latest recorded system actions.</p>
                </div>

                <a
                    class="had-panel-tag"
                    href="@Url.Action(
                        "Index",
                        "AuditLogs",
                        new { area = "Admin" })">
                    View all
                </a>
            </div>


            <div class="had-table-wrap">

                @if (!Model.RecentActivities.Any())
                {
                    <div class="had-muted">
                        No administrative activity recorded yet.
                    </div>
                }
                else
                {
                    <table class="had-table">

                        <thead>
                            <tr>
                                <th>Action</th>
                                <th>User</th>
                                <th>Date</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (
                                var activity
                                in Model.RecentActivities)
                            {
                                <tr>

                                    <td>
                                        <strong>
                                            @activity.Action
                                        </strong>

                                        @if (
                                            !string.IsNullOrWhiteSpace(
                                                activity.Description))
                                        {
                                            <div class="had-muted">
                                                @activity.Description
                                            </div>
                                        }
                                    </td>

                                    <td>
                                        @activity.UserEmail
                                    </td>

                                    <td style="white-space:nowrap;">
                                        @(activity.CreatedAt
                                            .ToLocalTime()
                                            .ToString(
                                                "dd MMM, hh:mm tt"))
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>
                }

            </div>

        </article>


        <article class="had-panel">

            <div class="had-panel-head">
                <div>
                    <h3>Recent Appointments</h3>
                    <p>Latest Client / Trainer activity.</p>
                </div>

                <a
                    class="had-panel-tag"
                    href="@Url.Action(
                        "Index",
                        "Appointments",
                        new { area = "Admin" })">
                    View all
                </a>
            </div>


            <div class="had-table-wrap">

                @if (!Model.RecentAppointments.Any())
                {
                    <div class="had-muted">
                        No appointments created yet.
                    </div>
                }
                else
                {
                    <table class="had-table">

                        <thead>
                            <tr>
                                <th>Client</th>
                                <th>Trainer</th>
                                <th>Date</th>
                                <th>Status</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (
                                var appointment
                                in Model.RecentAppointments)
                            {
                                var statusClass =
                                    appointment.Status ==
                                        HealthTrackPro.Web.Enums
                                            .AppointmentStatus.Completed ||
                                    appointment.Status ==
                                        HealthTrackPro.Web.Enums
                                            .AppointmentStatus.Approved
                                        ? "had-success"
                                        : appointment.Status ==
                                            HealthTrackPro.Web.Enums
                                                .AppointmentStatus.Cancelled ||
                                          appointment.Status ==
                                            HealthTrackPro.Web.Enums
                                                .AppointmentStatus.Rejected
                                            ? "had-danger"
                                            : "had-warning";

                                <tr>

                                    <td>
                                        <strong>
                                            @appointment.ClientName
                                        </strong>
                                    </td>

                                    <td>
                                        @appointment.TrainerName
                                    </td>

                                    <td style="white-space:nowrap;">
                                        @(appointment
                                            .AppointmentDateTime
                                            .ToString(
                                                "dd MMM, hh:mm tt"))
                                    </td>

                                    <td>
                                        <span class="
                                            had-status
                                            @statusClass">
                                            @appointment.Status
                                        </span>
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>
                }

            </div>

        </article>

    </section>


    <section class="had-panel">

        <div class="had-panel-head">
            <div>
                <h3>Quick Administration</h3>
                <p>
                    Jump directly to frequently used
                    administrative tools.
                </p>
            </div>
        </div>

        <div class="had-actions">

            <a
                class="had-action"
                href="@Url.Action(
                    "Index",
                    "Users",
                    new { area = "Admin" })">
                <strong>Users</strong>
                <span>Accounts and access</span>
            </a>

            <a
                class="had-action"
                href="@Url.Action(
                    "Index",
                    "Trainers",
                    new { area = "Admin" })">
                <strong>Trainers</strong>
                <span>Trainer management</span>
            </a>

            <a
                class="had-action"
                href="@Url.Action(
                    "Index",
                    "Assignments",
                    new { area = "Admin" })">
                <strong>Assignments</strong>
                <span>Client relationships</span>
            </a>

            <a
                class="had-action"
                href="@Url.Action(
                    "Index",
                    "Appointments",
                    new { area = "Admin" })">
                <strong>Appointments</strong>
                <span>System oversight</span>
            </a>

            <a
                class="had-action"
                href="@Url.Action(
                    "Index",
                    "Reports",
                    new { area = "Admin" })">
                <strong>Reports</strong>
                <span>Platform analytics</span>
            </a>

            <a
                class="had-action"
                href="@Url.Action(
                    "Index",
                    "AuditLogs",
                    new { area = "Admin" })">
                <strong>Audit Logs</strong>
                <span>Security records</span>
            </a>

        </div>

    </section>

</div>


<script
    src="https://cdn.jsdelivr.net/npm/chart.js@4.4.8/dist/chart.umd.min.js">
</script>

<script>
(function () {

    "use strict";

    if (typeof Chart === "undefined") {
        return;
    }

    Chart.defaults.color = "#829087";
    Chart.defaults.borderColor =
        "rgba(111,130,118,.14)";


    var userCanvas =
        document.getElementById(
            "hadUserChart"
        );

    if (userCanvas) {

        new Chart(
            userCanvas,
            {
                type: "doughnut",

                data: {
                    labels: [
                        "Clients",
                        "Trainers"
                    ],

                    datasets: [{
                        data: [
                            @Model.TotalClients,
                            @Model.TotalTrainers
                        ],

                        backgroundColor: [
                            "#22C55E",
                            "#166534"
                        ],

                        borderColor: "#101712",
                        borderWidth: 4
                    }]
                },

                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: "68%",

                    plugins: {
                        legend: {
                            position: "bottom",

                            labels: {
                                boxWidth: 10,
                                boxHeight: 10,
                                padding: 16,
                                usePointStyle: true
                            }
                        }
                    }
                }
            }
        );
    }


    var appointmentCanvas =
        document.getElementById(
            "hadAppointmentChart"
        );

    if (appointmentCanvas) {

        new Chart(
            appointmentCanvas,
            {
                type: "doughnut",

                data: {
                    labels: [
                        "Pending",
                        "Approved",
                        "Completed",
                        "Cancelled",
                        "Rejected"
                    ],

                    datasets: [{
                        data: [
                            @Model.PendingAppointments,
                            @Model.ApprovedAppointments,
                            @Model.CompletedAppointments,
                            @Model.CancelledAppointments,
                            @Model.RejectedAppointments
                        ],

                        backgroundColor: [
                            "#F59E0B",
                            "#22C55E",
                            "#4ADE80",
                            "#EF4444",
                            "#7F1D1D"
                        ],

                        borderColor: "#101712",
                        borderWidth: 4
                    }]
                },

                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: "68%",

                    plugins: {
                        legend: {
                            position: "bottom",

                            labels: {
                                boxWidth: 10,
                                boxHeight: 10,
                                padding: 12,
                                usePointStyle: true
                            }
                        }
                    }
                }
            }
        );
    }


    var activityCanvas =
        document.getElementById(
            "hadActivityChart"
        );

    if (activityCanvas) {

        new Chart(
            activityCanvas,
            {
                type: "bar",

                data: {
                    labels: [
                        "Assignments",
                        "Workout plans",
                        "Diet plans",
                        "Completed goals",
                        "Unread alerts"
                    ],

                    datasets: [{
                        label: "Records",

                        data: [
                            @Model.ActiveAssignments,
                            @Model.ActiveWorkoutPlans,
                            @Model.ActiveDietPlans,
                            @Model.CompletedGoals,
                            @Model.UnreadNotifications
                        ],

                        backgroundColor:
                            "rgba(34,197,94,.62)",

                        borderColor:
                            "#22C55E",

                        borderWidth: 1,
                        borderRadius: 7,
                        maxBarThickness: 45
                    }]
                },

                options: {
                    responsive: true,
                    maintainAspectRatio: false,

                    plugins: {
                        legend: {
                            display: false
                        }
                    },

                    scales: {
                        x: {
                            grid: {
                                display: false
                            },

                            ticks: {
                                color: "#829087",
                                font: {
                                    size: 9
                                }
                            }
                        },

                        y: {
                            beginAtZero: true,

                            ticks: {
                                precision: 0,
                                color: "#829087"
                            },

                            grid: {
                                color:
                                    "rgba(111,130,118,.10)"
                            }
                        }
                    }
                }
            }
        );
    }

})();
</script>